      if (!hasItems && !hasLogs) {
        const menu = document.querySelector('#tab-items .inventoryMenu');
        if (menu) menu.insertAdjacentHTML('afterbegin',
          '<p class="inv-empty">Nothing yet. The only thing you woke up with is around your neck.</p>'
        );
      }
      if (!hasFood) {
        const menu = document.querySelector('#tab-food .inventoryFood');
        if (menu) menu.insertAdjacentHTML('afterbegin',
          '<p class="inv-empty">No food. Hunt something or buy from the Agora food shop.</p>'
        );
      }
      if (!hasLogs) {
        const menu = document.querySelector('#tab-logs .inventoryMenu');
        if (menu) menu.insertAdjacentHTML('afterbegin',
          '<p class="inv-empty">No entry logs found yet. Keep exploring.</p>'
        );
      }
      if (!hasPerks) {
        const menu = document.querySelector('#tab-perks .inventoryMenu');
        if (menu) menu.insertAdjacentHTML('afterbegin',
          `<p class="inv-empty">You currently don't have any active perks.</p>`
        );
      }
    });
  }


  async function openCamp(inOverlay) {
    if (!inOverlay) showLeave();
    const targetEl = inOverlay || $('pnd-main-space');

    try {
      const res  = await fetch(`${BASE_URL}Camp.html`);
      const html = await res.text();
      const parser = new DOMParser();
      const doc  = parser.parseFromString(html, 'text/html');
      targetEl.innerHTML = '';
      Array.from(doc.body.children).forEach(child =>
        targetEl.appendChild(document.importNode(child, true))
      );

      // Set camp background image based on current camp level
      const campBg = targetEl.querySelector('#camp-bg');
      if (campBg) {
        campBg.src = `${BASE_URL}Images/camp${save.campLevel || 1}.jpg`;
      }

      // Ensure the scene container is position:relative so overlays work
      const scene = targetEl.querySelector('#camp-scene');
      if (scene) {
        scene.style.setProperty('position', 'relative', 'important');
        scene.style.setProperty('display', 'block', 'important');
        scene.style.setProperty('line-height', '0', 'important');
      }

      // Hide ALL companions first
      ['Alana','Dicer','Morse'].forEach(id => {
        const el = targetEl.querySelector('#' + id);
        if (el) {
          el.style.setProperty('display', 'none', 'important');
          el.classList.add('pnd-hidden');
        }
      });

      // Reveal only companions in save.people — enforce absolute positioning via JS
      save.people.forEach(personId => {
        const el = targetEl.querySelector('#' + personId);
        if (!el) return;
        el.classList.remove('pnd-hidden', 'hidden');
        el.style.setProperty('display', 'block', 'important');
        el.style.setProperty('position', 'absolute', 'important');
        el.addEventListener('click', () => modal({
          title:       el.dataset.description || personId,
          text:        '',
          image:       `${BASE_URL}Images/People/${personId}.png`,
          confirmText: 'Close',
        }));
      });


    } catch(e) {
      targetEl.innerHTML = '<div class="pnd-loading pnd-error">Could not load camp.</div>';
    }
  }

  /* ─────────────────────────────────────────
     LOCATION PAGES
     All locations load as full pages inside
     #pnd-main-space. "Back to Map" via leave-btn.
  ───────────────────────────────────────── */

  /* Tab switching for location pages (Agoras, Pits etc).
     Tabs use class="tab-active" to show. No jQuery needed. */
  function initLocationTabs(container) {
    const tabLinks = container.querySelectorAll('.tabs a');
    if (!tabLinks.length) return;

    // All tab content divs within this container — hide all on init
    const allTabDivs = container.querySelectorAll('.tabgroup > div');
    allTabDivs.forEach(d => { d.style.display = 'none'; });

    function activateTab(href) {
      // Hide all tabs first
      allTabDivs.forEach(d => {
        d.classList.remove('tab-active');
        d.style.display = 'none';
      });
      tabLinks.forEach(l => l.classList.remove('active'));
      // Show selected tab
      const id = href.replace(/^#/, '');
      const target = container.querySelector('#' + id);
      const link   = container.querySelector('.tabs a[href="' + href + '"]');
      if (target) {
        target.classList.add('tab-active');
        target.style.display = 'block';
        refreshUI(target);
      }
      if (link) link.classList.add('active');
    }

    tabLinks.forEach(a => {
      a.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();
        activateTab(a.getAttribute('href'));
      });
    });

    // Show first tab on load
    const firstLink = container.querySelector('.tabs a.active') || tabLinks[0];
    if (firstLink) activateTab(firstLink.getAttribute('href'));
  }

  async function openLocation(file, locationName) {
    if (save.chapter >= 5) show($('pnd-map-btn'));
    showLeave();

    const space = $('pnd-main-space');
    space.style.background = '#eeeeee';
    space.innerHTML = '<div class="pnd-loading">Loading\u2026</div>';

    try {
      const res  = await fetch(file);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const html = await res.text();
      const parser = new DOMParser();
      const doc  = parser.parseFromString(html, 'text/html');

      document.querySelectorAll('style[data-pnd-loc-injected]').forEach(s => s.remove());
      doc.querySelectorAll('style').forEach(s => {
        const clone = document.createElement('style');
        clone.setAttribute('data-pnd-loc-injected', '1');
        clone.textContent = s.textContent;
        document.head.appendChild(clone);
      });

      space.innerHTML = '';

      // Location header
      const header = document.createElement('div');
      header.className = 'pnd-loc-page-header';
      header.innerHTML = `<span class="pnd-loc-page-title">${locationName || ''}</span>`;
      space.appendChild(header);

      // Content wrapper
      const wrap = document.createElement('div');
      wrap.className = 'pnd-loc-page-body';
      Array.from(doc.body.children).forEach(child =>
        wrap.appendChild(document.importNode(child, true))
      );
      space.appendChild(wrap);

      wrap.querySelectorAll('script').forEach(oldScript => {
        const s = document.createElement('script');
        if (oldScript.src) s.src = oldScript.src;
        else s.textContent = oldScript.textContent;
        oldScript.parentNode.replaceChild(s, oldScript);
      });

      const hasAgora = !!wrap.querySelector('#agoraShop,#agoraJobs,#agoraFoodShop,#agoraAuctionHouse');
      if (hasAgora || wrap.querySelector('#forestHunt')) {
        bindDivButtonsIn(wrap);
      } else {
        bindAreaButtonsIn(wrap);
      }
      refreshUI(wrap);
      initLocationTabs(wrap);

// Sea: three-per-row float layout (two on mobile), images at their natural sizes
      if (file.includes('Sea')) {
        bindDivButtonsIn(wrap);
        wrap.querySelectorAll('#seaFish img').forEach(img => {
          img.style.setProperty('max-width', '100%', 'important');
          img.style.setProperty('height', 'auto', 'important');
          img.style.setProperty('margin', '0', 'important');
          // width is NOT set here — the inline style="width:Xpx" on each img must win
        });
        const isMobile = window.matchMedia('(max-width: 600px)').matches;
        const colWidth = isMobile ? '50%' : '33.333%';
        wrap.querySelectorAll('#seaFish > div').forEach(div => {
          div.style.setProperty('float', 'left', 'important');
          div.style.setProperty('display', 'block', 'important');
          div.style.setProperty('width', colWidth, 'important');
          div.style.setProperty('box-sizing', 'border-box', 'important');
          div.style.setProperty('padding', '8px', 'important');
        });
      }

      // Swap TheLabs background image after Chapter 21 (save.chapter >= 21 = displayed ch.22+)
      if (file.includes('TheLabs')) {
        const locBg = wrap.querySelector('.loc-bg');
        if (locBg && save.chapter >= 21) {
          locBg.style.backgroundImage =
            'url(toolbox/index/pandora2/LocationsDesc/TheLabs2.jpg)';
        }
      }

      // Swap ResistanceCamp background image based on chapter progress
      // ch.27+ → ResistanceCamp2.jpg, ch.59+ → ResistanceCamp3.jpg
      if (file.includes('ResistanceCamp')) {
        const locBg = wrap.querySelector('.loc-bg');
        if (locBg && save.chapter >= 26) {
          const img = save.chapter >= 58 ? 'ResistanceCamp3' : 'ResistanceCamp2';
          locBg.style.backgroundImage =
            'url(toolbox/index/pandora2/LocationsDesc/' + img + '.jpg)';
        }
      }

    } catch(e) {
      space.innerHTML = '<div class="pnd-loading pnd-error">Could not load location.</div>';
    }
  }

  async function openCampPage() {
    if (save.chapter >= 5) show($('pnd-map-btn'));
    showLeave();
    const space = $('pnd-main-space');
    space.style.background = '#eeeeee';
    space.innerHTML = '';

    const header = document.createElement('div');
    header.className = 'pnd-loc-page-header';
    header.innerHTML = '<span class="pnd-loc-page-title">Camp</span>';
    space.appendChild(header);

    const wrap = document.createElement('div');
    wrap.className = 'pnd-loc-page-body';
    wrap.style.padding = '0';  // no side gutters — camp image fills full width
    space.appendChild(wrap);
    await openCamp(wrap);
  }

  // Aliases so existing callers keep working
  function openLocationOverlay(file, locationName) { openLocation(file, locationName); }
  function openCampOverlay() { openCampPage(); }
  function closeLocationOverlay() {
    document.querySelectorAll('style[data-pnd-loc-injected]').forEach(s => s.remove());
  }

  /* ─────────────────────────────────────────
     MAP PANEL
  ───────────────────────────────────────── */

  async function openMap() {
    showLeave();
    if (save.chapter >= 5) show($('pnd-map-btn'));
    await loadContent(`${BASE_URL}Map.html`);

    function onNavigate(e) {
      const { file, locationId, locationName } = e.detail;
      try {
        const fresh = JSON.parse(localStorage.getItem(LS_KEY) || 'null');
        if (fresh) {
          save.lastLocation     = fresh.lastLocation;
          save.visitedLocations = fresh.visitedLocations || save.visitedLocations;
        }
      } catch(err) {}
      updateTopBar();
      if (locationId === 'Camp') { openCampPage(); return; }
      openLocation(file, locationName || locationId);
    }

    window.removeEventListener('pandora:navigate', window._pandoraNavHandler);
    window._pandoraNavHandler = onNavigate;
    window.addEventListener('pandora:navigate', onNavigate);
  }

  /* ─────────────────────────────────────────
     NEXT CHAPTER
  ───────────────────────────────────────── */

  async function handleNextChapter() {
    const nextChapter = save.chapter + 1;

    // Warn if a choice hasn't been made yet
    if ($('pnd-next-btn').dataset.choiceGate) {
      await modal({ title: 'Make a choice first.', confirmText: 'OK' });
      return;
    }

    // Journey already ended (chose cryosleep)
    if (save.gameOver) {
      await modal({ title: 'Your journey has ended.', text: 'You chose to return to cryosleep. Start a new journey to play again.', confirmText: 'OK' });
      return;
    }

    // Ask player about companions before leaving current chapter
    await checkCompanionPrompts();

    if (hardGate) {
      if (hardGate.type === 'scraps') {
        if (save.currency < hardGate.value) {
          await modal({ title: `${hardGate.value.toLocaleString()} scraps required`, text: hardGate.reason||'', confirmText:'OK' });
          return;
        }
        const res = await modal({
          title: `Pay ${hardGate.value.toLocaleString()} scraps to proceed?`,
          text: hardGate.reason||'', confirmText:'Pay & continue', cancelText:'Not yet', danger:true
        });
        if (!res.confirmed) return;
        save.currency -= hardGate.value;
        hardGate = null; save.chapter++; writeSave(); startGame(); return;
      } else {
        if (!save.inventory.includes(hardGate.value)) {
          await modal({ title: `${hardGate.value} required`, text: hardGate.reason||'', confirmText:'OK' });
          return;
        }
        const res = await modal({
          title: `Use your ${hardGate.value} to proceed?`,
          text: hardGate.reason||'', confirmText:'Yes, continue', cancelText:'Not yet', danger:true
        });
        if (!res.confirmed) return;
        save.inventory.splice(save.inventory.indexOf(hardGate.value), 1);
        hardGate = null; save.chapter++; writeSave(); startGame(); return;
      }
    }

    for (let i = 0; i < FORKS.length; i++) {
      if (nextChapter === FORKS[i].chapter && save.forks[i] === '') {
        if (FORKS[i].auto === 1) {
          save.forks[i] = (FORKS[i].peopleB && save.people.includes(FORKS[i].peopleB)) ? 'B' : 'A';
        } else {
          await modal({ title:'A choice must be made first.', text:"Complete the choice in this chapter before moving on.", confirmText:'OK' });
          return;
        }
      }
    }

    const res = await modal({
      title: 'Move to the next chapter?',
      text:  "Make sure you've completed today's workout first.",
      confirmText: 'Next chapter', cancelText: 'Stay'
    });
    if (!res.confirmed) return;

    // Big Bertha pays 400 scraps when leaving Ch.39A (fork 7 = 'A') → Ch.40
    if (save.chapter === 38 && save.forks[7] === 'A') {
      const berthaRes = await modal({
        title: 'Big Bertha paid you 400 scraps.',
        confirmText: 'Accept', cancelText: 'Reject', dark: true
      });
      if (berthaRes.confirmed) {
        save.currency += 400;
        writeSave(); updateTopBar();
      }
    }

    save.chapter++; writeSave(); startGame();
  }

  /* ─────────────────────────────────────────
     SCREEN SWITCHER
  ───────────────────────────────────────── */

  function showScreen(id) {
    ['pnd-title-screen','pnd-game-screen'].forEach(sid => {
      const el = $(sid);
      if (el) el.classList.toggle('pnd-hidden', el.id !== id);
    });
  }

  /* ─────────────────────────────────────────
     INFO PAGE LOADER  (Instructions / About)
     Switches to the game screen, hides all
     game-specific controls, loads the page,
     and wires EXIT to go back to title.
  ───────────────────────────────────────── */
  async function openInfoPage(url) {
    const wasInGame = !$('pnd-game-screen').classList.contains('pnd-hidden');
    showScreen('pnd-game-screen');
    ['pnd-next-btn','pnd-inventory-btn','pnd-map-btn','pnd-leave-btn'].forEach(id => hide($(id)));
    if (!wasInGame) {
      hide($('pnd-location-display'));
      hide($('pnd-currency-display'));
    }
    show($('pnd-back-to-title-btn'));
    $('pnd-back-to-title-btn').dataset.infoPage = wasInGame ? 'game' : 'title';
    await loadContent(url);
  }

  /* ─────────────────────────────────────────
     TITLE SCREEN
  ───────────────────────────────────────── */

  function runEyeAnimation(callback) {
    const lidT = document.querySelector('.pnd-lid-top');
    const lidB = document.querySelector('.pnd-lid-bottom');
    if (!lidT || !lidB) { callback(); return; }
    lidT.classList.add('pnd-blink'); lidB.classList.add('pnd-blink');
    setTimeout(() => {
      lidT.classList.add('pnd-open'); lidB.classList.add('pnd-open');
      setTimeout(callback, 700);
    }, 1400);
  }

  function renderTitleMenu() {
    const hasSave = !!save;
    if (hasSave) show($('pnd-continue-btn')); else hide($('pnd-continue-btn'));
    show($('pnd-new-btn')); show($('pnd-help-btn')); show($('pnd-about-btn'));

    const saveInfo = $('pnd-save-info');
    const tagline  = $('pnd-no-save-tagline');
    if (hasSave && save.name) {
      const diffLabel = { easy: 'Easy', normal: 'Normal', hard: 'Hard' }[save.difficulty] || 'Normal';
      saveInfo.textContent = save.chapter > 0
        ? `${save.name} \u2014 Chapter ${save.chapter} of 60 \u2014 ${diffLabel}`
        : `${save.name} \u2014 just starting out \u2014 ${diffLabel}`;
      show(saveInfo);
      if (tagline) hide(tagline);
    } else {
      hide(saveInfo);
      if (tagline) show(tagline);
    }
    show($('pnd-title-menu'));

    // Version stamp — injected once into the title screen, bottom-right corner
    const titleScreen = $('pnd-title-screen');
    if (titleScreen && !$('pnd-version-stamp')) {
      const stamp = document.createElement('div');
      stamp.id = 'pnd-version-stamp';
      stamp.textContent = 'v ' + CODE_VERSION;
      Object.assign(stamp.style, {
        position:      'absolute',
        bottom:        '10px',
        right:         '14px',
        fontSize:      '11px',
        color:         '#bbb',
        fontFamily:    'sans-serif',
        userSelect:    'none',
        pointerEvents: 'none',
      });
      titleScreen.style.position = titleScreen.style.position || 'relative';
      titleScreen.appendChild(stamp);
    }
  }

  async function handleNewGame() {
    if (save) {
      const res = await modal({
        title: 'Start a new journey?',
        text:  `This will erase ${save.name}'s progress permanently.`,
        confirmText: 'Erase and restart', cancelText: 'Keep my save', danger: true
      });
      if (!res.confirmed) return;
    }
    const nameRes = await modal({
      title: 'What is your name?', text: 'Pandora will remember you.',
      input: true, confirmText: 'Next'
    });
    if (!nameRes.confirmed) return;

    // Difficulty selection
    const diffRes = await difficultyModal();
    if (!diffRes.confirmed) return;

    save = DEFAULT_SAVE();
    save.name       = nameRes.value;
    save.difficulty = diffRes.difficulty;
    writeSave();
    startGame();
  }

  /* ─────────────────────────────────────────
     DIFFICULTY MODAL
     Shows a three-option card picker.
  ───────────────────────────────────────── */
  function difficultyModal() {
    return new Promise(resolve => {
      const overlay = $('pnd-modal-overlay');
      $('pnd-modal-title').textContent = 'Choose your difficulty';
      $('pnd-modal-text').textContent  = 'This affects workout sets in chapters and travel point requirements on the map.';
      $('pnd-modal-error').textContent = '';
      hide($('pnd-modal-input'));
      hide($('pnd-modal-img'));
      hide($('pnd-modal-cancel'));

      const confirmBtn = $('pnd-modal-confirm');
      confirmBtn.textContent = 'Begin';
      confirmBtn.className   = 'pnd-btn';
      confirmBtn.disabled    = true;

      // Build difficulty cards inside the modal text area
      const DIFF_OPTIONS = [
        { id: 'easy',   label: 'Easy',   desc: '−30% travel points. Fewer sets per workout.' },
        { id: 'normal', label: 'Normal', desc: 'Standard travel points and workout sets.'    },
        { id: 'hard',   label: 'Hard',   desc: '+30% travel points. More sets per workout.'  },
      ];

      const cards = document.createElement('div');
      cards.style.cssText = 'display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;';
      let chosen = null;

      DIFF_OPTIONS.forEach(opt => {
        const card = document.createElement('div');
        card.style.cssText = `
          flex:1;min-width:90px;padding:14px 10px;border:2px solid #ccc;
          cursor:pointer;text-align:center;transition:border-color 0.15s,background 0.15s;
          background:#fff;font-family:'Century Gothic','Futura',sans-serif;
        `;
        card.innerHTML = `<div style="font-size:15px;font-weight:bold;margin-bottom:6px;">${opt.label}</div>
          <div style="font-size:11px;color:#666;line-height:1.5;">${opt.desc}</div>`;

        card.addEventListener('click', () => {
          chosen = opt.id;
          cards.querySelectorAll('[data-diff]').forEach(c => {
            c.style.borderColor = '#ccc';
            c.style.background  = '#fff';
          });
          card.style.borderColor = '#CC0000';
          card.style.background  = '#fff5f5';
          confirmBtn.disabled = false;
        });
        card.setAttribute('data-diff', opt.id);
        cards.appendChild(card);
      });

      $('pnd-modal-text').appendChild(cards);
      show(overlay);

      // Temporarily override confirm button click
      const origResolve = modalResolve;
      modalResolve = null;

      function onConfirm() {
        if (!chosen) return;
        confirmBtn.removeEventListener('click', onConfirm);
        hide(overlay);
        // Clean up the cards from the text element
        $('pnd-modal-text').textContent = '';
        confirmBtn.disabled = false;
        resolve({ confirmed: true, difficulty: chosen });
      }
      function onCancel() {
        confirmBtn.removeEventListener('click', onConfirm);
        hide(overlay);
        $('pnd-modal-text').textContent = '';
        confirmBtn.disabled = false;
        resolve({ confirmed: false });
      }

      confirmBtn.addEventListener('click', onConfirm);
      // No cancel button in this modal
    });
  }



  /* ─────────────────────────────────────────
     INIT
  ───────────────────────────────────────── */

  function init() {
    loadSave();
    initModal();

    // Show title menu immediately — no animation delay
    hide($('pnd-enter-btn'));
    renderTitleMenu();

    $('pnd-new-btn')     ?.addEventListener('click', handleNewGame);
    $('pnd-continue-btn')?.addEventListener('click', startGame);
    $('pnd-help-btn')    ?.addEventListener('click', () => openInfoPage(`${BASE_URL}help.html`));
    $('pnd-about-btn')   ?.addEventListener('click', () => openInfoPage(`${BASE_URL}about.html`));

    $('pnd-next-btn')     ?.addEventListener('click', handleNextChapter);
    $('pnd-bottom-next-btn')?.addEventListener('click', handleNextChapter);
    $('pnd-inventory-btn')?.addEventListener('click', openInventory);
    $('pnd-loc-close')?.addEventListener('click', closeLocationOverlay);
    $('pnd-loc-overlay')?.addEventListener('click', e => {
      if (e.target === $('pnd-loc-overlay')) closeLocationOverlay();
    });

    $('pnd-leave-btn')?.addEventListener('click', async () => {
      showNext();
      closeLocationOverlay();
      // leave-btn = "Back to Chapter" from inventory/camp
      const nextChapter = save.chapter + 1;
      const url = nextChapter === 61 ? calcEndingUrl() : buildDayUrl(nextChapter);
      await loadContent(url, isPreEnding ? bindPreEnding : isEnding ? bindEnding : bindAreaButtons);
    });

    // map-btn = "Map" OR "Back to Map" from a location page
    // Re-wire map-btn to also handle going back to map from locations
    $('pnd-map-btn')?.addEventListener('click', openMap);

    $('pnd-back-to-title-btn')?.addEventListener('click', async () => {
      const btn = $('pnd-back-to-title-btn');
      const infoFlag = btn.dataset.infoPage;

      if (infoFlag === 'game') {
        delete btn.dataset.infoPage;
        startGame();
        return;
      }

      if (infoFlag === 'title') {
        delete btn.dataset.infoPage;
        closeLocationOverlay();
        showScreen('pnd-title-screen');
        renderTitleMenu();
        return;
      }

      const res = await modal({
        title: 'Leave Pandora?', text: 'Your progress is saved.',
        confirmText: 'Yes, leave', cancelText: 'Stay'
      });
      if (res.confirmed) {
        closeLocationOverlay();
        showScreen('pnd-title-screen');
        renderTitleMenu();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else { init(); }

})();
