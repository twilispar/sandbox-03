/**
 * Age of Pandora — v3.2
 * Build: 2026-04-10 12:26
 * Deploy: replace Pandora.js on server with this file (mind the capital P).
 * Changes from v3:
 *  - Interactive elements vanish/appear immediately on interaction (no page reload)
 *  - refreshUI() is the single source of truth for all element visibility
 *  - Inventory panel: map item links to map, items update live after trades
 *  - Chapter pages: scraps/items/people divs hide on collect, show on sell
 *  - Auction house: items appear when you own them, hide when sold
 *  - All shops, jobs, hunting grounds, fighting pits sync with save state
 *
 * VERSION SYSTEM
 *  Bump CODE_VERSION on every deploy (e.g. '3.2' → '3.3').
 *  On load, if the stored version doesn't match, the page reloads once
 *  with a cache-busting query param — forcing fresh JS/CSS from the server.
 *  Player save data is completely unaffected.
 */

(() => {
  'use strict';

  /* ─────────────────────────────────────────
     VERSION — bump this on every deploy
     Format: '3.2', '3.3', '3.4' …
  ───────────────────────────────────────── */
  const CODE_VERSION = '2.3.6';
  const VER_KEY      = 'darebee_pandora_ver';

  (function checkVersion() {
    const stored = localStorage.getItem(VER_KEY);
    if (stored === CODE_VERSION) return;           // already up to date

    localStorage.setItem(VER_KEY, CODE_VERSION);  // record new version first

    // Guard against infinite reload loops (e.g. server not updated yet)
    const url = new URL(window.location.href);
    if (url.searchParams.get('_v') === CODE_VERSION) return;

    url.searchParams.set('_v', CODE_VERSION);
    window.location.replace(url.toString());       // reload with cache-bust param
    // ↑ execution stops here; everything below runs only after the fresh load
  })();

  /* ─────────────────────────────────────────
     DEV MODE
     Set to false before shipping.
  ───────────────────────────────────────── */
  /* ─────────────────────────────────────────
     STATIC GAME DATA
  ───────────────────────────────────────── */

