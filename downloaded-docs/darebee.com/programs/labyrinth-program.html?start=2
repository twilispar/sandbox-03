<!-- Toast -->
<div id="toast" role="status" aria-live="polite"></div>

<script>
  const ROWS=8, COLS=5, TOTAL=40;
  const BASE_URL = "https://darebee.com/programs/labyrinth-program.html?showall=&start=";
  const KEY_NODE = 29;   // where the KEY is found
  const EXIT_NODE = 40;  // exit requires KEY

  // Load/save helpers
  function loadProgress(){ try{ return new Set(JSON.parse(localStorage.getItem('labyrinthProgress')||'[]')); }catch(e){ return new Set(); } }
  function saveProgress(set){
    localStorage.setItem('labyrinthProgress', JSON.stringify([...set]));
    localStorage.setItem('labyrinthSavedAt', new Date().toISOString());
  }

  function hasKey(){ return localStorage.getItem('labyrinthKey') === 'true'; }
  function setKey(v){
    localStorage.setItem('labyrinthKey', v ? 'true' : 'false');
    updateKeyUI();
    if(v) showToast('KEY ACQUIRED');
  }

  function showToast(msg){
    const el = document.getElementById('toast');
    if(!el) return;
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(()=> el.classList.remove('show'), 1400);
  }

  function resetProgress(){
    if(!confirm('Reset your Labyrinth progress? This clears your entire path and returns you to START. This cannot be undone.')) return;
    localStorage.removeItem('labyrinthProgress');
    localStorage.removeItem('labyrinthCurrent');
    localStorage.removeItem('labyrinthKey');
    localStorage.removeItem('labyrinthSavedAt');
    // Also clear old cookies
    document.cookie = 'labyrinth_progress=;Max-Age=0;Path=/;SameSite=Lax';
    document.cookie = 'labyrinth_key=;Max-Age=0;Path=/;SameSite=Lax';
    document.cookie = 'labyrinth_current=;Max-Age=0;Path=/;SameSite=Lax';
    window.location.href = BASE_URL + "1";
  }

  // Migrate legacy cookies to localStorage on first load
  (function migrateLegacyCookies(){
    // Only migrate if localStorage is empty (no new data yet)
    if (localStorage.getItem('labyrinthProgress') !== null) return;

    function getCookie(n){
      const m = document.cookie.match(new RegExp('(?:^|; )' + n.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : '';
    }
    function delCookie(n){ document.cookie = n + '=;Max-Age=0;Path=/;SameSite=Lax'; }

    const progressRaw = getCookie('labyrinth_progress');
    if (progressRaw) {
      try {
        const nodes = JSON.parse(progressRaw);
        if (Array.isArray(nodes) && nodes.length) {
          localStorage.setItem('labyrinthProgress', JSON.stringify(nodes));
        }
      } catch(e) {}
      delCookie('labyrinth_progress');
    }

    const keyRaw = getCookie('labyrinth_key');
    if (keyRaw) {
      localStorage.setItem('labyrinthKey', keyRaw === 'true' ? 'true' : 'false');
      delCookie('labyrinth_key');
    }

    const currentRaw = getCookie('labyrinth_current');
    if (currentRaw) {
      const n = parseInt(currentRaw, 10);
      if (Number.isInteger(n) && n >= 1 && n <= 40) {
        localStorage.setItem('labyrinthCurrent', String(n));
      }
      delCookie('labyrinth_current');
    }
  })();

  // Current node helpers
  function getCurrentFromURL(){
    const p=new URLSearchParams(location.search); const s=p.get('start');
    const n = s? parseInt(s,10): NaN;
    return (Number.isInteger(n) && n>=1 && n<=TOTAL)? n : null;
  }

  let opened = loadProgress();
  if(opened.size===0){ opened.add(1); }

  // Determine current node (URL > localStorage > default 1)
  let current = getCurrentFromURL();
  if(current==null){
    try{
      const saved = parseInt(localStorage.getItem('labyrinthCurrent'),10);
      if(Number.isInteger(saved) && saved>=1 && saved<=TOTAL) current = saved;
    }catch(e){}
  }
  if(current==null) current = 1;

  // Always show current node (ensure it's open/visible), BUT don't auto-open EXIT without KEY
  if(current !== EXIT_NODE || hasKey()){
    opened.add(current);
    saveProgress(opened);
  }

  function rowOf(n){ return Math.ceil(n/COLS); }
  function colOf(n){ return ((n-1)%COLS)+1; }
  function neighborId(n,dir){
    const r=rowOf(n), c=colOf(n);
    if(dir==='up'&&r>1) return n-COLS;
    if(dir==='down'&&r<ROWS) return n+COLS;
    if(dir==='left'&&c>1) return n-1;
    if(dir==='right'&&c<COLS) return n+1;
    return null;
  }

  const EDGES = [
    [1,2],[2,3],[3,8],[8,13],[13,14],[14,19],[19,24],[24,25],[25,30],[30,35],[35,40],
    [31,36],[36,37],[37,38],[38,39],[39,40],
    [3,4],[4,5],[5,10],[10,11],[11,16],[16,21],
    [8,9],[9,10],[10,15],
    [19,20],[20,21],[21,22],[22,27],[27,28],[28,29],
    [26,27],[26,31],[31,32],[32,33],[33,34],[34,35],
    [28,33],
    [1,6],[6,7],[7,8],[6,11],
    [7,12],[12,17],[17,18],[18,19],
    [22,23]
  ];
  const EDGES_SET = new Set(EDGES.map(([a,b])=>`${a}-${b}`).concat(EDGES.map(([a,b])=>`${b}-${a}`)));
  function hasEdge(a,b){ return EDGES_SET.has(`${a}-${b}`); }

  function allowedDirs(n){
    const dirs=['up','down','left','right']; const out={};
    for(const d of dirs){ const nb=neighborId(n,d); out[d]= nb? hasEdge(n,nb): false; }
    return out;
  }

  // Only unlock a node if adjacent + (if EXIT) KEY is owned
  function canUnlock(n){
    if(opened.has(n)) return true;
    if(n===1) return true;
    if(n===EXIT_NODE && !hasKey()) return false; // EXIT requires key
    for(const d of ['up','down','left','right']){
      const nb=neighborId(n,d);
      if(nb && opened.has(nb) && hasEdge(n,nb)) return true;
    }
    return false;
  }

  // Expedition header
  function refreshHead(){
    const countEl = document.getElementById('labCount');
    const fillEl  = document.getElementById('labFill');
    if(countEl) countEl.textContent = String(opened.size);
    if(fillEl)  fillEl.style.width = Math.round((opened.size / TOTAL) * 100) + '%';
  }

  const grid=document.getElementById('grid');
  const svg=document.querySelector('svg.connections');
  const nodes={};

  for(let n=1;n<=TOTAL;n++){
    const a=document.createElement('a'); a.href=BASE_URL+n; a.target="_self"; a.className='tile'; a.dataset.id=n;

    const core=document.createElement('div'); core.className='node-core';
    const num=document.createElement('span'); num.className='num';
    num.textContent = (n===1? 'START' : (n===40? 'EXIT' : n));
    core.appendChild(num);

    const dirs=allowedDirs(n);
    for(const d of Object.keys(dirs)){ if(dirs[d]){ const arm=document.createElement('span'); arm.className=`arm ${d}`; core.appendChild(arm); } }

    const ov=document.createElement('div'); ov.className='overlay'; ov.dataset.id=n;
    const note=document.createElement('div'); note.className='lock-note'; ov.appendChild(note);

    // Per-tile overlay refresher (stored so we can call it later)
    function refreshOverlay(){
      // EXIT without key: force NEED KEY state even if adjacent is open
      if(n===EXIT_NODE && !hasKey()){
        if(opened.has(n)){
          ov.classList.add('hidden');
          ov.classList.remove('need-key');
          ov.removeAttribute('data-tip');
        } else {
          ov.classList.remove('hidden');
          ov.classList.remove('can-open');
          ov.classList.add('need-key');
          ov.setAttribute('data-tip','NEED KEY');
          ov.innerHTML = '<span>NEED KEY</span>';
        }
        a.setAttribute('aria-label','EXIT - locked, key required');
        return;
      }

      ov.classList.remove('need-key');
      ov.removeAttribute('data-tip');

      if(opened.has(n)){
        ov.classList.add('hidden'); a.classList.add('visited');
        a.setAttribute('aria-label', (n===1?'START':(n===40?'EXIT':'Room '+n)) + ' - explored, open room');
      } else if(canUnlock(n)){
        ov.classList.remove('hidden'); ov.classList.add('can-open'); a.classList.remove('visited');
        ov.textContent='UNLOCK'; ov.appendChild(note); note.textContent='';
        a.setAttribute('aria-label','Room '+n+' - ready to unlock');
      } else {
        ov.classList.remove('hidden'); ov.classList.remove('can-open'); a.classList.remove('visited');
        ov.innerHTML='<span class="lab_locked">LOCKED</span>'; ov.appendChild(note); note.textContent='';
        a.setAttribute('aria-label','Room '+n+' - locked');
      }
    }

    ov.addEventListener('click',(e)=>{
      // If EXIT without key, block
      if(n===EXIT_NODE && !hasKey()){
        ov.classList.add('shake');
        setTimeout(()=>ov.classList.remove('shake'),250);
        e.preventDefault(); return false;
      }

      if(!canUnlock(n)){
        ov.classList.remove('hidden'); ov.classList.add('shake');
        setTimeout(()=>ov.classList.remove('shake'),250);
        e.preventDefault(); return false;
      }

      opened.add(n); saveProgress(opened);
      a.classList.add('reveal');

      // KEY pickup at the key room
      if(n===KEY_NODE && !hasKey()){
        setKey(true);
        // Refresh EXIT tile overlay/tooltip and badges instantly
        nodes[EXIT_NODE]?.refresh?.();
      }

      // remember current node for highlighting on return
      try{ localStorage.setItem('labyrinthCurrent', String(n)); }catch(err){}
      refreshOverlay(); drawConnections(); refreshHead();
    }, true);

    a.appendChild(core); a.appendChild(ov); grid.appendChild(a);
    nodes[n]=a; nodes[n].refresh = refreshOverlay; // store refresher
    refreshOverlay();
  }

  // Mark the current node visually
  if(nodes[current]) nodes[current].classList.add('current');

  function drawConnections(){
    const gridW = grid.clientWidth;           // content width
    const cell = gridW / COLS;
    const gridH = cell * ROWS;

    // fit SVG to grid content box
    svg.setAttribute('viewBox', `0 0 ${gridW} ${gridH}`);
    svg.style.width = gridW + 'px';
    svg.style.height = gridH + 'px';

    svg.innerHTML='';
    for(const [a,b] of EDGES){
      if(!(opened.has(a)&&opened.has(b))) continue;
      const ar=rowOf(a)-1, ac=colOf(a)-1;
      const br=rowOf(b)-1, bc=colOf(b)-1;
      const ax=ac*cell + cell/2, ay=ar*cell + cell/2;
      const bx=bc*cell + cell/2, by=br*cell + cell/2;

      const line=document.createElementNS('http://www.w3.org/2000/svg','line');
      line.setAttribute('x1',ax); line.setAttribute('y1',ay); line.setAttribute('x2',bx); line.setAttribute('y2',by);
      svg.appendChild(line);

      const c1=document.createElementNS('http://www.w3.org/2000/svg','circle');
      c1.setAttribute('cx',ax); c1.setAttribute('cy',ay); c1.setAttribute('r',4); svg.appendChild(c1);
      const c2=document.createElementNS('http://www.w3.org/2000/svg','circle');
      c2.setAttribute('cx',bx); c2.setAttribute('cy',by); c2.setAttribute('r',4); svg.appendChild(c2);
    }
  }

  function updateKeyUI(){
    const el = document.getElementById('keyStatus');
    if(el){
      if(hasKey()){ el.textContent = 'Key: found'; el.classList.add('found'); }
      else { el.textContent = 'Key: not found'; el.classList.remove('found'); }
    }
    // Badge tile: show the key icon only on the room where it was found
    if(nodes[KEY_NODE]){
      if(hasKey()) nodes[KEY_NODE].classList.add('badge-key');
      else nodes[KEY_NODE].classList.remove('badge-key');
    }
    // Never show the icon on EXIT
    if(nodes[EXIT_NODE]) nodes[EXIT_NODE].classList.remove('badge-key');
  }

  // Initial draw + keep connections aligned on resize
  updateKeyUI();
  refreshHead();
  drawConnections();
  window.addEventListener('resize', drawConnections);
</script>
