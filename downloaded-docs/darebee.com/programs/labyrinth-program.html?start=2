<script>
(function(){
  // SUGGEST NEXT - loader stub. The suggestion logic lives in a
  // separate file (SRC below) that is only requested on first click,
  // so pages carry ~1KB of widget instead of the full code.
  var SRC = 'https://darebee.com/toolbox/suggest/suggest-next.js';

  var wrap  = document.getElementById('sgn-wrap');
  var btn   = document.getElementById('sgn-btn');
  var panel = document.getElementById('sgn-panel');
  if (!wrap || !btn || !panel) return;

  var path = location.pathname;
  var SECTION =
    path.indexOf('/workouts/')   === 0 ? 'workouts'   :
    path.indexOf('/challenges/') === 0 ? 'challenges' :
    path.indexOf('/programs/')   === 0 ? 'programs'   :
    path.indexOf('/fitness/')    === 0 ? 'guides'     : null;

  if (!SECTION) { wrap.style.display = 'none'; return; }

  var injecting = false;

  btn.addEventListener('click', function(){
    if (!panel.hidden) {
      panel.hidden = true;
      btn.setAttribute('aria-expanded','false');
      return;
    }
    panel.hidden = false;
    btn.setAttribute('aria-expanded','true');

    if (window.DBSuggestNext) { window.DBSuggestNext(SECTION, panel); return; }
    if (injecting) return;
    injecting = true;
    panel.innerHTML = '<div class="sgn-status">Loading...</div>';
    var s = document.createElement('script');
    s.src = SRC + '?v=' + new Date().toISOString().slice(0,10);
    s.onload = function(){
      if (window.DBSuggestNext) window.DBSuggestNext(SECTION, panel);
    };
    s.onerror = function(){
      panel.innerHTML = '<div class="sgn-status">Could not load suggestions right now.</div>';
      injecting = false; // allow a retry on next open
    };
    document.head.appendChild(s);
  });
