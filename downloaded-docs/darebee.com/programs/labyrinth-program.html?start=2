<script>
(function(){
  var box = document.currentScript.previousElementSibling;
  while (box && !(box.classList && box.classList.contains('dareTIMER'))) box = box.previousElementSibling;
  if (!box) {
    var all = document.querySelectorAll('.dareTIMER[data-dbtimer]:not([data-dbt-bound])');
    box = all.length ? all[all.length - 1] : null;
  }
  if (!box || box.getAttribute('data-dbt-bound')) return;
  box.setAttribute('data-dbt-bound','1');
  var tc = box.querySelector('.timerContainer');
  var sb = box.querySelector('.show_timer');
  function run(){ if (window.DBTimerRun) window.DBTimerRun(box); }
  sb.addEventListener('click', function(){
    var open = tc.style.display === 'block';
    tc.style.display = open ? 'none' : 'block';
    var c = sb.querySelector('.caret');
    if (c) c.textContent = open ? '\u25BC' : '\u25B2';
    if (open) return;
    if (window.DBTimerRun) { run(); return; }
    if (window.DBTimerLoading) return;
    window.DBTimerLoading = true;
    tc.innerHTML = '<div style="padding:8px 0">Loading...</div>';
    var s = document.createElement('script');
    s.src = 'https://darebee.com/toolbox/timers/timer-engine.js?v=' + new Date().toISOString().slice(0,10);
    s.onload = function(){ run(); };
    s.onerror = function(){
      tc.innerHTML = '<div style="padding:8px 0">Could not load the timer. Please reload the page and try again.</div>';
      window.DBTimerLoading = false;
    };
    document.head.appendChild(s);
  });
})();
