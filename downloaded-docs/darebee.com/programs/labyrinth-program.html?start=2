  function getAll(){ try{ return JSON.parse(localStorage.getItem(KEY))||[]; }catch{ return []; } }
  function saveAll(a){ localStorage.setItem(KEY, JSON.stringify(a)); }
  function isSaved(){ return getAll().some(b => b.url === url); }

  function setAppearance(on){
    btn.classList.toggle('on', on);
    btn.setAttribute('aria-label', on ? 'Remove Bookmark' : 'Add to Bookmarks');
    lbl.textContent = on ? 'Bookmarked' : 'Bookmark';
    pth.setAttribute('fill', on ? 'currentColor' : 'none');
  }

  setAppearance(isSaved());

  btn.addEventListener('click', function(){
    if(isSaved()){
      saveAll(getAll().filter(b => b.url !== url));
      setAppearance(false);
    } else {
      const all = getAll().filter(b => b.url !== url);
      all.unshift({ url, img, cat, ts: Date.now() });
      saveAll(all);
      setAppearance(true);
      btn.classList.add('pulse');
