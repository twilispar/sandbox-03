  function lsGet(k) { try { return localStorage.getItem(k); } catch(e) { return null; } }
  function lsSet(k, v) { try { localStorage.setItem(k, v); } catch(e) {} }

  const wrapper  = document.querySelector('.index_wrapper[data-program]');
  const progKey  = wrapper ? wrapper.getAttribute('data-program') : '';
  const total    = wrapper ? parseInt(wrapper.getAttribute('data-total') || '30', 10) : 30;

  const slugMatch = location.pathname.match(/\/programs\/(.+)\.html/);
  const slug  = slugMatch ? slugMatch[1] : progKey;
  const title = document.title.replace(/\s*[-|].*$/, '').trim();

  const metaKey = progKey ? progKey + ':meta' : null;
  const logKey  = progKey ? progKey + ':log'  : null;

  function getCheckedCount() {
    if (!progKey) return 0;
    let count = 0;
    for (let d = 1; d <= total; d++) {
      if (lsGet(progKey + ':' + d) === '1') count++;
    }
    return count;
  }

  function ensureMeta(startedAt) {
    if (!metaKey || lsGet(metaKey)) return;
    lsSet(metaKey, JSON.stringify({ slug, title, total, url: location.pathname, startedAt: startedAt || new Date().toISOString() }));
  }

  function checkCompletion() {
    if (total > 0 && getCheckedCount() >= total) w.classList.add('complete');
    else w.classList.remove('complete');
  }

  if (wrapper) {
    wrapper.addEventListener('click', function(e) {
      const btn = e.target.closest('button.aaa[data-day]');
      if (!btn || !logKey) return;
      const day     = parseInt(btn.getAttribute('data-day'), 10);
      const doneNow = btn.getAttribute('aria-pressed') !== 'true';
      const log     = JSON.parse(lsGet(logKey) || '{}');
      if (doneNow) { log[day] = new Date().toISOString(); ensureMeta(log[day]); }
      else { delete log[day]; }
      lsSet(logKey, JSON.stringify(log));
      setTimeout(checkCompletion, 50);
    }, true);
  }

  checkCompletion();
})();
