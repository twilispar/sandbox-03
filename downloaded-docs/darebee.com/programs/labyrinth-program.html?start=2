<p><!-- The Labyrinth - interactive map tracker (v2 look)
     Same engine, rules and storage as before:
     labyrinthProgress / labyrinthCurrent / labyrinthKey / labyrinthSavedAt
     + legacy cookie migration. KEY at node 29, EXIT (40) requires the key.
     CSS lives here - Labyrinth-only. -->
<style>
  /* ── Header: expedition status ── */
  #labHead {
    max-width: 1000px;
    margin: 0 auto 16px auto;
    text-align: center;
    font-family: 'Pathway Gothic One', Arial, sans-serif;
  }
  #labHead .lab_stat {
    font-size: 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555555;
  }
  #labHead .lab_stat strong { color: #141414; font-weight: normal; }
  #labHead .lab_bar {
    height: 5px;
    background: #e0e0e0;
    max-width: 420px;
    margin: 8px auto 8px auto;
    overflow: hidden;
  }
  #labHead .lab_fill { height: 100%; width: 0; background: #CC0000; transition: width 0.4s ease; }
  #keyStatus {
    display: inline-block;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #888888;
    border: 1px solid #cccccc;
    padding: 2px 8px;
  }
  #keyStatus.found { color: #CC0000; border-color: #CC0000; font-weight: normal; }

  /* ── Responsive grid ── */
  #grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    background: #fff;
    border: 2px solid #cccccc;
    box-sizing: border-box;
    position: relative;
    z-index: 1 !important;
  }
  @media (max-width: 566px) {
    #grid { max-width: 350px; }
    .num { font-size: 15px !important; padding: 2px 4px !important; }
  }

  #grid a, #grid a:hover { text-decoration: none !important; }

  /* ── Tiles ── */
  .tile {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: none;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-core { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }

  .num {
    font-family: 'Pathway Gothic One', Arial, sans-serif;
    font-size: 21px;
    font-weight: normal;
    letter-spacing: 1px;
    color: #141414;
    background: #fff !important;
    padding: 4px 9px;
    position: relative;
    z-index: 2 !important;
  }

  /* START and EXIT stand out */
  .tile[data-id="1"] .num { background: #141414 !important; color: #fff; }
  .tile[data-id="40"].visited .num { background: #CC0000 !important; color: #fff; }

  /* Current room: red pulsing ring */
  .tile.current::after {
    content: "";
    position: absolute;
    inset: 6%;
    border: 3px solid #CC0000;
    border-radius: 2px;
    box-shadow: 0 0 0 0 rgba(204, 0, 0, 0.35);
    animation: pulse 1.4s ease-out infinite;
    pointer-events: none;
    z-index: 4;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(204, 0, 0, 0.35); }
    70%  { box-shadow: 0 0 0 8px rgba(204, 0, 0, 0); }
    100% { box-shadow: 0 0 0 0 rgba(204, 0, 0, 0); }
  }

  /* ── Overlays: LOCKED / UNLOCK / NEED KEY ── */
  .overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: #f5f5f5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-align: center;
    z-index: 3 !important;
    font-family: 'Pathway Gothic One', Arial, sans-serif;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .overlay.hidden { display: none; }

  /* Frontier rooms invite the click - red text only,
     the red ring stays reserved for the current room */
  .overlay.can-open {
    background: #fff;
    color: #CC0000;
    transition: background 0.15s ease;
  }
  .overlay.can-open:hover { background: #fff5f5; }

  .overlay .lock-note { font-size: 10px; font-weight: normal; letter-spacing: 0.5px; }

  .lab_locked { color: #c2c2c2; }

  .shake { animation: shake 0.25s; }
  @keyframes shake {
    0% { transform: translateX(0); } 25% { transform: translateX(-4px); }
    50% { transform: translateX(4px); } 75% { transform: translateX(-4px); }
    100% { transform: translateX(0); }
  }

  /* Room reveal animation */
  .tile.reveal .node-core { animation: reveal 0.35s ease; }
  @keyframes reveal {
    0% { opacity: 0; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* ── Passages (arms + connection lines) ── */
  .arm { position: absolute; background: #141414; }
  .arm.up    { top: 0;    left: 50%; width: 2px;  height: 50%; transform: translateX(-50%); }
  .arm.down  { bottom: 0; left: 50%; width: 2px;  height: 50%; transform: translateX(-50%); }
  .arm.left  { left: 0;   top: 50%;  height: 2px; width: 50%;  transform: translateY(-50%); }
  .arm.right { right: 0;  top: 50%;  height: 2px; width: 50%;  transform: translateY(-50%); }

  svg.connections {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 0 !important;
  }
  svg.connections line { stroke: #141414; stroke-width: 2; }
  svg.connections circle { fill: #141414; }

  /* ── KEY badge on the key room once found ── */
  .tile.badge-key::before {
    content: "";
    position: absolute;
    top: 20%; right: 10%;
    transform: translate(-50%, -50%);
    width: 32px; height: 32px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
