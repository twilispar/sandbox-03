<script>
(function () {
  "use strict";

  function safeGet(key) {
    try { return window.localStorage.getItem(key); } catch (e) { return null; }
  }
  function safeSet(key, val) {
    try { window.localStorage.setItem(key, val); } catch (e) {}
  }
  function safeGetJSON(key) {
    try { return JSON.parse(window.localStorage.getItem(key)) || {}; } catch (e) { return {}; }
  }
  function updateLog(programKey, day, doneNow) {
    var logKey = programKey + ":log";
    var log = safeGetJSON(logKey);
    if (doneNow) {
      log[day] = new Date().toISOString();
    } else {
      delete log[day];
    }
    safeSet(logKey, JSON.stringify(log));
  }

  function setDone(row, btn, done) {
    row.classList.toggle("is-done", done);
    btn.classList.toggle("is-checked", done);
    btn.setAttribute("aria-pressed", done ? "true" : "false");
  }

  // True when the user is on a specific day page (?start=1 and up)
  function onDayPage() {
    var m = window.location.search.match(/[?&]start=(\d+)/);
    return !!(m && parseInt(m[1], 10) >= 1);
  }

  // ── Lightbox (built once, shared) ──────────────────────────────
  var lightbox = null;
  var lightboxImg = null;
  var lastTrigger = null;

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove("is-open");
    document.body.classList.remove("index_lightbox_open");
    if (lastTrigger) { lastTrigger.focus(); lastTrigger = null; }
  }

  function openLightbox(src, trigger) {
    if (!lightbox) {
      lightbox = document.createElement("div");
      lightbox.className = "index_lightbox";
      lightbox.setAttribute("role", "dialog");
      lightbox.setAttribute("aria-label", "Program preview");

      var close = document.createElement("button");
      close.type = "button";
      close.className = "index_lightbox_close";
      close.setAttribute("aria-label", "Close preview");
      close.innerHTML = "&times;";

      lightboxImg = document.createElement("img");
      lightboxImg.alt = "Program preview";
      lightboxImg.addEventListener("click", function (e) { e.stopPropagation(); });

      lightbox.appendChild(close);
      lightbox.appendChild(lightboxImg);
      document.body.appendChild(lightbox);

      lightbox.addEventListener("click", closeLightbox);
      close.addEventListener("click", closeLightbox);
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeLightbox();
      });
    }
    lastTrigger = trigger || null;
    lightboxImg.src = src;
    lightbox.classList.add("is-open");
    document.body.classList.add("index_lightbox_open");
    lightbox.querySelector(".index_lightbox_close").focus();
  }

  // ── Widgets ────────────────────────────────────────────────────
  document.querySelectorAll(".index_v2[data-program][data-total][data-href]").forEach(function (root) {
    var programKey = root.getAttribute("data-program") || "program";
    var total = parseInt(root.getAttribute("data-total") || "0", 10);
    var hrefTpl = root.getAttribute("data-href") || "";
    var previewUrl = root.getAttribute("data-preview") || "";

    var list = root.querySelector(".index_list");
    var title = root.querySelector(".index_title");
    if (!list || !total || !hrefTpl) return;

    // Preview link - always shown on the program introduction page,
    // hidden only on actual day pages (?start=1 and up)
    if (previewUrl && title && !onDayPage()) {
      var pv = document.createElement("div");
      pv.className = "index_preview";
      var pvLink = document.createElement("a");
      pvLink.href = previewUrl;
      pvLink.target = "_blank";
      pvLink.rel = "noopener";
      pvLink.textContent = "Preview Program";
      pvLink.addEventListener("click", function (e) {
        e.preventDefault();
        openLightbox(previewUrl, pvLink);
      });
      pv.appendChild(pvLink);
      title.insertAdjacentElement("afterend", pv);
    }

    // Progress summary
    var progress = document.createElement("div");
    progress.className = "index_progress";
    var count = document.createElement("div");
    count.className = "index_count";
    var bar = document.createElement("div");
    bar.className = "index_bar";
    var fill = document.createElement("div");
    fill.className = "index_fill";
    bar.appendChild(fill);
    progress.appendChild(count);
    progress.appendChild(bar);
    list.insertAdjacentElement("beforebegin", progress);

    function refreshSummary() {
      var done = 0;
      var nextDay = 0;
      for (var d = 1; d <= total; d++) {
        if (safeGet(programKey + ":" + d) === "1") {
          done++;
        } else if (!nextDay) {
          nextDay = d;
        }
      }
      count.innerHTML = "<strong>" + done + "</strong> of " + total + " days";
      fill.style.width = Math.round((done / total) * 100) + "%";

      // Highlight the first unchecked day
      list.querySelectorAll(".ppp.is-next").forEach(function (r) {
        r.classList.remove("is-next");
      });
      if (nextDay) {
        var nextRow = list.querySelector('.ppp[data-day="' + nextDay + '"]');
        if (nextRow) nextRow.classList.add("is-next");
      }
    }

    // Build list
    var frag = document.createDocumentFragment();
    for (var day = 1; day <= total; day++) {
      var row = document.createElement("div");
      row.className = "ppp";
      row.setAttribute("data-day", String(day));

      var link = document.createElement("a");
      link.href = hrefTpl.replace("{day}", String(day));
      link.textContent = "Day " + day;

      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "aaa";
      btn.setAttribute("data-day", String(day));
      btn.setAttribute("aria-pressed", "false");
      btn.setAttribute("aria-label", "Mark Day " + day + " complete");

      row.appendChild(link);
      row.appendChild(btn);
      frag.appendChild(row);

      // Restore saved state
      var storageKey = programKey + ":" + day;
      if (safeGet(storageKey) === "1") setDone(row, btn, true);
    }
    list.innerHTML = "";
    list.appendChild(frag);
    refreshSummary();

    // Toggle handler (event delegation)
    root.addEventListener("click", function (e) {
      var btn = e.target.closest("button.aaa");
      if (!btn || !root.contains(btn)) return;

      var row = btn.closest(".ppp");
      if (!row) return;

      var day = btn.getAttribute("data-day");
      var storageKey = programKey + ":" + day;

      var doneNow = btn.getAttribute("aria-pressed") !== "true";
      setDone(row, btn, doneNow);
      safeSet(storageKey, doneNow ? "1" : "0");
      updateLog(programKey, day, doneNow);
      refreshSummary();
    });
  });
})();
</script>
