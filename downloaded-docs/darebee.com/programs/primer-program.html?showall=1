  function safeSet(key, val) {
    try { window.localStorage.setItem(key, val); } catch (e) {}
  }
  function safeGetJSON(key) {
    try { return JSON.parse(window.localStorage.getItem(key)) || {}; } catch (e) { return {}; }
  }
  function updateLog(programKey, day, doneNow) {
    var logKey = programKey + ":log";
    var log = safeGetJSON(logKey);
    if (doneNow) {
      log[day] = new Date().toISOString();
    } else {
      delete log[day];
    }
    safeSet(logKey, JSON.stringify(log));
  }

  function setDone(row, btn, done) {
    row.classList.toggle("is-done", done);
    btn.classList.toggle("is-checked", done);
    btn.setAttribute("aria-pressed", done ? "true" : "false");
  }

  // True when the user is on a specific day page (?start=1 and up)
  function onDayPage() {
    var m = window.location.search.match(/[?&]start=(\d+)/);
    return !!(m && parseInt(m[1], 10) >= 1);
  }

  // ── Lightbox (built once, shared) ──────────────────────────────
  var lightbox = null;
  var lightboxImg = null;
  var lastTrigger = null;

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove("is-open");
    document.body.classList.remove("index_lightbox_open");
    if (lastTrigger) { lastTrigger.focus(); lastTrigger = null; }
  }

  function openLightbox(src, trigger) {
    if (!lightbox) {
      lightbox = document.createElement("div");
      lightbox.className = "index_lightbox";
      lightbox.setAttribute("role", "dialog");
      lightbox.setAttribute("aria-label", "Program preview");

      var close = document.createElement("button");
      close.type = "button";
      close.className = "index_lightbox_close";
      close.setAttribute("aria-label", "Close preview");
      close.innerHTML = "&times;";

      lightboxImg = document.createElement("img");
      lightboxImg.alt = "Program preview";
      lightboxImg.addEventListener("click", function (e) { e.stopPropagation(); });

      lightbox.appendChild(close);
      lightbox.appendChild(lightboxImg);
      document.body.appendChild(lightbox);

      lightbox.addEventListener("click", closeLightbox);
      close.addEventListener("click", closeLightbox);
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeLightbox();
      });
    }
    lastTrigger = trigger || null;
    lightboxImg.src = src;
    lightbox.classList.add("is-open");
    document.body.classList.add("index_lightbox_open");
    lightbox.querySelector(".index_lightbox_close").focus();
  }

