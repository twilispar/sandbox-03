(function () {
    var wrap = document.getElementById('dbs_hrev');
    if (!wrap) { return; }

    /* --- show more / show less: toggle the whole card --- */
    var moreButtons = wrap.querySelectorAll('.dbs-hrev-more');
    Array.prototype.forEach.call(moreButtons, function (btn) {
        btn.addEventListener('click', function () {
            var p = btn.parentNode;
            var shortEl  = p.querySelector('.dbs-hrev-short');
            var fullEl   = p.querySelector('.dbs-hrev-full');
            var expanded = fullEl && fullEl.style.display === 'inline';
            if (expanded) {
                /* collapse back to the teaser */
                if (shortEl) { shortEl.style.display = 'inline'; }
                if (fullEl)  { fullEl.style.display = 'none'; }
                btn.textContent = 'show more';
            } else {
                /* expand the full review */
                if (shortEl) { shortEl.style.display = 'none'; }
                if (fullEl)  { fullEl.style.display = 'inline'; }
                btn.textContent = '   show less';
            }
            stopAuto(); /* don't swap the slide out from under a reader */
        });
    });

    /* --- mobile slideshow: 5s auto-advance --- */
    var cards = wrap.querySelectorAll('.dbs-hrev-item');
    var dots  = wrap.querySelectorAll('.dbs-hrev-dot');
    var mq    = window.matchMedia ? window.matchMedia('(max-width: 767px)') : null;
    var timer = null;
    var current = 0;

    function goTo(i) {
        current = i;
        Array.prototype.forEach.call(cards, function (c, k) {
            if (k === i) { c.classList.add('dbs-hrev-on'); }
            else { c.classList.remove('dbs-hrev-on'); }
        });
        Array.prototype.forEach.call(dots, function (d, k) {
            if (k === i) { d.classList.add('dbs-hrev-dot-on'); }
            else { d.classList.remove('dbs-hrev-dot-on'); }
        });
    }

    function startAuto() {
        if (timer || cards.length < 2) { return; }
        timer = setInterval(function () {
            goTo((current + 1) % cards.length);
        }, 5000);
    }
    function stopAuto() {
        if (timer) { clearInterval(timer); timer = null; }
    }

    Array.prototype.forEach.call(dots, function (d) {
        d.addEventListener('click', function () {
            stopAuto(); /* the user took over - stop cycling */
            goTo(parseInt(d.getAttribute('data-slide'), 10) || 0);
        });
    });

    /* autoplay only runs on mobile; start/stop as the viewport
       crosses the breakpoint (rotation, window resize) */
    function syncAuto() {
        if (mq && mq.matches) { startAuto(); } else { stopAuto(); }
    }
    if (mq) {
        if (mq.addEventListener) { mq.addEventListener('change', syncAuto); }
        else if (mq.addListener) { mq.addListener(syncAuto); } /* older Safari */
    }
    syncAuto();
})();
