<script>
(function () {
  var STORAGE_KEY = 'dbs_donation_banner_dismissed_v' + 4;
  var DISMISS_DAYS = 7; // All three set in the SETTINGS block at the top of this file
  var DONATED_DAYS = 30;
  var banner = document.getElementById('dbs-donation-banner');
  var btn = document.getElementById('dbs-banner-dismiss');
  var donatedBtn = document.getElementById('dbs-banner-donated');

  // Show banner only if not dismissed, or if dismissal has expired
  try {
    // Tidy up: remove dismissal keys left over from older banner versions
    for (var i = localStorage.length - 1; i >= 0; i--) {
      var key = localStorage.key(i);
      if (key && key.indexOf('dbs_donation_banner_dismissed') === 0 && key !== STORAGE_KEY) {
        localStorage.removeItem(key);
      }
    }

    var raw = localStorage.getItem(STORAGE_KEY);
    var when = null;
    var days = DISMISS_DAYS;
    if (raw) {
      if (raw.charAt(0) === '{') {
        // New format: {"t": timestamp, "d": days}
        var obj = JSON.parse(raw);
        when = obj.t;
        days = obj.d || DISMISS_DAYS;
      } else {
        // Old format: plain timestamp (from before the donated option existed)
        when = parseInt(raw, 10);
      }
    }
    var expired = when && (Date.now() - when) > days * 24 * 60 * 60 * 1000;
    if (!when || expired) {
      banner.style.display = 'block';
    }
  } catch (e) {
    // localStorage unavailable - show banner anyway
    banner.style.display = 'block';
  }

  function saveDismissal(days) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ t: Date.now(), d: days }));
    } catch (e) {}
  }

  function dismissFor(days) {
    banner.style.display = 'none';
    saveDismissal(days);
  }

  btn.addEventListener('click', function (e) {
    e.preventDefault(); // stop the link firing when clicking dismiss
    e.stopPropagation();
    dismissFor(DISMISS_DAYS);
  });

  donatedBtn.addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation();
    saveDismissal(DONATED_DAYS); // save right away so it sticks even if they leave the page
    var thanks = document.getElementById('dbs-thankyou');
    thanks.style.display = 'block'; // covers just the banner area
    setTimeout(function () {
      banner.style.display = 'none'; // hide the whole banner after the message
      thanks.style.display = 'none';
    }, 2000); // thank you message shows for 2 seconds
  });
})();
</script>
