  .dbs-two-col          { grid-template-columns: 1fr; }
  .dbs-timing           { flex-direction: column; }
  .dbs-warmup-types     { grid-template-columns: 1fr; }
}

/* ≤460px */
@media (max-width: 460px) {
  .index_wrapper { width: 450px; margin: 0 auto; }
}


#dbs-donation-banner {
