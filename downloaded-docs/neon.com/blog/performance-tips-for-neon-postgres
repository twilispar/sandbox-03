"$\",\"h2\",null,{\"id\":\"compute-sizing-and-connections-management\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Compute sizing and connections management\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#compute-sizing-and-connections-management\",\"aria-label\":\"Link to Compute sizing and connections management\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Let’s start by quickly covering some Neon resource sizing essentials:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"If your application handles multiple connections, use \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/connect/connection-pooling\",\"children\":\"connection pooling\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"In Neon, the system allocates a certain amount of RAM per connection to ensure stable performance. A \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/connect/connection-pooling#default-connection-limits\",\"children\":\"general rule of thumb\"}],\" is that Neon allows approximately 100 connections per 1 GB of RAM. You can consider this ratio for planning the scale of your compute resources based on the expected number of concurrent connections.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"The best way to cover this is by taking advantage of Neon’s \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/introduction/autoscaling\",\"children\":\"autoscaling\"}],\" to dynamically adjust compute resources based on actual usage patterns. Autoscaling can help manage unexpected spikes in connections or workload, ensuring that your database remains responsive under varying conditions.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"While it might be tempting to minimize costs by keeping compute resources limited, under-provisioning can lead to performance issues, especially during peak loads. If you enable autoscaling, you don’t have to worry about this – we highly recommend it.\"}],\"\\n\",\"$L61\",\"\\n\",\"$L62\",\"\\n\",\"$L63\",\"\\n\",\"$L64\",\"\\n\",\"$L65\",\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\",\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\",\"\\n\",\"$L8f\",\"\\n\",\"$L90\",\"\\n\",\"$L91\",\"\\n\",\"$L92\",\"\\n\",\"$L93\",\"\\n\",\"$L94\",\"\\n\",\"$L95\",\"\\n\",\"$L96\",\"\\n\",\"$L97\",\"\\n\",\"$L98\",\"\\n\",\"$L99\",\"\\n\",\"$L9a\",\"\\n\",\"$L9b\",\"\\n\",\"$L9c\",\"\\n\",\"$L9d\",\"\\n\",\"$L9e\",\"\\n\",\"$L9f\"]\n"])</script><script>self.__next_f.push([1,"61:[\"$\",\"h2\",null,{\"id\":\"troubleshooting-postgres-query-performance\",\"className\":\"anchor-heading group relative w-