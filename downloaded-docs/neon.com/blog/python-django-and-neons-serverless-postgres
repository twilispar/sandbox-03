<span class="line" data-line="6"><span style="color:var(--shiki-token-function)">        &#x27;PASSWORD&#x27;</span><span style="color:var(--shiki-token-function)">:</span><span style="color:var(--shiki-token-string)"> getenv</span><span style="color:var(--shiki-foreground)">(</span><span style="color:var(--shiki-token-function)">&#x27;PGPASSWORD&#x27;</span><span style="color:var(--shiki-foreground)">)</span><span style="color:var(--shiki-token-string)">,</span></span>
