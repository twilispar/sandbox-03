<span class="line" data-line="3"><span style="color:var(--shiki-foreground)">    first_name </span><span style="color:var(--shiki-token-keyword)">text</span><span style="color:var(--shiki-foreground)">,</span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-foreground)">    last_name </span><span style="color:var(--shiki-token-keyword)">text</span><span style="color:var(--shiki-foreground)">,</span></span>
<span class="line" data-line="5"><span style="color:var(--shiki-foreground)">    hero_name </span><span style="color:var(--shiki-token-keyword)">text</span><span style="color:var(--shiki-token-keyword)"> UNIQUE</span></span>
<span class="line" data-line="6"><span style="color:var(--shiki-foreground)">);</span></span>
<span class="line" data-line="7"></span>
<span class="line" data-line="8"><span style="color:var(--shiki-token-comment)">-- Insert new hero or update existing one based on hero_name</span></span>
<span class="line" data-line="9"><span style="color:var(--shiki-token-keyword)">MERGE</span><span style="color:var(--shiki-token-keyword)"> INTO</span><span style="color:var(--shiki-foreground)"> hero h</span></span>
<span class="line" data-line="10"><span style="color:var(--shiki-token-keyword)">USING</span><span style="color:var(--shiki-foreground)"> (</span><span style="color:var(--shiki-token-keyword)">VALUES</span><span style="color:var(--shiki-foreground)"> (</span><span style="color:var(--shiki-token-string-expression)">&#x27;Wade&#x27;</span><span style="color:var(--shiki-foreground)">, </span><span style="color:var(--shiki-token-string-expression)">&#x27;Wilson&#x27;</span><span style="color:var(--shiki-foreground)">, </span><span style="color:var(--shiki-token-string-expression)">&#x27;Deadpool&#x27;</span><span style="color:var(--shiki-foreground)">)) v(first_name, last_name, hero_name)</span></span>
