dren\":[[\"$\",\"strong\",null,{\"children\":[\"We’ve teamed up with \",[\"$\",\"a\",null,{\"href\":\"https://www.paradedb.com/\",\"children\":\"ParadeDB\"}],\" to bring pg_search to all Neon users, making full-text search in Postgres faster and more powerful. Get Elastic-level speed within Neon—perfect for search-heavy apps, analytics, and filtering large datasets.\"]}],\" \",[\"$\",\"a\",null,{\"href\":\"https://console.neon.tech/signup\",\"children\":\"Try it on the Free Plan.\"}]]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"elasticsearch-powers-inside-postgres\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Elasticsearch Powers, Inside Postgres\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#elasticsearch-powers-inside-postgres\",\"aria-label\":\"Link to Elasticsearch Powers, Inside Postgres\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"pg_search is a high-performance full-text search extension for Postgres. It fills Postgres’ gaps in speed, ranking quality, and advanced search capabilities, bringing Elasticsearch-grade features inside Postgres (and now, to Neon).\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"So, what are those gaps?\"}],\" Postgres has native full-text search (FTS) via tsvector and tsquery, but this is not best-in-class—for example:\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Postgres’ GIN index on tsvector is not optimized for ranking, making queries slower when sorting by relevance.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"The built-in ranking method (ts_rank) is not as effective as modern search algorithms like BM25, which pg_search supports.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Native FTS requires exact matches (no fuzzy search). pg_search can handle approximate matches and typos.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Faceted search (the ability to quickly count occurrences of values within search results) is either missing or inefficient in native Postgres. This is a critical feature for real-world search applications and a major reason developers stick with Elasticsearch.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Other advanced features like prefix search, highlight snippets, and JSON-aware search are also limited or inefficient in native Postgres FTS.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"This all translates into better performance. In a later section of this post, we include a 10-million-row benchmark comparing pg_search to a tuned Postgres GIN-based setup. \",[\"$\",\"strong\",null,{\"children\":\"pg_search delivered consistently faster search queries: up to 1,000x faster.\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"$\",\"$L60\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/pgsearch-on-neon/ad4nxeygh85w1z-rukb8fdzcejlwxnseam-goiqymopwfupdgzxavuumwk3o0rjdsxrfbjrhtgqjjp8fjblztnuyg45lvyh4voqftn0rdnwo1pq2ckywmngospf-hsnmqcpoywuexu-a6c3bdc0.jpg\",\"isDark\":true,\"children\":\"$L61\"}]}],\"\\n\",\"$L62\",\"\\n\",\"$L63\",\"\\n\",\"$L64\",\"\\n\",\"$L65\",\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\",\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\",\"\\n\",\"$L8f\",\"\\n\",\"$L90\",\"\\n\",\"$L91\",\"\\n\",\"$L92\",\"\\n\",\"$L93\"]\n"])</script><script>self.__next_f.push([1,":HL[\"https://cdn.neonapi.io/public/images/pages/blog/pgsearch-on-neon/ad4nxeygh85w1z-rukb8fdzcejlwxnseam-goiqymopwfupdgzxavuumwk3o0rjdsxrfbjrhtgqjjp8fjblztnuyg45lvyh4voqftn0rdnwo1pq2ckywmngospf-hsnmqcpoywuexu-a6c3bdc0.jpg\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/pgsearch-on-neon/ad4nxedmd06rkjjgnummb8lk9wori5pw0pwwcv7o5g6h96yw5szy8pdx6vhozokbpxhuynmmwlhtas6vhai5uapgxgaoivqovidkn9p-nsky4-iaqmpqmy6o22wk2aytd2or77szek-be7d5966.png\",\"image\"]\n61:[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/pgsearch-on-neon/ad4nxeygh85w1z-rukb8fdzcejlwxnseam-goiqymopwfupdgzxavuumwk3o0rjdsxrfbjrhtgqjjp8fjblztnuyg45lvyh4voqftn0rdnwo1pq2ckywmngospf-hsnmqcpoywuexu-a6c3bdc0.jpg\",\"alt\":\"Image\"}]\n62:[\"$\",\"p\",null,{\"children\":\"Before we dig into the benchmark, let’s take a closer look at pg_search.\"}]\n63:[\"$\",\"h2\",null,{\"id\":\"pgsearch-capabilities\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"pg_search Capabilities\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#pgsearch-capabilities\",\"aria-label\":\"Link to pg_search Capabilities\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n64:[\"$\",\"h3\",null,{\"id\":\"100percent-postgres-written-in-rust\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"100% Postgres, written in Rust\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#100percent-postgres-written-in-rust\",\"aria-label\":\"Link to 100% Postgres, written in Rust\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n65:[\"$\",\"p\",null,{\"children\":\"pg_search is an extension written in Rust via the pgrx framework. There are no external dependencies or services required, everything operates within Postgres. You interact with it using standard SQL syntax, e.g. creating an index on text columns using the BM25 index method and querying with the @@@ operator for full-text search.\"}]\n66:[\"$\",\"h3\",null,{\"id\":\"advanced-relevance-ranking\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Advanced relevance ranking\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#advanced-relevance-ranking\",\"aria-label\":\"Link to Advanced relevance ranking\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n67:[\"$\",\"p\",null,{\"children\":\"pg_search brings true search-engine ranking into Postgres by implementing the BM25 algorithm, the same relevance scoring used by Elasticsearch. This allows search results to be ranked based on term frequency and rarity, producing higher-quality results than plain Postgres. Developers can also leverage prefix search, typo tolerance, and highlighted matches, or perform faceted searches (bucke"])</script><script>self.__next_f.push([1,"ting results by attributes like category, severity, or date).\"}]\n68:[\"$\",\"h3\",null,{\"id\":\"optimized-indexing-for-speed\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Optimized indexing for speed\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#optimized-indexing-for-speed\",\"aria-label\":\"Link to Optimized indexing for speed\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n69:[\"$\",\"p\",null,{\"children\":\"pg_search introduces a custom inverted index within Postgres (the BM25 index) to efficiently store tokens and document references. Powered by Tantivy, this index is significantly faster than the GIN tsvector approach, both in query execution and index creation.\"}]\n6a:[\"$\",\"p\",null,{\"children\":\"Beyond raw speed, pg_search’s BM25 index is a covering index, meaning a single index can efficiently span multiple columns. This allows boolean filters, faceted aggregations, and full-text search predicates to be pushed down into a single index scan, rather than applying filters and aggregates after retrieval (as is required with GIN indexes). In practice, this eliminates a major performance bottleneck (especially for queries with large result sets) by avoiding costly layered filtering and aggregation.\"}]\n6b:[\"$\",\"h3\",null,{\"id\":\"real-time-updates-without-etl\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Real-time updates without ETL\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#real-time-updates-without-etl\",\"aria-label\":\"Link to Real-time updates without ETL\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n6c:[\"$\",\"p\",null,{\"children\":\"This BM25 index is fully integrated with Postgres’ MVCC transaction system. It updates automatically as data is inserted, updated, or deleted. There’s no need for manual re-indexing, batch jobs, or external pipelines. New data is searchable immediately upon commit.\"}]\n6d:[\"$\",\"p\",null,{\"children\":\"This real-time indexing is critical for live applications, ensuring zero-lag between data writes and searchability. Additionally, pg_search is MVCC-safe, meaning\"}]\n6e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"It supports concurrent readers and writers\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Search results are consistent with their transaction’s visibility rules\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"The idea of “eventually consistent” has been replaced with “immediately consistent”\"}],\"\\n\"]}]\n6f:[\"$\",\"h2\",null,{\"id\":\"performance-benchmark-pgsearch-on-neon\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Performance Benchmark: pg_search on Neon\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#performance-benchmark-pgsearch-on-neon\",\"aria-label\":\"Link to Performance Benchmark: pg_search on Neon\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/20"])</script><script>self.__next_f.push([1,"00/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n70:[\"$\",\"p\",null,{\"children\":\"Now, to the benchmark. We compared query performance on a Neon database with and without pg_search, optimizing the standard Postgres setup by adding GIN indexes where appropriate.\"}]\n71:[\"$\",\"p\",null,{\"children\":[\"You can find the complete benchmarking suite here, in case you want to replicate the tests yourself: \",[\"$\",\"a\",null,{\"href\":\"https://github.com/paradedb/paradedb/tree/dev/benchmarks\",\"children\":\"https://github.com/paradedb/paradedb/tree/dev/benchmarks\"}]]}]\n72:[\"$\",\"h3\",null,{\"id\":\"benchmark-setup\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Benchmark setup\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#benchmark-setup\",\"aria-label\":\"Link to Benchmark setup\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:4:props:children:1:props:children:props:children\"}]}]]}]\n73:[\"$\",\"h4\",null,{\"children\":\"Dataset\"}]\n74:[\"$\",\"p\",null,{\"children\":\"10 million rows of log-like data.\"}]\n75:[\"$\",\"h4\",null,{\"children\":\"Schema\"}]\n77:[\"$\",\"h4\",null,{\"children\":\"Query types tested\"}]\n78:[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"The complete queries are included in the Appendix table at the end of this post.\"}]}]\n79:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"COUNT queries – Retrieve the count of rows (e.g., text-search matches).\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Highlighting queries – Extract relevant text snippets from fields (e.g., \",[\"$\",\"code\",null,{\"children\":\"message\"}],\" or \",[\"$\",\"code\",null,{\"children\":\"country\"}],\") that contain search terms.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Bucket or group-by queries – Group results by fields 