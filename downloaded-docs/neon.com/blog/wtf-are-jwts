<span class="line" data-line="3"><span style="color:var(--shiki-foreground)">    {</span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-token-string-expression)">      &quot;kid&quot;</span><span style="color:var(--shiki-token-keyword)">:</span><span style="color:var(--shiki-token-string-expression)"> &quot;key-identifier-2023&quot;</span><span style="color:var(--shiki-token-punctuation)">,</span><span style="color:var(--shiki-token-comment)">  // Key ID - matches the kid in JWT header</span></span>
