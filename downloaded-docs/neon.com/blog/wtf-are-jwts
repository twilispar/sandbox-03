<span class="line" data-line="9"><span style="color:var(--shiki-token-string-expression)">      &quot;e&quot;</span><span style="color:var(--shiki-token-keyword)">:</span><span style="color:var(--shiki-token-string-expression)"> &quot;AQAB&quot;</span><span style="color:var(--shiki-token-comment)">                    // RSA public exponent</span></span>
