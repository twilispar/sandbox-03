-3\",\"children\":\"$58:10:props:children:1:props:children:props:children\"}]}]]}]\n77:[\"$\",\"p\",null,{\"children\":\"The signature is what makes JWTs secure. It’s created by taking the encoded header, encoded payload, and a secret key, then running them through the algorithm specified in the header:\"}]\n79:[\"$\",\"p\",null,{\"children\":\"Let’s do that with the above header and payload. Here’s some quick code that will create a JWT with the above header, payload, and a secret:\"}]\n7b:[\"$\",\"p\",null,{\"children\":\"We get this:\"}]\n7d:[\"$\",\"p\",null,{\"children\":[\"We can head to \",[\"$\",\"a\",null,{\"href\":\"https://jwt.io/#debugger-io\",\"children\":\"jwt.io\"}],\" and input our JWT to decode the data:\"]}]\n7e:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/wtf-are-jwts/ad4nxcqdymntx8ekhac7skraibyy4tr41kh3rnljvtmbzbkn2nc7ft3iuu5jz9inptk44zrb0ndmkmu4qr6yqcnd9lqjzztejbq6drdtiiwbksslgadvzfks8oxb29s5whumznstg-ebfa648c.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/wtf-are-jwts/ad4nxcqdymntx8ekhac7skraibyy4tr41kh3rnljvtmbzbkn2nc7ft3iuu5jz9inptk44zrb0ndmkmu4qr6yqcnd9lqjzztejbq6drdtiiwbksslgadvzfks8oxb29s5whumznstg-ebfa648c.png\",\"alt\":\"Image\"}]}]}]\n7f:[\"$\",\"p\",null,{\"children\":\"Each part is visible, separated by dots. Each part is base64url-encoded, so it’s safe to use in URLs and easy to transmit.\"}]\n80:[\"$\",\"p\",null,{\"children\":\"For Neon RLS, we’re particularly interested in the payload claims. We’ll use these to make authorization decisions in our row-level security policies. For example, if your JWT includes a tenant_id, you can use that to ensure users only see data from their organization.\"}]\n81:[\"$\",\"h3\",null,{\"id\":\"wtf-are-jwks\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"WTF Are JWKS\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#w"])</script><script>self.__next_f.push([1,"tf-are-jwks\",\"aria-label\":\"Link to WTF Are JWKS\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$58:10:props:children:1:props:children:props:children\"}]}]]}]\n82:[\"$\",\"p\",null,{\"children\":\"You can see that the secret is an essential part of this. You must check their key to know whether the JWT can be trusted. How do you do that?\"}]\n83:[\"$\",\"p\",null,{\"children\":[\"JSON Web Key Sets, or JWKS (how are you pronouncing that?). These provide a standardized way to share the public keys verifying JWTs. While the example above used a simple secret string (“\",[\"$\",\"em\",null,{\"children\":\"neonauthorizeiscool\"}],\" “), key management becomes more complex in production environments with multiple services.\"]}]\n84:[\"$\",\"p\",null,{\"children\":\"Here’s how it typically works:\"}]\n85:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Your auth provider (like Clerk or Auth0) maintains a set of cryptographic key pairs\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"They sign JWTs using their private keys\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"They publish the corresponding public keys at a JWKS endpoint (usually /.well-known/jwks.json)\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Your application or service (like Neon) fetches these public keys to verify tokens\"}],\"\\n\"]}]\n86:[\"$\",\"p\",null,{\"children\":\"A JWKS endpoint returns JSON that looks something like this:\"}]\n88:[\"$\",\"p\",null,{\"children\":[[\"$\",\"br\",null,{}],\"When your application receives a JWT, it looks at the JWT header to find the kid (key ID), fetches the JWKS from your auth provider, finds the matching public key using the kid, and then uses that key to verify the JWT’s signature.\"]}]\n89:[\"$\",\"p\",null,{\"children\":\"This system allows for:\"}]\n8a:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Key rotation: Auth providers can add new keys and retire old ones smoothly\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Multiple keys: Different keys for different purposes or environments\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Trust verification: Everyone knows they’re using the correct keys\"}],\"\\n\"]}]\n8b:[\"$\",\"p\",null,{\"children\":[\"For Neon RLS, you don’t have to manage keys yourself. You just point Neon at your \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/guides/neon-authorize#supported-providers\",\"children\":\"auth provider’s JWKS endpoint\"}],\", which handles the verification automatically.\"]}]\n8c:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/wtf-are-jwts/screenshot-2024-11-29-at-83349percente2percent80percentafam-1024x908-66444d48.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/wtf-are-jwts/screenshot-2024-11-29-at-83349percente2percent80percentafam-1024x908-66444d48.png\",\"alt\":\"Image\"}]}]}]\n8d:[\"$\",\"p\",null,{\"children\":\"The JWT claims in your RLS policies are guaranteed to be legitimate because they’ve been verified using the correct public keys.\"}]\n8e:[\"$\",\"h2\",null,{\"id\":\"how-jwts-work-in-authorization\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"How JWTs Work in Authorization\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#how-jwts-work-in-authorization\",\"aria-label\":\"Link to How JWTs Work in Authorization\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$58:10:props:children:1:props:children:props:children\"}]}]]}]\n8f:[\"$\",\"p\",null,{\"children\":\"Let’s see how JWTs flow through an authentication and authorization process. Here’s what happens when using Neon RLS (or any JWT-based syste"])</script><script>self.__next_f.push([1,"m).\"}]\n90:[\"$\",\"p\",null,{\"children\":\"First, there is an authentication flow. A user logs in through your auth provider (Clerk, Auth0, etc.). This auth provider verifies credentials and generates a JWT, which is then returned to your application and stored.\"}]\n91:[\"$\",\"p\",null,{\"children\":\"Then, you use this JWT in an authorization flow. Your application makes a request to Neon with the JWT included in the Authorization header. Neon verifies the JWT using the JWKS endpoint, and the JWT claims become available for RLS policies.\"}]\n92:[\"$\",\"p\",null,{\"children\":\"Let’s say you’re building a multi-tenant application where users should only see their organization’s data.\"}]\n93:[\"$\",\"p\",null,{\"children\":\"When a request comes in:\"}]\n94:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Neon extracts the tenant_id from the JWT claims\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"The RLS policy checks if this matches the row’s tenant_id\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Users only see data from their organization\"}],\"\\n\"]}]\n95:[\"$\",\"p\",null,{\"children\":\"The beauty of this system is that authorization is enforced at the database level, and there is no need to maintain separate permission tables. Claims can’t be tampered with (thanks to JWT signatures), policies can be as simple or complex as needed, and you can implement a zero-trust model with every request verified.\"}]\n96:[\"$\",\"p\",null,{\"children\":\"Remember: your JWTs should contain all the claims needed for authorization decisions, but nothing more. Think of it as a security badge–include the permissions and identifiers required to do the job, but don’t overload it with unnecessary information.\"}]\n97:[\"$\",\"h3\",null,{\"id\":\"signing-vs-encrypting\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Signing vs. Encrypting\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#signing-vs-encrypting\",\"aria-label\":\"Link to Signing vs. Encrypting\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$58:10:props:children:1:props:children:props:children\"}]}]]}]\n98:[\"$\",\"p\",null,{\"children\":[\"While JWTs are signed, they’re not encrypted by default. It’s important to understand the distinction. \",[\"$\",\"strong\",null,{\"children\":\"Signing\"}],\" is about authenticity, proving the token hasn’t been tampered with and comes from a trusted source.\",[\"$\",\"strong\",null,{\"children\":\"Encryption\"}],\", on the other hand, is about privacy–it makes the content unreadable to anyone without the decryption key.\"]}]\n99:[\"$\",\"p\",null,{\"children\":\"By default, JWTs use signing only. This means:\"}]\n9a:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"✅ You can verify the token hasn’t been modified\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"✅ You can trust the claims inside the token\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"✅ You can validate the token without a database lookup\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"❌ The contents are not private or secret\"}],\"\\n\"]}]\n9b:[\"$\",\"p\",null,{\"children\":\"You have a few options if you need to send sensitive information. If you want to use regular JWTs, you can store only non-sensitive identifiers in the JWT, then keep sensitive data in your database and use the JWT claims to look it up. Alternatively, you can use encrypted JWTs.\"}]\n9c:[\"$\",\"h2\",null,{\"id\":\"jwt-ftw\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"JWT FTW\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:"])</script><script>self.__next_f.push([1,"opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#jwt-ftw\",\"aria-label\":\"Link to JWT FTW\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$58:10:props:children:1:props:children:props:children\"}]}]]}]\n9d:[\"$\",\"p\",null,{\"children\":\"JWTs have revolutionized how we handle authentication and authorization in modern web applications. They’re elegant in their simplicity: three base64-encoded segments that solve complex distributed authentication challenges. For Neon RLS users, JWTs are the bridge between your auth provider and your database’s row-level security policies, ensuring users can only access the data they’re supposed to see.\"}]\n9e:[\"$\",\"p\",null,{\"children\":\"Remember the key points:\"}]\n9f:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"JWTs are self-contained tokens that carry user information and permissions\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"They’re signed (but not encrypted) by default\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Your auth provider handles the complex stuff\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Neon uses JWT claims to enforce row-level security\"}],\"\\n\"]}]\na0:[\"$\",\"p\",null,{\"children\":[\"Want to learn more? Check out our posts about using \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/guides/neon-authorize\",\"children\":\"Neon RLS\"}],\" and our \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/guides/neon-authorize-tutorial\",\"children\":\"guides\"}],\" for using Neon RLS with your auth provider.\"]}]\na1:[\"$\",\"hr\",null,{}]\na2:[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":[\"Neon is a serverless Postgres platform that helps you ships faster with instant provisioning, autoscaling, and database branching. We have a Free Plan – sign up \",[\"$\",\"a\",null,{\"href\":\"https://console.neon.tech/signup\",\"children\":\"here\"}],\" (no credit card required).\"]}]}]\n"])</script><script>self.__next_f.push([1,"3b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1, viewport-fit=cover\"}]]\n"])</script><script>self.__next_f.push([1,"a3:I[806283,[\"/_next/static/chunks/0-0o8zjuqab7b.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0-wyrs755k4-p.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0i.l9589uvx0j.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/07n~9r3bo6_t_.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/05jguszscqe2t.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\