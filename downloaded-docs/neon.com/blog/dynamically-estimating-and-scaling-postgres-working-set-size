sjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0t1wtc-7-~e~c.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/07kiqkba00.os.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0ni~d5qt~j59u.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0g_miwgby_mg4.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\"],\"default\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-2-1024x576-fc58a6e2.jpg\",\"image\"]\n"])</script><script>self.__next_f.push([1,"57:[[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-2-1024x576-fc58a6e2.jpg\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-2-1024x576-fc58a6e2.jpg\",\"alt\":\"Image\"}]}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://neon.tech/blog/neon-autoscaling-is-generally-available\",\"children\":\"With the announcement that Neon’s autoscaling feature is GA\"}],\", we wanted to take the opportunity to dive into the implementation of a recent improvement we made: Scaling to match your workload’s working set size. This can provide \",[\"$\",\"em\",null,{\"children\":\"extraordinary\"}],\" speed-ups for real-world workloads, but it’s a complex problem with no single “right” answer.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"In this post, we’ll look at the technical details of how we estimate the working set size and automatically scale your Postgres instance to keep the working set in memory – without breaking the bank.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":\"Neon separates storage and compute to provide autoscaling, branching, point-in-time restore, and more. In this post, we’re only referring to scaling\"}],\" \",[\"$\",\"strong\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"compute\"}]}],[\"$\",\"em\",null,{\"children\":[\". For more on Neon’s architecture, check out \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/blog/architecture-decisions-in-neon\",\"children\":\"this pos\"}]]}],\" \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/blog/architecture-decisions-in-neon\",\"children\":\"t\"}],[\"$\",\"em\",null,{\"children\":\".\"}]]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"working-set-size-why-is-it-so-important\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Working set size: Why is it so important?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#working-set-size-why-is-it-so-important\",\"aria-label\":\"Link to Working set size: Why is it so important?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The “working set” of a database workload is the set of pages that will be accessed over the course of the workload – both the data and the indexes used to find it.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"(In case you’re curious, this is a concept that also applies to workloads outside of databases – check out \",[\"$\",\"a\",null,{\"href\":\"https://www.brendangregg.com/wss.html\",\"children\":\"this great post\"}],\" about the memory used by applications, for example).\",[\"$\",\"br\",null,{}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Workloads often suffer severe performance costs when the working set doesn’t fit in memory, and Neon’s architecture makes this even more critical, because the cost of a cache miss is a network request, rather than just reading from local disk.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"In our own testing, we found that fitting the working set in memory offers up to an 8x improvement in throughput, particularly for read-heavy workloads. Moreover, because of the latency of cache misses when storage is over the network, keeping the working set in memory also provides much more predictable performance.\"}],\"\\n\",\"$L62\",\"\\n\",\"$L63\",\"\\n\",\"$L64\",\"\\n\",\"$L65\",\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\",\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\",\"\\n\",\"$L8f\",\"\\n\",\"$L90\",\"\\n\",\"$L91\",\"\\n\",\"$L92\",\"\\n\",\"$L93\",\"\\n\",\"$L94\",\"\\n\",\"$L95\",\"\\n\",\"$L96\",\"\\n\",\"$L97\",\"\\n\",\"$L98\",\"\\n\",\"$L99\",\"\\n\",\"$L9a\",\"\\n\",\"$L9b\",\"\\n\",\"$L9c\",\"\\n\",\"$L9d\",\"\\n\",\"$L9e\",\"\\n\",\"$L9f\",\"\\n\",\"$La0\",\"\\n\",\"$La1\",\"\\n\",\"$La2\"]\n"])</script><script>self.__next_f.push([1,":HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-3-1024x423-63e613af.jpg\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-2-1-1024x423-ced22c4e.jpg\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-3-1-1024x543-a48a11c2.jpg\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-4-1-1024x519-20772013.jpg\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-5-1-1024x519-0329341a.jpg\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-6-1024x521-181c94ef.jpg\",\"image\"]\n62:[\"$\",\"p\",null,{\"children\":\"So sizing your instance to fit the working set in memory is critically important – but determining the right size is often difficult! And for workloads that vary over time, manually scaling either results in performance degradations under load or overspending at off-peak times.\"}]\n63:[\"$\",\"p\",null,{\"children\":\"But people already rely on autoscaling for this with CPU and memory load – so, why not scale based on the working set size as well?\"}]\n64:[\"$\",\"h2\",null,{\"id\":\"estimating-working-set-size-part-1-hyperloglog\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Estimating working set size, part 1: HyperLogLog\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#estimating-working-set-size-part-1-hyperloglog\",\"aria-label\":\"Link to Estimating working set size, part 1: HyperLogLog\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n65:[\"$\",\"p\",null,{\"children\":\"In order to automatically scale to fit the working set in memory, we first need to find some way to estimate it.\"}]\n66:[\"$\",\"p\",null,{\"children\":\"Nowadays, the typical way one measures the approximate size of a set is with HyperLogLog (HLL) – a probabilistic algorithm to estimate the cardinality of a set to a high degree of accuracy with comparatively little memory.\"}]\n67:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-3-1024x423-63e613af.jpg\",\"alt\":\"Image\"}],[\"$\",\"figcaption\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":\"Example of updating the HyperLogLog registers after hashing an element.\"}],[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}]]}]]}]\n68:[\"$\",\"p\",null,{\"children\":\"As a brief refresher in case you’re not intimately familiar:\"}]\n69:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"HyperLogLog estimates cardinality based on the number of leading zeros in the hashes of the elements\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Every time you add an element:\",\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Find the register index given by the first \",[\"$\",\"code\",null,{\"children\":\"log2(num registers)\"}],\" bits of the hash\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Update the register by identifying the first non-zero bit in the remaining bits of the hash, and setting it in the register – e.g., with simple maximum, bitwise OR, or directly setting just that single bit.\"}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"To calculate the cardina"])</script><script>self.__next_f.push([1,"lity, use the harmonic mean of the number of leading zeros in the binary representation of each register – and adjust by a constant based on the number of registers.\"}],\"\\n\"]}]\n6a:[\"$\",\"p\",null,{\"children\":\"(Caveat: There are many equivalent representations – we’re presenting it in this way because it more closely matches how we modify HLL in the next section.)\"}]\n6b:[\"$\",\"p\",null,{\"children\":[\"HyperLogLog is great for estimating the cardinality of sets with unknown size, but there’s no way to handle incremental changes in cardinality from \",[\"$\",\"em\",null,{\"children\":\"removing\"}],\" elements – continually storing the maximum in each register means the information from any individual item has already been removed.\"]}]\n6c:[\"$\",\"p\",null,{\"children\":[\"We did originally experiment with a typical HLL implementation by instrumenting page access in our custom resizable cache (\",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/blog/scaling-serverless-postgres#local-file-cache\",\"children\":\"LFC\"}],\") to count the number of distinct pages – but since it measured the number of distinct pages accessed since Postgres started, the calculated sizes were far greater than what users were \",[\"$\",\"em\",null,{\"children\":\"currently\"}],\" using.\"]}]\n6d:[\"$\",\"h2\",null,{\"id\":\"estimating-working-set-size-part-2-whats-the-true-size\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Estimating working set size, part 2: What’s the “true” size?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#estimating-working-set-size-part-2-whats-the-true-size\",\"aria-label\":\"Link to Estimating working set size, part 2: What’s the “true” size?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n6e:[\"$\",\"p\",null,{\"children\":\"So the actual working set size of your workload at a particular moment in time is somewhere between “nothing” and “everything since the start of time”. But the key question is how to find it?\"}]\n6f:[\"$\",\"p\",null,{\"children\":\"One approach might be to modify HyperLogLog for a sliding window – e.g., continuously measuring the number of unique pages accessed over the last 5 or 15 minutes. There’s a couple of papers outlining how to do this efficiently. But with that approach, there’s a critical question: How big a sliding window should we use?\"}]\n70:[\"$\",\"p\",null,{\"children\":[\"For steady workloads, as you increase the duration of the sliding window, the estimated size will \",[\"$\",\"em\",null,{\"children\":\"tend\"}],\" to plateau around the “true” working set size of the workload. So in those cases, we could just pick some large duration that’s “probably enough” – like 1 hour or so.\"]}]\n71:[\"$\",\"p\",null,{\"children\":[\"But with varying workloads, such a long duration will actually prevent us from scaling down in a timely fashion. There, we need to strike a careful balance: Scaling down to make sure your compute isn’t over-provisioned while making sure not to drop the cache when it’ll incur substantial performance penalties.\",[\"$\",\"br\",null,{}],\"From these, it was clear that \",[\"$\",\"em\",null,{\"children\":\"just one\"}],\" time window won’t do.\"]}]\n72:[\"$\",\"h3\",null,{\"id\":\"in-search-of-flexibility-time-bounded-hyperloglog\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"In search of flexibility: Time-bounded HyperLogLog\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opa"])</script><script>self.__next_f.push([1,"city-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#in-search-of-flexibility-time-bounded-hyperloglog\",\"aria-label\":\"Link to In search of flexibility: Time-bounded HyperLogLog\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n73:[\"$\",\"p\",null,{\"children\":\"At this point, we knew we’d want a selection of different sliding windows but without knowing those sizes in advance we had a dilemma: How to enable quick iteration and experimentation at a higher level (i.e., without having to frequently modify our extension in the early stages)?\"}]\n74:[\"$\",\"p\",null,{\"children\":[\"One assumption that helped was that we knew we only cared about the number of distinct pages accessed between a prior time and \",[\"$\",\"em\",null,{\"children\":\"now\"}],\" – rather than arbitrary windows in the past.\",[\"$\",\"br\",null,{}],\"So, a key insight: Just replace the bits in your typical HyperLogLog with timestamps! Then, when we look for the observed working set size since time \",[\"$\",\"em\",null,{\"children\":\"T\"}],\", we count the number of leading zero “bits” by looking for the first timestamp after \",[\"$\",\"em\",null,{\"children\":\"T\"}],\".\"]}]\n75:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-2-1-1024x423-ced22c4e.jpg\",\"alt\":\"Image\"}],[\"$\",\"figcaption\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":\"Example of updating registers based on timestamps. Instead of setting the bit in the register to “1”, we update the timestamp to the current time, for the first non-zero bit in the remainder of the hash.\"}],[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}]]}]]}]\n76:[\"$\",\"p\",null,{\"children\":\"Doing this gives us a way to estimate the number of distinct pages accessed since some arbitrary time in the past, which gave us much more data to use in experimentation – and as we’ll see below, plenty of data to use in the final algorithm as well.\"}]\n77:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Pro-tip:\"}],\" You can try this out yourself! We implemented this as the Postgres function \",[\"$\",\"code\",null,{\"children\":\"neon.approximate_working_set_size_seconds(d)\"}],\", which returns the HLL estimate of the working set size (i.e. number of distinct pages accessed) for the last d seconds. Check out \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/extensions/neon\",\"children\":\"our docs\"}],\" for more information on how to use the \",[\"$\",\"code\",null,{\"children\":\"neon\"}],\" extension.\"]}]\n78:[\"$\",\"h3\",null,{\"id\":\"keeping-it-simple-finding-a-heuristic\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Keeping it simple: Finding a heuristic\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#keeping-it-simple-finding-a-heuristic\",\"aria-label\":\"Link to Keeping it simple: Finding a heuristic\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n79:[\"$\",\"p\",null,{\"children\":[\"We now come to our second key insight: At any given moment, we can observe how the working set size changes as we increase the size of the window we use. Remember how stable workloads come to a plateau? In order to handle varying workloads, instead of looking for a plateau, we should actually look for the \",[\"$\",\"em\",null,{\"children\":\"end\"}],\" of a plateau – i.e. the point in the past where looking further back causes the observed working set size to \",[\""])</script><script>self.__next_f.push([1,"$\",\"em\",null,{\"children\":\"increase sharply\"}],\".\"]}]\n7a:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-3-1-1024x543-a48a11c2.jpg\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-3-1-1024x543-a48a11c2.jpg\",\"alt\":\"Image\"}]}]}]\n7b:[\"$\",\"p\",null,{\"children\":[\"This occurs, for example, when there was a heavy workload that recently ended – if the HLL window includes that previous workload, the size estimate will be much larger. So conversely, if \",[\"$\",\"em\",null,{\"children\":\"as you increase the window\"}],\", you’ll see a sudden jump once it extends far enough into the past to include the previous workload.\"]}]\n7c:[\"$\",\"p\",null,{\"children\":\"There’s still a couple key questions to answer, though. So far, to estimate the “true” working set size at any particular time, we should increase the HLL window duration until we see a sharp increase. What if we don’t find one?\"}]\n7d:[\"$\",\"p\",null,{\"children\":[\"To put a reasonable bound on our search, we can restrict it to just the most recent hour – if we get to the end and there’s no sudden increase, that’s fine! Just use the working set size given by the 1-hour window. This is typical for stable workloads \",[\"$\",\"em\",null,{\"children\":\"anyways\"}],\", and gives us that long time window we were originally looking for.\"]}]\n7e:[\"$\",\"p\",null,{\"children\":\"Then, we have a concern at the other end: How do we prevent thrashing on bursty workloads?\"}]\n7f:[\"$\",\"p\",null,{\"children\":\"Here, we can just start our search with some offset, and then increase the window size until we find a sharp increase in the working set size or get to the end of 1 hour. This means we’ll wait for that initial offset duration until we allow scaling down when the working set size dramatically decreases.\"}]\n80:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-4-1-1024x519-20772013.jpg\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-4-1-1024x519-20772013.jpg\",\"alt\":\"Image\"}]}]}]\n81:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-5-1-1024x519-0329341a.jpg\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-5-1-1024x519-0329341a.jpg\",\"alt\":\"Image\"}]}]}]\n82:[\"$\",\"p\",null,{\"children\":\"There’s no single “right” answer for how long to wait to downscale (doing it too quickly causes bursty workloads to remain slow; doing it too slow incurs extra compute costs) – we picked 5 minutes to match the default suspend timeout.\"}]\n83:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Putting it all together,\"}],\" we currently \",[\"$\",\"a\",null,{\"href\":\"https://github.com/neondatabase/neon/blob/06795c6b9a6b4664dadd4c75ccf9f75087b05614/vm-image-spec.yaml#L428-L440\",\"children\":\"export the HLL metrics\"}],\" from each compute using \",[\"$\",\"a\",null,{\"href\":\"https://github.com/burningalchemist/sql_exporter\",\"children\":\"sql_exporter\"}],\":\"]}]\n85:[\"$\",\"p\",null,{\"children\":[\"… and then consume these \",[\"$\",\"a\",null,{\"href\":\"https://github.com/neondatabase/autoscaling/blob/27e0c77d04d91a1ef381d67510ba20dd94375873/pkg/agent/core/wss.go#L51-L71\",\"children\":\"in our scaling algorithm\"}],\" as:\"]}]\n87:[\"$\",\"p\",null,{\"children\":\"All in all, this ends up pretty simple. However, as most simple heuristics do, it has some edge cases! We mitigated some of them with tuning, but scroll down to the Future improvements section for s"])</script><script>self.__next_f.push([1,"ome ideas we’re thinking of.\"}]\n88:[\"$\",\"h2\",null,{\"id\":\"scaling-to-fit\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Scaling to fit\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#scaling-to-fit\",\"aria-label\":\"Link to Scaling to fit\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n89:[\"$\",\"p\",null,{\"children\":[\"To close the loop and \",[\"$\",\"em\",null,{\"children\":\"autoscale\"}],\" based on the estimated working set size, there’s one last piece to consider.\",[\"$\",\"br\",null,{}],\"In short: We should scale based on the \",[\"$\",\"em\",null,{\"children\":\"projected\"}],\" size so that when a workload first starts, we only have to add the data to the cache once – otherwise, we risk reacting slowly and causing unnecessary cache evictions.\"]}]\n8a:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-6-1024x521-181c94ef.jpg\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/dynamically-estimating-and-scaling-postgres-working-set-size/neon-dynamically-estimate-6-1024x521-181c94ef.jpg\",\"alt\":\"Image\"}]}]}]\n8b:[\"$\",\"p\",null,{\"children\":\"The way we currently do this is by looking at the minute-to-minute increases in working set size as window duration increases and projecting upwards. Because we fetch the HLL values every 20 seconds, we only project a fraction of a minute – both to reduce overhead, and because projecting further can cause oscillation under bursty workloads. (The “why” on that is left as an exercise for the reader 😉)\"}]\n8c:[\"$\",\"h2\",null,{\"id\":\"results\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Results\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#results\",\"aria-label\":\"Link to Results\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n8d:[\"$\",\"p\",null,{\"children\":\"How well does it work? Well in short… it works pretty well!\"}]\n8e:[\"$\",\"p\",null,{\"children\":\"There were a few distinct cases we looked at.\"}]\n8f:[\"$\",\"p\",null,{\"children\":[\"First: in our internal benchmarking of a workload with a highly variable “target transaction rate”, we were able to \",[\"$\",\"em\",null,{\"children\":\"match the latency and throughput of a fixed-size compute while 30% cheaper\"}],\". Previously, autoscaling wasn’t able to keep up, because cache misses result in \",[\"$\",\"em\",null,{\"children\":\"reduced\"}],\" CPU usage because the compute’s waiting on network requests – so we never would have scaled up to fit the working set in cache.\"]}]\n90:[\"$\",\"p\",null,{\"children\":\"Elsewhere, in a sample “burst” workload (pgbench: cycle 1 minute on, 1 minute off), we found the scaling behavior changed from spiky allocations (1-3 CUs) well above the real CPU usage to a gradual increase over time, settling at a stable 3.5 CUs. We also saw a roughly 3x increase in throughput.\"}]\n91:[\"$\",\"p\",null,{\"children\":[\"And finally, we also tested a “batch” workload (pgbench: 1 hour heavy workload, 1 hour reduced workload). Here, \",[\"$\",\"em\",null,{\"chil"])</script><script>self.__next_f.push([1,"dren\":\"without\"}],\" the working set size-aware scaling, we saw the same spiky changes in allocated resources under the steady workload (between 2-4 CU) – and a cache hit rate of 30-70%. With the improved scaling, we saw it stabilize at 3.5 CUs and a cache hit rate of 100%.\"]}]\n92:[\"$\",\"p\",null,{\"children\":[\"In summary, we found that the improved autoscaling is more cost-efficient than fixed-size nodes with the same performance. This is a good thing, unless cache misses weren’t a concern for you under the previous algorithm \",[\"$\",\"em\",null,{\"children\":\"anyways\"}],\" — in those cases, you might see increased compute time. But overall, this change brings more efficient performance to the Neon fleet.\"]}]\n93:[\"$\",\"h2\",null,{\"id\":\"future-improvements\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Future improvements\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#future-improvements\",\"aria-label\":\"Link to Future improvements\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n94:[\"$\",\"p\",null,{\"children\":\"There’s a few different paths we’d like to explore!\"}]\n95:[\"$\",\"p\",null,{\"children\":\"Firstly, when the working set size is bigger than the configured maximum compute size, we may end up scaling up for little benefit. This is because performance can sometimes mimic a step function based on whether the working set fits into cache — scaling up without fitting the working set may just result in increased resource usage without increased performance. Unfortunately there is no singular “right” answer here – if we just ignored the working set size entirely, there’s still workloads with incremental benefits from increased caching that might be harmed.\"}]\n96:[\"$\",\"p\",null,{\"children\":[\"We’re also looking at expanding the data we provide into this algorithm — currently it’s only ever collected at a single moment in time, and this is honestly a pretty big restriction. It \",[\"$\",\"em\",null,{\"children\":\"does\"}],\" help with resilience and architectural simplicity (there’s no warm-up time after the decision-maker restarts, and no external metrics database required), but there’s also distinct cases that aren’t possible for us to disambiguate otherwise.\"]}]\n97:[\"$\",\"p\",null,{\"children\":[\"For example, if your workload routinely fetches its entire working set in under a minute, this can trick the predictive growth step into over-estimating the future working set size. From what we’ve seen in practice, this isn’t a very common issue, but it \",[\"$\",\"em\",null,{\"children\":\"is\"}],\" trivially possible to construct a workload that reproduces it.\"]}]\n98:[\"$\",\"p\",null,{\"children\":\"Lastly, we’re exploring ways to move away from uniform time windows. There’s a couple problems we see:\"}]\n99:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"A fixed set of time windows can produce transient oscillations as momentary spikes in load flip between the boundaries of the windows; and\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Fixed windows make it harder to be immediately responsive \",[\"$\",\"em\",null,{\"children\":\"and\"}],\" support longer time ranges – at some point, it’s just too much data to process.\"]}],\"\\n\"]}]\n9a:[\"$\",\"p\",null,{\"children\":\"Switching to an iterative algorithm (in the spirit of binary search) might particularly help with these — making it possible to consistently track the same timestamps of prior spikes with arbitrary precision on smaller time scales. But more to come on that at a later date!\"}]\n9b:[\"$\",\"h2\",null,{\"id\":\"conclusion\",\"className\":\"anchor-heading group relative w-fit scroll-mt-"])</script><script>self.__next_f.push([1,"20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Conclusion\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#conclusion\",\"aria-label\":\"Link to Conclusion\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n9c:[\"$\",\"p\",null,{\"children\":\"Take that, Aurora! (just kidding. maybe.)\"}]\n9d:[\"$\",\"p\",null,{\"children\":[\"In all seriousness though, we’re fans of Aurora’s tech here at Neon, and with the recent publication of \",[\"$\",\"a\",null,{\"href\":\"https://www.amazon.science/publications/resource-management-in-aurora-serverless\",\"children\":\"their paper on Aurora Serverless v2\"}],\", we’re wondering if AWS is doing something similar with working set estimation. From that paper:\"]}]\n9e:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":\"“[Aurora Serverless v2] introduces a metric in the engine to estimate the size of the working set in the buffer cache”\"}]}]\n9f:[\"$\",\"p\",null,{\"children\":\"Although they also state the following:\"}]\na0:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":\"“Aurora Serverless recommends setting the minimum [capacity] to a value that allows each DB writer or reader to hold the working set of the application in the buffer pool. That way, the contents of the buffer pool aren’t discarded during idle per