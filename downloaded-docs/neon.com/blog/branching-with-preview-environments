5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"A look at the GitHub actions\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-20"])</script><script>self.__next_f.push([1,"0 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#a-look-at-the-github-actions\",\"aria-label\":\"Link to A look at the GitHub actions\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n9f:[\"$\",\"p\",null,{\"children\":\"If you open the project in your text editor of choice, you will find that there are three files in the .github folder located at the root of your project:\"}]\na0:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"cleanup-preview.yml\"}],\": this workflow deletes Neon preview branches. It runs whenever a pull request is merged/closed\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"deploy-preview.yml\"}],\": this workflow creates and deploys to a preview environment. It runs whenever a pull request is opened.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"deploy-production.yml\"}],\": this workflow deploys the app to production. It runs whenever a commit is pushed to the main git branch.\"]}],\"\\n\"]}]\na1:[\"$\",\"p\",null,{\"children\":\"Before diving into the code for these workflows, you must add a few secrets to your GitHub project’s repository. To do that, navigate to your repository in GitHub, and go to  Settings \u003e Security \u003e Secrets and variables \u003e Actions. You will then need to add the following secrets:\"}]\n"])