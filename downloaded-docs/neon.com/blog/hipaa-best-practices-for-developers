<span class="line" data-line="3"><span style="color:var(--shiki-token-keyword)">SELECT</span><span style="color:var(--shiki-foreground)"> </span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-foreground)">  MD5(patient_id) </span><span style="color:var(--shiki-token-keyword)">as</span><span style="color:var(--shiki-foreground)"> patient_hash,</span></span>
