"color:var(--shiki-token-constant)"> 2024</span><span style="color:var(--shiki-token-keyword)">&lt;</span><span style="color:var(--shiki-token-string)">b</span><span style="color:var(--shiki-foreground)">r</span><span style="color:var(--shiki-token-keyword)">&gt;</span><span style="color:var(--shiki-token-keyword)">        |</span><span style="color:var(--shiki-token-function)">--</span><span style="color:var(--shiki-token-constant)"> 08</span><span style="color:var(--shiki-token-keyword)">&lt;</span><span style="color:var(--shiki-token-string)">b</span><span style="color:var(--shiki-foreground)">r</span><span style="color:var(--shiki-token-keyword)">&gt;</span><span style="color:var(--shiki-token-keyword)">            |</span><span style="color:var(--shiki-token-function)">--</span><span style="color:var(--shiki-token-string)"> 08-01-2024-add-flag-to-users.sql</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-[min(1rem,calc(50%-.8175rem))]" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
