lf.__next_f.push([1,"7f:[\"$\",\"h2\",null,{\"id\":\"strategy-3-checking-for-table-or-index-bloat\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Strategy 3: Checking for table or index bloat\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#strategy-3-checking-for-table-or-index-bloat\",\"aria-label\":\"Link to Strategy 3: Checking for table or index bloat\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:12:props:children:1:props:children:props:children\"}]}]]}]\n80:[\"$\",\"p\",null,{\"children\":[\"If there is some issue with Postgres \",[\"$\",\"a\",null,{\"href\":\"https://www.postgresql.org/docs/current/routine-vacuuming.html#AUTOVACUUM\",\"children\":\"autovacuum\"}],\", this can lead to table and index bloat.\"]}]\n81:[\"$\",\"p\",null,{\"children\":\"Bloat refers to the condition where tables and indexes occupy more space on disk than is necessary for storing the data. Bloat can occur over time due to the way Postgres handles updates and deletes.\"}]\n82:[\"$\",\"h3\",null,{\"id\":\"table-bloat\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Table Bloat\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#table-bloat\",\"aria-label\":\"Link to Table Bloat\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:12:props:children:1:props:children:props:children\"}]}]]}]\n83:[\"$\",\"p\",null,{\"children\":\"When a row is updated, the database doesn’t overwrite the existing row. Instead, it marks the old row version as obsolete and creates a new version of the row elsewhere in the table. Similarly, when a row is deleted, it is not immediately removed; it’s just marked as inaccessible. The space occupied by these obsolete or deleted rows contributes to table bloat.\"}]\n84:[\"$\",\"p\",null,{\"children\":\"This mechanism supports Postgres MVCC (Multi-Version Concurrency Control), allowing for more efficient query processing without locking rows for reading. However, the downside is that it can lead to wasted space and decreased performance over time as the table grows larger than necessary.\"}]\n85:[\"$\",\"h3\",null,{\"id\":\"index-bloat\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Index Bloat\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#index-bloat\",\"aria-label\":\"Link to Index Bloat\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:12:props:children:1:props:children:props:children\"}]}]]}]\n86:[\"$\",\"p\",null,{\"children\":\"Indexes can also experience bloat. As rows are updated and deleted, 