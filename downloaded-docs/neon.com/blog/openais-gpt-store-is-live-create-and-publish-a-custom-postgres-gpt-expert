"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://help.openai.com/en/articles/8554397-creating-a-gpt%20or%20https://help.openai.com/en/articles/8554407-gpts-faq\",\"children\":\"OpenAI’s GPT\"}],\" allows developers to create custom ChatGPT experiences to perform specific tasks or answer questions about a given topic.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"This article walks you through the steps to create your own custom GPT using Python and Postgres.\"}],\"\\n\",[\"$\",\"img\",null,{\"src\":\"https://lh7-us.googleusercontent.com/uHow3piGmKgfzRcYv3cVQVLCPve30iqOe_a05orYfKN3Qc9Szec5B3DTTZzXrZ6iTj8mM5YKLnOITrlYKuvHuNKaRGwjnh-8SsvJt_M9vmtmI8MB85A0kSJUNafifqWHgeZ5u3yKTA-XFwUpUo8y0ME\",\"alt\":\"Post image\",\"width\":\"975\",\"height\":\"512\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"what-are-gpts\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What are GPTs?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#what-are-gpts\",\"aria-label\":\"Link to What are GPTs?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Generative Pre-trained Transformers, commonly referred to as GPTs, are a group of machine learning models that provide human-like text interfaces that can answer questions in a conversational manner. OpenAI’s GPT allows developers to create custom ChatGPTs that are experts in specific domains and enable additional capabilities like web browsing and DALL·E image generation.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"OpenAI has also introduced the \",[\"$\",\"a\",null,{\"href\":\"https://openai.com/blog/introducing-the-gpt-store\",\"children\":\"GPT Store\"}],\", a marketplace where users can explore and access various GPTs. Creators can feature their GPTs in this store and potentially earn money based on their usage by the community.\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"how-to-create-a-gpt\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"How to create a GPT\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#how-to-create-a-gpt\",\"aria-label\":\"Link to How to create a GPT\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:10:props:children:1:props:children:props:children\"}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Developers with a Plus or Enterprise subscription can create GPTs by interacting with the GPT Builder in ChatGPT, where they can add instructions, upload files for the knowledge base, and select capabilities such as web searching, image creation, or data analysis.\"}],\"\\n\",\"$L5f\",\"\\n\",\"$L60\",\"\\n\",\"$L61\",\"\\n\",\"$L62\",\"\\n\",\"$L63\",\"\\n\",\"$L64\",\"\\n\",\"$L65\",\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\"]\n"])</script><script>self.__next_f.push([1,":HL[\"https://lh7-us.googleusercontent.com/h617F7tKjQV8PagxFKasifao0K1TopWKGrUTEFbRF0qelha5_jjPHJSuK6_R_11Zx6bYRhcXqgy-jI9fe5zpnNCRVG5g1ja9j4KOmesXBR9XYfiqYMZCkXoN8n7lbMFhXMWb5jhMoAeDp497_xZzfok\",\"image\"]\n:HL[\"https://lh7-us.googleusercontent.com/mPawlaCgix2-QGV6v7-ebIuFaZgVtx4pCxKaFdQDPggOIVsMvs8U2raSRexcKm1OyXxjQ7MjoG_VnqkMJUKSyrnYPNEDmAkI6BdvYjyta0zdO_z5v5nWLFkAKAT6dusC9aElKcUV458tMXsgcRNIsr4\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/openais-gpt-store-is-live-create-and-publish-a-custom-postgres-gpt-expert/image-9-a65dcc08.png\",\"image\"]\n5f:[\"$\",\"p\",null,{\"children\":\"Here’s how to create a GPT:\"}]\n60:[\"$\",\"p\",null,{\"children\":[\"Head to \",[\"$\",\"a\",null,{\"href\":\"https://chat.openai.com/gpts/editor\",\"children\":[[\"$\",\"span\",null,{\"children\":\"https://\"}],[\"$\",\"span\",null,{\"children\":\"chat.openai.com/gpts/editor\"}]]}],\" (or select your name and then “My GPTs”)\",[\"$\",\"img\",null,{\"src\":\"https://lh7-us.googleusercontent.com/h617F7tKjQV8PagxFKasifao0K1TopWKGrUTEFbRF0qelha5_jjPHJSuK6_R_11Zx6bYRhcXqgy-jI9fe5zpnNCRVG5g1ja9j4KOmesXBR9XYfiqYMZCkXoN8n7lbMFhXMWb5jhMoAeDp497_xZzfok\",\"alt\":\"Post image\",\"width\":\"624\",\"height\":\"435\"}],\"In the “Configure” tab, enter the name, description and instructions.\",[\"$\",\"br\",null,{}],[\"$\",\"img\",null,{\"src\":\"https://lh7-us.googleusercontent.com/mPawlaCgix2-QGV6v7-ebIuFaZgVtx4pCxKaFdQDPggOIVsMvs8U2raSRexcKm1OyXxjQ7MjoG_VnqkMJUKSyrnYPNEDmAkI6BdvYjyta0zdO_z5v5nWLFkAKAT6dusC9aElKcUV458tMXsgcRNIsr4\",\"alt\":\"Post image\",\"width\":\"406\",\"height\":\"606\"}],[\"$\",\"br\",null,{}]]}]\n61:[\"$\",\"p\",null,{\"children\":\"Example of instructions we used for the Neon PostgreSQL Expert GPT: “Your role is to act as a PostgreSQL expert, specifically tailored for Neon’s database as a service. You will provide detailed, accurate information and guidance on PostgreSQL, focusing on its use within the Neon platform. This includes offering advice on best practices, troubleshooting, performance optimization, and the nuances of working with Neon’s database service. You should be thorough in your explanations, ensuring clarity and precision in your responses. In cases where exact details are required and not provided, you should ask for clarification to provide the most accurate and helpful advice possible. Your responses should reflect a deep understanding of PostgreSQL and its application in a cloud-based environment like Neon.”\"}]\n62:[\"$\",\"p\",null,{\"children\":\"When you’re ready to publish your GPT, select “Publish” and share it with others if you’d like.\"}]\n63:[\"$\",\"p\",null,{\"children\":[\"You can find the instructions in the \",[\"$\",\"a\",null,{\"href\":\"https://github.com/neondatabase/neon-postgresql-expert\",\"children\":\"OpenAI Chatgpt Neon PostgreSQL Expert\"}],\" repo on GitHub.\"]}]\n64:[\"$\",\"h2\",null,{\"id\":\"enhance-your-gpt-with-retrieval-augmented-generation\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Enhance your GPT with Retrieval Augmented Generation\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#enhance-your-gpt-with-retrieval-augmented-generation\",\"aria-label\":\"Link to Enhance your GPT with Retrieval Augmented Generation\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:10:props:children:1:props:children:props:children\"}]}]]}]\n65:[\"$\",\"p\",null,{\"children\":[\"You can provide additional knowledge to your GPT by uploading text documents and a process named \",[\"$\",\"a\",null,{\"href\":\"https://python.langchain.com/docs/use_cases/question_answering/\",\"children\":\"Retrieval-Augmented Generation\"}],\" (RAG).\"]}]\n66:[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/openais-gpt-store-is-live-create-and-publish-a-custom-postgres-"])</script><script>self.__next_f.push([1,"gpt-expert/image-9-a65dcc08.png\",\"alt\":\"Post image\",\"width\":\"479\",\"height\":\"208\"}]\n67:[\"$\",\"p\",null,{\"children\":\"RAG is a framework that enhances the capabilities of large language models (LLMs) like GPT by allowing them to access facts from an external knowledge base. This helps overcome some of the limitations with LLMs, like accessing up-to-date and private information, or reducing hallucinations.\"}]\n68:[\"$\",\"p\",null,{\"children\":[\"The advantage of GPTs is that you don’t need to fully understand RAG to expand your chatbot with additional knowledge. But if you’re interested in understanding what happens under the hood, typically, documents are uploaded, then the text is split into pieces and chunks, added to a vector database, and used for RAG. Each user’s request will trigger a semantic search in the database to find the knowledge related to the user’s question. To understand more about how semantic search works, check out the \",[\"$\",\"a\",null,{\"href\":\"https://github.com/neondatabase/yc-idea-matcher\",\"children\":\"YC Matcher code on GitHub\"}],\".\"]}]\n69:[\"$\",\"h2\",null,{\"id\":\"rag-limitations-with-gpts\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"RAG limitations with GPTs\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#rag-limitations-with-gpts\",\"aria-label\":\"Link to RAG limitations with GPTs\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:10:props:children:1:props:children:props:children\"}]}]]}]\n6a:[\"$\",\"p\",null,{\"children\":\"Custom knowledge in GPTs is limited to 20 documents. Additionally, The text document formats that are currently supported to create GPTs are limited. For our example, we executed a script to crawl Neon’s documentation and generate markdown files.\"}]\n6c:[\"$\",\"p\",null,{\"children\":\"The above limitations make it difficult for applications with extensive knowledge bases and gigabytes of private data to be converted to GPTs. Another concern is related to data security. OpenAI operates as a black box, which makes it challenging to know what’s going on internally and how your data is accessed. This can be a blocker for users with sensitive data.\"}]\n6d:[\"$\",\"p\",null,{\"children\":[\"An alternative would be to create your own RAG app that uses open-source tools and models such as \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/blog/mixtral-8x7b-what-you-need-to-know-about-mistral-ais-latest-model\",\"children\":\"Mixtral 8x7B\"}],\" and \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/extensions/pgvector\",\"children\":\"pgvector\"}],\". Learn more about \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/ai/ai-concepts\",\"children\":\"AI concepts\"}],\" and \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/blog/building-an-ai-powered-chatbot-using-vercel-openai-and-postgres\",\"children\":\"how to use create a chatbot using pgvector and Next.js\"}],\".\"]}]\n6e:[\"$\",\"h2\",null,{\"id\":\"publishing-to-the-gpt-store\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Publishing to the GPT Store\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#publishing-to-the-gpt-store\",\"aria-label\":\"Link to Publishing to the GPT Store\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:10:props:children:1:props:children:props:children\"}]}]]}]\n6f:[\"$\",\"p\",null,{"])</script><script>self.__next_f.push([1,"\"children\":\"One exciting aspect of building a GPT is that users can be paid based on engagement. To monetize your GPT, make sure to save it for Everyone and that you have a verified Builder Profile.\"}]\n70:[\"$\",\"p\",null,{\"children\":\"That’s it!\"}]\n71:[\"$\",\"h2\",null,{\"id\":\"conclusion\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Conclusion\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#conclusion\",\"aria-label\":\"Link to Conclusion\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-gree