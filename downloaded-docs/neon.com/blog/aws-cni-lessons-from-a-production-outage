eonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdqzaru4tn9p327yrzhnhixwpia8erresdvmixvh6mjimggbaxufh8p3ilepcteigj0aql4yuhvf5bzu0n04gwqfuqugrmcwnuznrysmmemu-aixbqipo6gyfpsq1gg6nz762q-4cb88c32.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxchxzeycqqjnshtpy6p0ohxffjajplesxgiofhlnwiagdyox8f6frngm-5nul5xjswbvwjxt05yzlopjnvegkb6xadgxcmhd4p-hohp38te62rp1pp6ujvxfuvbipv-phxabf-96638155.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxeseajhnylpn2lqmo0ur3rbflhlizqotdc6ujvi7jn5vqdkky-ciaz5oqlt3jvcrm8lomgvyfftfkxho-pcbp6bs6zdi0g-aqswbq6ktfvzdcjwrxw55c6n5mgij-ewnncbgg-b8e1c626.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxcy4anh3xrndfndjlyf7hvcpmeedzk4ncdnazuztgtdrz8expod3au61-fhknqj53fxtvjhglhieegjnj1b68sr9bsmgt9rxj2vfndkjvummreklqdx59uhjncgevqxbklbapg-80a74bd5.png\",\"image\"]\n61:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"ipamd\"}],\": part of AWS CNI, refers to the L-IPAM \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go\",\"children\":\"daemon\"}]]}]\n62:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"AWS ENI\"}],\": AWS Elastic Network Interface; ENIs are allocated to EC2 instances and are associated with a subnet\"]}]\n63:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"AWS VPC\"}],\": logically isolated \",[\"$\",\"a\",null,{\"href\":\"https://docs.aws.amazon.com/vpc/latest/userguide/what-is-amazon-vpc.html\",\"children\":\"virtual network\"}],\" provided by AWS\"]}]\n64:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"AWS VPC subnet (or \",[\"$\",\"em\",null,{\"children\":\"subnet\"}],\")\"]}],\": represents a range of IP addresses in a VPC\"]}]\n65:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Allocated IPs\"}],\": AWS subnet IPs allocated to ENIs\"]}]\n66:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Assigned IPs\"}],\": IP addresses assigned to Kubernetes Pods (most Pods in our clusters are Neon Computes)\"]}]\n67:[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Total IPs\"}],\": total IP addresses available for allocation in a subnet (or subnets)\"]}]\n68:[\"$\",\"h2\",null,{\"id\":\"2025-05-16-running-out-of-ip-addresses\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"2025-05-16: Running out of IP addresses\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#2025-05-16-running-out-of-ip-addresses\",\"aria-label\":\"Link to 2025-05-16: Running out of IP addresses\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n69:[\"$\",\"p\",null,{\"children\":[\"Neon operates Kubernetes clusters in 11 cloud regions. Our \",[\"$\",\"em\",null,{\"children\":\"us-east-1\"}],"])</script><script>self.__next_f.push([1,"\" cluster in AWS typically operates a daily peak of 6,000 running databases (which we call Computes), with an incoming rate of 500 new Pods started every minute and a similar rate of terminating idle databases.\"]}]\n6a:[\"$\",\"p\",null,{\"children\":[\"When the incident started, the job responsible for shutting down idle databases failed (we have described this in more detail in a separate \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/delayed-start-compute-operations-triggering-event\",\"children\":\"post\"}],\"). As terminations were not processed, but creations continued, the number of running Computes quickly rose past our cluster’s typical operating conditions, reaching ~8k active Computes in the space of a few minutes.\"]}]\n6b:[\"$\",\"p\",null,{\"children\":\"At ~8k active computes, our AWS VPC subnets ran out of IPv4 addresses. This was unexpected, as we test our clusters for up to 10k Computes, and our subnets were sized to a total of 12k IP addresses!\"}]\n6c:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxckdcmuel8sipntjphfv8kyflswpz1nv0xufnyewbs3vgrwxrp3w-r1krk4cv-atdhlpxosudl3lcwv3lxogswgm5fhbaq3kghwncse-oawl8-7twbk1eufxhzhe47geb7yrg-c3a9c973.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxckdcmuel8sipntjphfv8kyflswpz1nv0xufnyewbs3vgrwxrp3w-r1krk4cv-atdhlpxosudl3lcwv3lxogswgm5fhbaq3kghwncse-oawl8-7twbk1eufxhzhe47geb7yrg-c3a9c973.png\",\"alt\":\"\"}]}]}]\n6d:[\"$\",\"h3\",null,{\"id\":\"a-summary-of-the-conditions-that-led-to-ip-allocation-unavailability\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"A summary of the conditions that led to IP allocation unavailability\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#a-summary-of-the-conditions-that-led-to-ip-allocation-unavailability\",\"aria-label\":\"Link to A summary of the conditions that led to IP allocation unavailability\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n6e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"With its default settings, AWS CNI reserves at least 1-2 \",[\"$\",\"em\",null,{\"children\":\"extra\"}],\" ENIs worth of IP addresses on each node\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Our nodes can utilize up to 49 IPv4 addresses per ENI\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Our AWS \",[\"$\",\"em\",null,{\"children\":\"us-east-1\"}],\" region only had 12k total IP addresses instead of the 24k we have in other regions.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"During the incident, we had ~4k extra IPs allocated on nodes that didn’t have enough CPU or memory available for new compute Pods to be scheduled.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"As a result, we became unable to start new computes while only 8k of 12k IPs were assigned to compute Pods — at the time, this was confusing and unexpected.\"}],\"\\n\"]}]\n6f:[\"$\",\"h3\",null,{\"id\":\"aside-why-only-12k-ip-addresses\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Aside: Why only 12k IP addresses?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#aside-why-only-12k-ip-addresses\",\"aria-label\":\"Link to Aside: Why only 12k IP addresses?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill"])</script><script>self.__next_f.push([1,"\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n70:[\"$\",\"p\",null,{\"children\":\"As one of our first regions, we hadn’t originally planned to run the cluster at this scale. Our load testing had indicated that our clusters could work with vertical scaling up to 10k Computes, but that after that, we would need to scale out horizontally.\"}]\n71:[\"$\",\"p\",null,{\"children\":\"Even though each of our three subnets was configured with a /20 CIDR block (half the size of our other clusters), we assumed we would always have sufficient available IPs due to the identified upper bound of 10k active Computes.\"}]\n72:[\"$\",\"p\",null,{\"children\":\"The rate of growth of our service in recent months has been faster than anticipated, so we’ve been working in parallel on deeper architectural changes to support horizontal scaling. We will post articles describing the new architecture after we launch it.\"}]\n73:[\"$\",\"h3\",null,{\"id\":\"background-what-is-aws-cni-how-does-it-work\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Background: What is AWS CNI? How does it work?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#background-what-is-aws-cni-how-does-it-work\",\"aria-label\":\"Link to Background: What is AWS CNI? How does it work?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n74:[\"$\",\"p\",null,{\"children\":\"Explaining the behaviour we saw, requires some understanding of how AWS CNI works.\"}]\n75:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfsm4sj69hmintf3oqdvghpxwmegnk4t1kq2jn3jo5v6wzvvutjwc9vteqfmnrdrgg4c-6o6qcmljoc4dwdp3b7kppyrh41kfgxld13be-hydanx7qwdeblz85kvpvyiaaba6ysvw-d3d14cdd.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfsm4sj69hmintf3oqdvghpxwmegnk4t1kq2jn3jo5v6wzvvutjwc9vteqfmnrdrgg4c-6o6qcmljoc4dwdp3b7kppyrh41kfgxld13be-hydanx7qwdeblz85kvpvyiaaba6ysvw-d3d14cdd.png\",\"alt\":\"\"}]}]}]\n76:[\"$\",\"p\",null,{\"children\":[\"The Kubernetes \",[\"$\",\"a\",null,{\"href\":\"https://kubernetes.io/docs/concepts/extend-kubernetes/compute-storage-net/network-plugins/\",\"children\":\"Container Networking Interface\"}],\" (CNI) is the standard interface used for configuring Pod networking in Kubernetes. CNI \",[\"$\",\"em\",null,{\"children\":\"plugins\"}],\" are called by the container runtime to set up (“\",[\"$\",\"em\",null,{\"children\":\"add\"}],\"”) and tear down (“\",[\"$\",\"em\",null,{\"children\":\"del\"}],\"”) networking for each Pod. “AWS CNI” is how we refer to the \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/\",\"children\":\"AWS VPC CNI plugin\"}],\". At the time of this incident we were using AWS CNI v1.18.6.\"]}]\n77:[\"$\",\"p\",null,{\"children\":[\"Each Pod needs an IP address for networking within the cluster, and AWS CNI’s job is mostly assigning IP addresses to Pods, pulling from the appropriate VPC subnet. Internally, the CNI plugin itself makes RPC calls to \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" — the host daemon on each node, responsible for allocating IPs from the subnet onto the ENIs attached to the EC2 instance and handing those out to Pods.\"]}]\n78:[\"$\",\"p\",null,{\"children\":[\"To isolate Pod starts from AWS API calls (and vice versa), \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" keeps a pool of IP addresses – more than is strictly necessary for the number of Pods on the node. The pool is resized every few seconds by a \",[\"$\",\"a\",null,"])</script><script>self.__next_f.push([1,"{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L658-L665\",\"children\":\"separate reconcile loop\"}],\", outside the context of any individual CNI request.\"]}]\n79:[\"$\",\"p\",null,{\"children\":\"AWS CNI has several configuration options to influence how it manages its pool of IP addresses. We include details about our choice of options below.\"}]\n7a:[\"$\",\"h3\",null,{\"id\":\"a-quick-recap\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"A quick recap\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#a-quick-recap\",\"aria-label\":\"Link to A quick recap\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n7b:[\"$\",\"p\",null,{\"children\":[\"Our AWS \",[\"$\",\"em\",null,{\"children\":\"us-east-1\"}],\" cluster typically operates with 5-6k active Computes. We run our Compute Pods on \",[\"$\",\"a\",null,{\"href\":\"https://aws.amazon.com/ec2/instance-types/m6i/\",\"children\":\"m6id.metal\"}],\" AWS instances, with 49 IP addresses per ENI (plus one IP address assigned to the network interface itself). In theory, these instances can support up to \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/misc/eni-max-pods.txt#L499\",\"children\":\"737 pods each\"}],\" (or more, with \",[\"$\",\"a\",null,{\"href\":\"https://docs.aws.amazon.com/eks/latest/userguide/cni-increase-ip-addresses.html\",\"children\":\"prefix delegation\"}],\") — in practice, we tend to run 100-400 pods per node.\"]}]\n7c:[\"$\",\"p\",null,{\"children\":\"It’s worth mentioning that not all databases are equal — the number of running compute Pods on any Kubernetes node is dynamic and depends on the size of the scheduled workloads. For example, a 128 CPU node can run 128 pods with 1 CPU each, 4 pods with 32 CPUs each, or any combination in between.\"}]\n7d:[\"$\",\"p\",null,{\"children\":[\"During Friday’s incident, our Control Plane became \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/delayed-start-compute-operations-triggering-event\",\"children\":\"unable to terminate\"}],\" idle databases. This resulted in the number of active Compute Pods quickly rising from ~5k to ~8.1k. As new Pods exhausted all schedulable CPU and memory across the cluster, \",[\"$\",\"a\",null,{\"href\":\"https://github.com/neondatabase/autoscaling/tree/244f0f0725f1d523315bf04e2228600221dd9465/cluster-autoscaler\",\"children\":\"our cluster-autoscaler\"}],\" added more nodes.\"]}]\n7e:[\"$\",\"p\",null,{\"children\":\"At this point, we had old nodes without CPU or memory capacity, but with many additional allocated IPs that could never be assigned to Pods due to these scheduling constraints. This issue was not clear to us at the time.\"}]\n7f:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfsx9lu6vh8zwnzxpskcqtocx8prjnzpbqeivvxnd7jcq4p9nmbbfmtvpwqfnva3tqghydvpujhtf2fdsz6maxyjlak9elay1blxsyjdtsqztptiswoukus9fhgmr39m20cbw-6628a39d.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfsx9lu6vh8zwnzxpskcqtocx8prjnzpbqeivvxnd7jcq4p9nmbbfmtvpwqfnva3tqghydvpujhtf2fdsz6maxyjlak9elay1blxsyjdtsqztptiswoukus9fhgmr39m20cbw-6628a39d.png\",\"alt\":\"\"}]}]}]\n80:[\"$\",\"p\",null,{\"children\":\"As more nodes were added, we started observing IP allocation errors when new Pods were scheduled but were unable to start.\"}]\n81:[\"$\",\"h3\",null,{\"id\":\"why-did-we-run-out-of-ip-addresses\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Why did we run"])</script><script>self.__next_f.push([1," out of IP addresses?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#why-did-we-run-out-of-ip-addresses\",\"aria-label\":\"Link to Why did we run out of IP addresses?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n82:[\"$\",\"p\",null,{\"children\":[\"Prior to the incident on Friday, we were using the default AWS CNI configuration (\",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET=1\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" unset, more on these later).\"]}]\n83:[\"$\",\"p\",null,{\"children\":[\"Prior to the incident, each of the cluster’s 3 subnets had 3.7-3.9k \",[\"$\",\"strong\",null,{\"children\":\"allocated\"}],\" IP addresses (stored in \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\"’s IP pools), with only 1.6-2.3k IP addresses \",[\"$\",\"strong\",null,{\"children\":\"assigned\"}],\" to Pods (~50% utilization). Each of our three subnets were configured with a /20 CIDR block. This meant we had up to (4096 – 5) × 3 = 12273 \",[\"$\",\"strong\",null,{\"children\":\"total\"}],\" IP addresses (\",[\"$\",\"a\",null,{\"href\":\"https://docs.aws.amazon.com/vpc/latest/userguide/subnet-sizing.html#subnet-sizing-ipv4\",\"children\":\"5 IPs in each VPC subnet are reserved\"}],\").\"]}]\n84:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdfejjnhoazs9-mxzkuyxoicifaktwp6fhkmg4d730hktnblhemdvevlzwk4q2ipbjfmxkqkjvvuo7otcie1qckwwhptnviijy-x-y9pek1d2wzwhorpx9kj50u5mqr7aziuae3a-931c6c37.png\",\"alt\":\"\"}],[\"$\",\"figcaption\",null,{\"children\":\"(11:09 UTC on 2025-05-16)\"}]]}]\n85:[\"$\",\"p\",null,{\"children\":[\"During the incident, with the sudden increase in running Pods, the cluster had \",[\"$\",\"strong\",null,{\"children\":\"assigned\"}],\"~8.8k total IP addresses (71%). However, across our three subnets, \",[\"$\",\"em\",null,{\"children\":\"99% of all IPs\"}],\" were \",[\"$\",\"strong\",null,{\"children\":\"allocated\"}],\", totaling ~12,200 out of 12,273.\"]}]\n86:[\"$\",\"p\",null,{\"children\":\"Because only 8.8k IP addresses were assigned, we expected that the already allocated IP addresses would be assignable to Pods, but the result was different and unexpected: IPs allocated to old nodes were, in practice, unusable. These were allocated to nodes already at CPU/memory capacity and were also not being released by AWS CNI.\"}]\n87:[\"$\",\"p\",null,{\"children\":\"Because of this detail, it appeared that the subnets had sufficient unassigned IPs available to be used for new Pods.\"}]\n88:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxepnljur1xd9jb6-fb4ahmzsxccz4e6uscearww93jjogknohvlwttmguxu20ct1qpqnqoxtt-9cbptz1-yivuzvwqiodv7iamr8lqvkb8fbjtinqgvqo27d2ssghamna-p6oyq-57eaa914.png\",\"alt\":\"\"}],[\"$\",\"figcaption\",null,{\"children\":\"(15:00 UTC on 2025-05-16)\"}]]}]\n89:[\"$\",\"p\",null,{\"children\":\"In practice, as new nodes were added, they became unable to obtain sufficient IPs to match available CPU/memory capacity.\"}]\n8a:[\"$\",\"h3\",null,{\"id\":\"why-were-there-so-many-ips-allocated-to-nodes-with-no-spare-resources\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Why were there so many IPs allocated to nodes with no spare resources?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#why-were-there-so-many-ips-allocated-to-nodes-with-no-spare-resources\",\"aria-label\":\"Link to Why were there so many IPs allocated to nodes with no spare resource"])</script><script>self.__next_f.push([1,"s?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n8b:[\"$\",\"p\",null,{\"children\":[\"Overallocation of IPs has to do with AWS CNI’s behavior under the default settings, which has \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET=1\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET/MINIMUM_IP_TARGET\"}],\" unset:\"]}]\n8c:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Whenever \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" sees that the number of “available” IP addresses (allocated minus assigned) is \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L2179\",\"children\":\"less than WARM_ENI_TARGET × (IPs per ENI)\"}],\", it will attempt to allocate more.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Allocating more IPs – if none of the existing ENIs have room – will attempt to allocate an ENI’s worth of IP addresses [\",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L863-L865\",\"children\":\"1\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L2119-L2120\",\"children\":\"2\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L1831-L1832\",\"children\":\"3\"}],\"], specifically by the code block below:\"]}],\"\\n\"]}]\n8d:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdxkgeupdu3k1pfeuiksp7zl3dkxwc81-7ktlqlsqjgrvw9pswc4c-0ew9ompptly14bi7iiizbtbll4s28mjtl1bljl7yaj7cwc24phz2d4dvytzataxhkjjq0rylbkm-xihw-09783b91.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdxkgeupdu3k1pfeuiksp7zl3dkxwc81-7ktlqlsqjgrvw9pswc4c-0ew9ompptly14bi7iiizbtbll4s28mjtl1bljl7yaj7cwc24phz2d4dvytzataxhkjjq0rylbkm-xihw-09783b91.png\",\"alt\":\"\"}]}]}]\n8e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Releasing IPs is desired when the number of “available” IP addresses is \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L1276\",\"children\":\"more than (WARM_ENI_TARGET + 1) × (IPs per ENI)\"}],\" — e.g., if an ENI’s worth of IPs could be removed without falling below the target.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"However, releasing IPs can only happen \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/datastore/data_store.go#L918-L921\",\"children\":[\"when there’s an \",[\"$\",\"strong\",null,{\"children\":\"ENI with no assigned IPs\"}]]}],\", because this configuration limits removal to happen only at the ENI level.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Critically, IP assignment to Pods \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/datastore/data_store.go#L680\",\"children\":\"randomly picks among all ENIs\"}],\" (because ENIs are \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/datastore/data_store.go#L237-L238\",\"children\":\"stored in a hashmap\"}],\", and in Go, \",[\"$\",\"a\",null,{\"href\":\"https://github.com/golang/go/blob/go1.24.3/src/runtime/map_noswiss.go#L912\",\"children\":\"hashmap iteration order is random\"}],\"!)\"]}],\"\\n\"]}]\n8f:[\"$\",\"p\",null,{\"children\":[\"The target for available IPs means that \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" must allocate 50-100 IP addresses above what’s needed by Pods (50 IPs per ENI for the \",[\"$\",\"em\",null,{\"children\":\"m6id.metal\"}],\" instance type). Because we have a stable rate of incoming Pods in our cluster, the random distribution of Pods onto ENIs keeps all ENIs in use, once added \",[\"$\",\"em\",null,{\"children\":\"we never free IP addresses back to the subnet\"}],\".\"]}]\n90:[\"$\",\"p\",null,{\"children\":[\"We were surprised to find this, so \",[\"$\",\"a\",null,{\"href\":\"https://"])</script><script>self.__next_f.push([1,"github.com/aws/amazon-vpc-cni-k8s/pull/3300\",\"children\":\"we have opened a PR to AWS CNI to improve ipamd’s behavior\"}],\" under these circumstances.\"]}]\n91:[\"$\",\"p\",null,{\"children\":\"As an example of just how severe this can be, consider a node that very occasionally peaks up to 400 active Pods, but normally has enough large workloads that it only has the CPU / memory capacity to support 200 active Pods. We might see a sequence of events such as the following:\"}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"A burst of Pod starts causes the node to have 400 active pods, with no available IPs left\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" sees that the number of “available” IPs is \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L674-L679\",\"children\":\"low\"}],\", and \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L790\",\"children\":\"allocates more\"}],\" (with a new ENI) from the VPC subnet, aiming to always maintain at least 50 available (extra) IPs\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"As older Pods on the node are removed, their IP addresses are \",[\"$\",\"strong\",null,{\"children\":\"kept in cooldown for 30s\"}],\" before they can be reused – so IP addresses on the new ENIs must be used for new Pod starts during this period\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"After the load subsides, the random distribution of Pods onto ENIs results in a high probability of having at least one Pod per ENI, causing all 50 IPs per ENI to remain allocated to the node (remember: the \",[\"$\",\"strong\",null,{\"children\":\"entire\"}],\" ENI must be unused to remove any of the IPs.)\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"As a result: This node is left with 200 running pods but 450 allocated IPs!\"}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"93:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfm2cccvl5u1qwj8mqihxzaxxuhztxoxwogxriue4slsfcucwcu6uwa8y6vn-vkms5atfswxdidvzhfko-suaub9djicyv97ejyrqnmadqxojlobtsaawhy2z0c-bo4g8ra4xg-edb91527.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfm2cccvl5u1qwj8mqihxzaxxuhztxoxwogxriue4slsfcucwcu6uwa8y6vn-vkms5atfswxdidvzhfko-suaub9djicyv97ejyrqnmadqxojlobtsaawhy2z0c-bo4g8ra4xg-edb91527.png\",\"alt\":\"\"}]}]}]\n94:[\"$\",\"p\",null,{\"children\":\"This happened enough in practice that almost all the IP addresses in our VPC subnets were either assigned to Pods (~8.8k) or allocated to nodes with no remaining CPU/Memory capacity (~3.4k, including ENI device IPs). Once we ran out of IPs in the subnet, we were unable to start new compute Pods, which in turn meant that idle databases couldn’t be woken up.\"}]\n95:[\"$\",\"p\",null,{\"children\":\"That still leaves ~100 IP addresses in our subnets unaccounted for – we’re not certain why they weren’t allocated (and we are following up with AWS Support to understand why this was the case). However, an extra 100 IPs likely wouldn’t have helped much, since our cluster needed an additional ~3.4k IPs.\"}]\n96:[\"$\",\"h2\",null,{\"id\":\"2025-05-16-warmiptarget1-releasing-ips-ips-still-not-assignable\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"2025-05-16: WARM_IP_TARGET=1, Releasing IPs, IPs still not assignable\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#2025-05-16-warmiptarget1-releasing-ips-ips-still-not-assignable\",\"aria-label\":\"Link to 2025-05-16: WARM_IP_TARGET=1, Releasing IPs, IPs still not assignable\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n97:[\"$\",\"p\",null,{\"children\":[\"After our VPC subnets ran out of IP addresses, we looked to simultaneously unblock further compute Pod creation and fix our control plane’s \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/delayed-start-compute-operations-triggering-event\",\"children\":\"periodic job\"}],\" so that old computes \",[\"$\",\"em\",null,{\"children\":\"were\"}],\" terminated.\"]}]\n98:[\"$\",\"p\",null,{\"children\":[\"To unblock compute Pod creation, we set \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/?tab=readme-ov-file#warm_ip_target\",\"children\":\"WARM_IP_TARGET=1\"}],\". This had the immediate intended and expected effect – freeing allocated IP addresses from nodes that couldn’t use them, and allowing more Pods to start.\"]}]\n99:[\"$\",\"p\",null,{\"children\":[\"Once our control plane started successfully terminating idle Computes, we observed a significant drop in the rate of successful Pod starts. As we later found out, \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" unexpectedly \",[\"$\",\"em\",null,{\"children\":\"prevents\"}],\" new Pod starts for 30s after each Pod deletion.\"]}]\n9a:[\"$\",\"h3\",null,{\"id\":\"background-what-does-warmiptarget-do\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Background: What does WARM_IP_TARGET do?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#background-what-does-warmiptarget-do\",\"aria-label\":\"Link to Background: What does WARM_IP_TARGET do?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.or"])</script><script>self.__next_f.push([1,"g/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n9b:[\"$\",\"p\",null,{\"children\":[\"Above, we described how \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET=\u003cT\u003e\"}],\" works: \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" ensures that there are at least T \",[\"$\",\"em\",null,{\"children\":\"ENIs\"}],\" worth of extra IP addresses allocated to the node, only freeing them when an entire ENI is unused.\"]}]\n9c:[\"$\",\"p\",null,{\"children\":[\"In contrast, when \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=\u003cN\u003e\"}],\" is set, \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" attempts to maintain \",[\"$\",\"em\",null,{\"children\":\"exactly\"}],\" N extra IP addresses on the node. More IP addresses are allocated when fewer than N IPs are available Extra IP addresses are freed if there are more than N available.\"]}]\n9d:[\"$\",\"p\",null,{\"children\":[\"If both \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET\"}],\" are set, \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" takes precedence.\"]}]\n9e:[\"$\",\"h3\",null,{\"id\":\"why-set-warmiptarget1\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Why set WARM_IP_TARGET=1?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#why-set-warmiptarget1\",\"aria-label\":\"Link to Why set WARM_IP_TARGET=1?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\n9f:[\"$\",\"p\",null,{\"children\":\"During the incident, we observed that our VPC subnets were out of IP addresses with only 72% of those IPs actually assigned to Pods. We inferred that those unused IPs must have been allocated to nodes with no room to start new Pods and looked for a quick way to free them up.\"}]\na0:[\"$\",\"p\",null,{\"children\":[\"Setting \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" appeared to be the most straightforward option.\"]}]\na1:[\"$\",\"p\",null,{\"children\":[\"At the time, we were operating AWS CNI with the default configuration options. During the incident, we misread the documentation, mistakenly believing that the default value for \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" was 5 when unset, leading us to decide to “reduce” it to one.\"]}]\na2:[\"$\",\"p\",null,{\"children\":[\"However, when this parameter is unset, AWS CNI actually bases its logic on \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET\"}],\", which has substantially different behaviour from using \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\". Unbeknownst to us, this had much larger implications than just reducing the value, many of which we didn’t understand until much later.\"]}]\na3:[\"$\",\"h3\",null,{\"id\":\"what-happened-with-warmiptarget1\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What happened with WARM_IP_TARGET=1?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#what-happened-with-warmiptarget1\",\"aria-label\":\"Link to What happened with WARM_IP_TARGET=1?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\na4:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/p"])</script><script>self.__next_f.push([1,"ublic/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfmxovy3mcjxhcopp1jdqvzpo1vt725ukl3b9akwltsr-jvf6mpaplmdtgki1o33va4hhyiunfnbeze0omhb6hybt7qwp1wc8zcentcwg5vangavk8hjlg4qbppjiogkwo-5fh-8b0bffbe.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxfmxovy3mcjxhcopp1jdqvzpo1vt725ukl3b9akwltsr-jvf6mpaplmdtgki1o33va4hhyiunfnbeze0omhb6hybt7qwp1wc8zcentcwg5vangavk8hjlg4qbppjiogkwo-5fh-8b0bffbe.png\",\"alt\":\"\"}]}]}]\na5:[\"$\",\"p\",null,{\"children\":[\"The immediate effects \",[\"$\",\"em\",null,{\"children\":\"were\"}],\" as we expected: Thousands of IP addresses were returned to the VPC subnets from nodes that couldn’t use them, and subsequently allocated by nodes with CPU / memory capacity to start Pods. New Pods started on these nodes, and when we eventually hit ~10k concurrent Pods, our rate of starts slowed again due to limits we’d previously identified in load testing (e.g. kube_proxy sync latency).\"]}]\na6:[\"$\",\"p\",null,{\"children\":\"Soon after, we stabilized our Control Plane’s failing job and ~7k idle computes were terminated. However, the rate of successful Pod starts remained far below the pre-incident baseline.\"}]\na7:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxe0fgvzfgyr9k-mvgy7q0m75-n80wylnb8sjegwg0joj5rzsiz7jl8khwyxyuwdb40nfnc3cmjddkildvwlwkessoul-yjztny6khss-l2zf122ocoz2zdag8rlbmdkscpni4c2a-1c69e81c.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxe0fgvzfgyr9k-mvgy7q0m75-n80wylnb8sjegwg0joj5rzsiz7jl8khwyxyuwdb40nfnc3cmjddkildvwlwkessoul-yjztny6khss-l2zf122ocoz2zdag8rlbmdkscpni4c2a-1c69e81c.png\",\"alt\":\"\"}]}]}]\na8:[\"$\",\"p\",null,{\"children\":[\"Investigation at the time showed that most of our new Pods were failing to start due to IP assignment issues — even though VPC subnet metrics confirmed that there were thousands of \",[\"$\",\"strong\",null,{\"children\":\"unallocated\"}],\" IP addresses that should have been available.\"]}]\na9:[\"$\",\"p\",null,{\"children\":[\"At the time, we couldn’t figure out why IP allocation was failing. The AWS CNI documentation mentioned that \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/docs/eni-and-ip-target.md?plain=1#L48-L50\",\"children\":\"WARM_IP_TARGET can trigger rate-limiting on EC2 API requests\"}],\", however, this is not a problem we expected with only 1-2 Pod starts \",[\"$\",\"strong\",null,{\"children\":\"per node, per minute\"}],\". Shouldn’t \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" be able to request more than that?\"]}]\naa:[\"$\",\"p\",null,{\"children\":[\"We spent much of the time following this incident digging through \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/\",\"children\":\"AWS CNI’s source code\"}],\" to understand its behaviour, cross-referencing with metrics and logs we’d captured from the time of the incident.\"]}]\nab:[\"$\",\"h3\",null,{\"id\":\"why-did-warmiptarget1-prevent-pods-from-starting\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Why did WARM_IP_TARGET=1 prevent Pods from starting?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#why-did-warmiptarget1-prevent-pods-from-starting\",\"aria-label\":\"Link to Why did WARM_IP_TARGET=1 prevent Pods from starting?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\nac:[\"$\",\"p\",null,{\"children\":[\"Broadly, AWS CNI has two methods of operation, depending on whether WARM_IP_TARGET and/or MINIMUM"])</script><script>self.__next_f.push([1,"_IP_TARGET are specified (internally referred to as the \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L1685-L1688\",\"children\":\"“warm target” being “defined”\"}],\").\"]}]\nad:[\"$\",\"p\",null,{\"children\":[\"We described the default above – if there \",[\"$\",\"em\",null,{\"children\":\"isn’t\"}],\" a warm target, ipamd relies on \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET\"}],\"’s value to determine how many IPs to allocate. But with \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" set, ipamd has the following behavior:\"]}]\n"])</script><script>self.__next_f.push([1,"ae:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"When the number of unused IP addresses is \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L2165-L2168\",\"children\":\"less than the warm target\"}],\", more IPs are allocated from the VPC subnet until there are \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" available IPs [\",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L1829\",\"children\":\"1\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L921\",\"children\":\"2\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L930-L931\",\"children\":\"3\"}],\"] (automatically adding ENIs as needed).\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"If the number of unused IP addresses is \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L2189-L2192\",\"children\":\"more than the warm target\"}],\", unassigned IPs are returned to the VPC subnet (subject to \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/ipamd.go#L694-L699\",\"children\":\"rate limiting\"}],\").\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"As with other configurations, IP addresses go into “cooldown” for \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/datastore/data_store.go#L224-L230\",\"children\":\"30 seconds\"}],\" after being unassigned, during which they \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/datastore/data_store.go#L1321\",\"children\":\"cannot be reused\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Crucially, and perhaps unexpectedly, \",[\"$\",\"strong\",null,{\"children\":\"IP addresses in cooldown\"}],\" \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/pkg/ipamd/datastore/data_store.go#L787-L789\",\"children\":\"count towards the warm target\"}],\".\"]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"af:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxeyuswvd48341kg0eimyfrdz2jhxrxo7omsbjjaeacnjz9do26fgz4rtonmyk15nqemg97n7r4scq4dat8m-iqlh-m3cyksgag697ukapp4g0ffkjvcntwhdehoqbdjnczcdbm-66227fda.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxeyuswvd48341kg0eimyfrdz2jhxrxo7omsbjjaeacnjz9do26fgz4rtonmyk15nqemg97n7r4scq4dat8m-iqlh-m3cyksgag697ukapp4g0ffkjvcntwhdehoqbdjnczcdbm-66227fda.png\",\"alt\":\"\"}]}]}]\nb0:[\"$\",\"p\",null,{\"children\":[\"This combination of factors means that **setting \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" \",[\"$\",\"em\",null,{\"children\":\"can prevent all Pod starts on a node for 30 seconds after each Pod removal\"}],\" **, because \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" will ensure that there’s exactly one “available” IP address (even if that IP address can’t be assigned due to the 30-second cooldown period).\"]}]\nb1:[\"$\",\"p\",null,{\"children\":[\"That’s why we only saw this problem \",[\"$\",\"em\",null,{\"children\":\"after\"}],\" our control plane started terminating idle computes. When no Pods are removed, \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" can sustain a high rate of Pod starts, in spite of the small warm IP target. Deleting Pods, however, can simultaneously prevent assigning existing allocated IPs while \",[\"$\",\"em\",null,{\"children\":\"also\"}],\" preventing \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" from allocating more (because \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" is guaranteed to be satisfied while any IP address is in cooldown).\"]}]\nb2:[\"$\",\"p\",null,{\"children\":\"To make matters worse, our control plane retries compute creation if it doesn’t succeed within the timeout window (currently 2 minutes). Combined with our preexisting long Pod startup times, these retries exacerbated the problem as many of the successful Pod starts were deleted shortly before the rest of setup could continue – each time resetting the 30 second countdown to being able to start more Pods.\"}]\nb3:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdprcahf5w-t2kxprrpxlcy-ktvpeh5bstij3knzfwdqu1hyupbuxutdbd4vxvub-d1w8bixlcedjlsjh-gggeuefo1clb9xn9izlbvtre2gilv3afjzm29hxyh3vrvvboxyip-9790ca82.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdprcahf5w-t2kxprrpxlcy-ktvpeh5bstij3knzfwdqu1hyupbuxutdbd4vxvub-d1w8bixlcedjlsjh-gggeuefo1clb9xn9izlbvtre2gilv3afjzm29hxyh3vrvvboxyip-9790ca82.png\",\"alt\":\"\"}]}]}]\nb4:[\"$\",\"h3\",null,{\"id\":\"back-to-the-incident-what-did-we-do-at-the-time\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Back to the incident: What did we do at the time?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#back-to-the-incident-what-did-we-do-at-the-time\",\"aria-label\":\"Link to Back to the incident: What did we do at the time?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\nb5:[\"$\",\"p\",null,{\"children\":\"At the time, we didn’t understand why our rate of successful Pod starts was so low.\"}]\nb6:[\"$\",\"p\",null,{\"children\":[\"We thought that it was \",[\"$\",\"em\",null,{\"children\":\"theoretically\"}],\" possible that there were still unused IP addresses somewhere, or maybe \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" was misbehaving. So in a last-ditch effort to free up any other allocated IP addresses, we red"])</script><script>self.__next_f.push([1,"uced \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" even further, \",[\"$\",\"strong\",null,{\"children\":\"to zero\"}],\", also setting \",[\"$\",\"code\",null,{\"children\":\"MINIMUM_IP_TARGET=0\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET=0\"}],\". This helped!\"]}]\nb7:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxf236eosv-selgkriwz1ihjmbrs5dc943rq0asgh7ctr12imyuwuiet4-vs9mukqoq3li5b7rawv8nzfo80hxl3yuntezhmzjmj6rcdf6tdkniqt72c9pewoqjhljqhervx9-sg-23da9533.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxf236eosv-selgkriwz1ihjmbrs5dc943rq0asgh7ctr12imyuwuiet4-vs9mukqoq3li5b7rawv8nzfo80hxl3yuntezhmzjmj6rcdf6tdkniqt72c9pewoqjhljqhervx9-sg-23da9533.png\",\"alt\":\"\"}]}]}]\nb8:[\"$\",\"p\",null,{\"children\":[\"Unbeknownst to us at the time, setting \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET\"}],\" to zero is \",[\"$\",\"em\",null,{\"children\":\"equivalent to disabling it\"}],\", resulting in \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" using the \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET\"}],\" logic.\"]}]\nb9:[\"$\",\"p\",null,{\"children\":[\"There were \",[\"$\",\"strong\",null,{\"children\":\"two key side effects\"}],\" of this configuration:\"]}]\nba:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Similarly to before the incident, \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" effectively stopped returning IP addresses to the subnet\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"New IP allocations from the subnet attempted to reserve as many IPs as could fit on the ENI (instead of one IP at a time)\"}],\"\\n\"]}]\nbb:[\"$\",\"p\",null,{\"children\":\"Together, these resulted in enough IP addresses being allocated to the nodes, allowing the cluster to stabilize. The average number of allocated IP addresses on each node increased from ~75 per node to ~250, and our rate of successful Pod starts returned to normal.\"}]\nbc:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxei8hmsya4n-ciwutsggpzkyku7d04kfzkpxouyct5l15-r52-mnvme9rs1sn9wg4zpcbvtrfhroefwbtrh2p5aew-h3awbofeiochynmrqkdwyddo3ctbnnuyyvufaxlxrg1yq-cc755912.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxei8hmsya4n-ciwutsggpzkyku7d04kfzkpxouyct5l15-r52-mnvme9rs1sn9wg4zpcbvtrfhroefwbtrh2p5aew-h3awbofeiochynmrqkdwyddo3ctbnnuyyvufaxlxrg1yq-cc755912.png\",\"alt\":\"\"}]}]}]\nbd:[\"$\",\"p\",null,{\"children\":\"We continued to monitor the cluster over the weekend and observed a stable state until the following Monday.\"}]\nbe:[\"$\",\"h2\",null,{\"id\":\"2025-05-19-aws-cni-config-change-goes-wrong-reverting-doesnt-help\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"2025-05-19: AWS CNI config change goes wrong, reverting doesn’t help\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#2025-05-19-aws-cni-config-change-goes-wrong-reverting-doesnt-help\",\"aria-label\":\"Link to 2025-05-19: AWS CNI config change goes wrong, reverting doesn’t help\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\nbf:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"The following Monday\"}],\", as an incident follow-up, we decided to revert the final change to our AWS CNI configuration. We believed that the state of our \",[\"$\",\"em\",null,{\"children\":\"us-east-1\"}],\" cluster after Friday’s incident was not stable, and thought that switching back to \",[\"$\",\"code\",null,{\"childr"])</script><script>self.__next_f.push([1,"en\":\"WARM_IP_TARGET=1\"}],\" would help.\"]}]\nc0:[\"$\",\"p\",null,{\"children\":[\"At the time, we were concerned that AWS CNI’s behavior with \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\" was unspecified, and believed that \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" would be more stable.\"]}]\nc1:[\"$\",\"p\",null,{\"children\":[\"Rolling out \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" triggered the same behavior where deleting Pods interfered with our ability to start new ones. Upon observing the same conditions, we then undid that change back to \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\". However, IP assignment errors continued.\"]}]\nc2:[\"$\",\"p\",null,{\"children\":[\"We compensated for high error rates by increasing the size of our \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/cold-starts-just-got-hot\",\"children\":\"pre-created compute pools\"}],\". The IP assignment errors continued for hours afterwards, until a 86-second window where our control plane didn’t stop any Pods, allowing more IPs to be allocated and resolving the errors.\"]}]\nc3:[\"$\",\"h3\",null,{\"id\":\"why-set-warmiptarget1-again\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Why set WARM_IP_TARGET=1 again?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#why-set-warmiptarget1-again\",\"aria-label\":\"Link to Why set WARM_IP_TARGET=1 again?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\nc4:[\"$\",\"p\",null,{\"children\":\"As is often the case, we knew much less then than we do now.\"}]\nc5:[\"$\",\"p\",null,{\"children\":[\"We were becoming less certain about the behavior of \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\". \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/v1.18.6/README.md?plain=1#L301-L303\",\"children\":\"In one place\"}],\", the documentation said that zero was equivalent to “\",[\"$\",\"em\",null,{\"children\":\"not setting the variable\"}],\"”, but that the default was “\",[\"$\",\"em\",null,{\"children\":\"None\"}],\"”, leaving us uncertain about the actual behavior with that configuration. If zero were the default, that would have been the same configuration that originally caused us to run out of IP addresses.\"]}]\nc6:[\"$\",\"p\",null,{\"children\":[\"We also suspected that Friday’s IP assignment issues may have been resolved by coincidence and not by setting \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\". For example, we saw temporary improvements every time we restarted the \",[\"$\",\"code\",null,{\"children\":\"aws-node\"}],\" DaemonSet (which reinitializes \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\") — the symptoms could have been resolved by the final restart.\"]}]\nc7:[\"$\",\"p\",null,{\"children\":[\"Remembering that setting \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" had initially helped on Friday, we believed that it was likely to be more stable than the unknown situation we found ourselves in.\"]}]\nc8:[\"$\",\"p\",null,{\"children\":[\"This was a mistake at the time. Further, reverting back to \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\" was not sufficient to recover from the resulting degraded state.\"]}]\nc9:[\"$\",\"h3\",null,{\"id\":\"what-happened-with-warmiptarget1-this-time\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What happened with WARM_IP_TARGET=1 this time?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:h"])</script><script>self.__next_f.push([1,"idden\",\"href\":\"#what-happened-with-warmiptarget1-this-time\",\"aria-label\":\"Link to What happened with WARM_IP_TARGET=1 this time?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\nca:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdoxknbh7spojjuccfhbadtbv9nwznfxb7jzsrqifhnn4nv3fuqhgcqiqwy3vjpze8cyzsu8rwe2yi16quywvtfqvj1o2sdyuzlki3hyadndxe7hvpj3djsajyujpphxfiatg-3e5cb270.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdoxknbh7spojjuccfhbadtbv9nwznfxb7jzsrqifhnn4nv3fuqhgcqiqwy3vjpze8cyzsu8rwe2yi16quywvtfqvj1o2sdyuzlki3hyadndxe7hvpj3djsajyujpphxfiatg-3e5cb270.png\",\"alt\":\"\"}]}]}]\ncb:[\"$\",\"p\",null,{\"children\":[\"IP assignment immediately started failing, and with it, our rate of successful Pod starts dropped to the same level as it was with \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" on Friday.\"]}]\ncc:[\"$\",\"p\",null,{\"children\":\"This was unexpected. At the time, we thought Friday’s IP assignment errors were due to the cluster being left in a bad state after our VPC subnets ran out of IP addresses. Here, the errors started from a stable state — clearly inconsistent with our understanding.\"}]\ncd:[\"$\",\"p\",null,{\"children\":[\"Aiming to avoid further outages, we wanted to be sure of any additional configuration changes. We took some time to examine \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" logs and eventually determined that there were likely specific issues with \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\".\"]}]\nce:[\"$\",\"p\",null,{\"children\":[\"We reverted back to \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\", but continued to see IP assignment errors.\"]}]\ncf:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdycmgpejwlzxjbnfl7lucloaacuvb7gozbop3wkudndoq7ya7wwrxjsaomspvx20n41ymfx8cdsio9ybkwy-twptkk2n08kylqbmivvigyaudthpsp2srgad4dcxwnormtxuw-c27ccf49.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdycmgpejwlzxjbnfl7lucloaacuvb7gozbop3wkudndoq7ya7wwrxjsaomspvx20n41ymfx8cdsio9ybkwy-twptkk2n08kylqbmivvigyaudthpsp2srgad4dcxwnormtxuw-c27ccf49.png\",\"alt\":\"\"}]}]}]\nd0:[\"$\",\"h3\",null,{\"id\":\"why-didnt-reverting-fix-the-issue\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Why didn’t reverting fix the issue?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#why-didnt-reverting-fix-the-issue\",\"aria-label\":\"Link to Why didn’t reverting fix the issue?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\nd1:[\"$\",\"p\",null,{\"children\":\"It was very unexpected that issues persisted after reverting WARM_IP_TARGET back to 0. This was the healthy state through the weekend, so why didn’t it work now!?\"}]\nd2:[\"$\",\"p\",null,{\"children\":[\"The rate of errors \",[\"$\",\"em\",null,{\"children\":\"had\"}],\" decreased enough for more Pods to get through, but the overall success rate was far below expectations:\"]}]\nd3:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdqzaru4tn9p327yrzhnhixwpia8erresdvmixvh6mjimggbaxufh8p3ilepcteigj0aql4yuhvf5bzu0n04gwqfuqugr"])</script><script>self.__next_f.push([1,"mcwnuznrysmmemu-aixbqipo6gyfpsq1gg6nz762q-4cb88c32.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxdqzaru4tn9p327yrzhnhixwpia8erresdvmixvh6mjimggbaxufh8p3ilepcteigj0aql4yuhvf5bzu0n04gwqfuqugrmcwnuznrysmmemu-aixbqipo6gyfpsq1gg6nz762q-4cb88c32.png\",\"alt\":\"\"}]}]}]\nd4:[\"$\",\"p\",null,{\"children\":\"In our investigation over the following weeks, we attained a deeper understanding of the AWS CNI codebase.\"}]\nd5:[\"$\",\"p\",null,{\"children\":[\"When \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=0\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"MINIMUM_IP_TARGET=0\"}],\", AWS CNI uses the behavior for \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET\"}],\" — even though we had \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET=0\"}],\" as well.\"]}]\nd6:[\"$\",\"p\",null,{\"children\":[\"Under these conditions, ipamd will only allocate more IP addresses to the node \",[\"$\",\"a\",null,{\"href\":\"https://github.com/aws/amazon-vpc-cni-k8s/blob/0d02624a2d97e65ebde0977f608cb129184f9cb5/pkg/ipamd/ipamd.go#L2179\",\"children\":[\"if there are \",[\"$\",\"strong\",null,{\"children\":\"no available IP addresses\"}]]}],\". Together with our finding that IP addresses in cooldown are counted towards the number of available addresses.\"]}]\nd7:[\"$\",\"p\",null,{\"children\":\"This means that these settings only allow allocating more IP addresses if:\"}]\nd8:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"All of the IP addresses on the node are assigned to Pods; \",[\"$\",\"strong\",null,{\"children\":\"and\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"No Pods on the node were removed in the last 30 seconds\"}],\"\\n\"]}]\nd9:[\"$\",\"p\",null,{\"children\":[\"Setting \",[\"$\",\"code\",null,{\"children\":\"WARM_IP_TARGET=1\"}],\" released many of the IP addresses on our nodes. Setting it back to zero while we continued to have high Pod churn meant that \",[\"$\",\"em\",null,{\"children\":\"ipamd\"}],\" never saw the necessary conditions to reallocate those IP addresses. This only happened because we had also set \",[\"$\",\"code\",null,{\"children\":\"WARM_ENI_TARGET=0\"}],\".\"]}]\nda:[\"$\",\"h3\",null,{\"id\":\"what-did-we-do-to-work-around-errors-in-the-meantime\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What did we do to work around errors in the meantime?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#what-did-we-do-to-work-around-errors-in-the-meantime\",\"aria-label\":\"Link to What did we do to work around errors in the meantime?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:2:props:children:1:props:children:props:children\"}]}]]}]\ndb:[\"$\",\"p\",null,{\"children\":[\"Internally, our control plane maintains a pool of “warm” Compute pods, so that \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/cold-starts-just-got-hot\",\"children\":\"Pod starts are not on the hot path\"}],\" for waking an idle database.\"]}]\ndc:[\"$\",\"p\",null,{\"children\":\"We were only seeing ~10% of Pods failing to start, so we were able to compensate for failures by increasing the size of the pool.\"}]\ndd:[\"$\",\"p\",null,{\"children\":\"This mitigated the user impact as errors continued behind the scenes.\"}]\nde:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Le9\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxchxzeycqqjnshtpy6p0ohxffjajplesxgiofhlnwiagdyox8f6frngm-5nul5xjswbvwjxt05yzlopjnvegkb6xadgxcmhd4p-hohp38te62rp1pp6ujvxfuvbipv-phxabf-96638155.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/aws-cni-lessons-from-a-production-outage/ad4nxchxze