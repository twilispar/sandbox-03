_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0mbd~fobjqaya.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0t1wtc-7-~e~c.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/07kiqkba00.os.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0ni~d5qt~j59u.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0g_miwgby_mg4.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\"],\"default\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/neon-storage-performance-ab9fb3d5.jpg\",\"image\"]\n"])</script><script>self.__next_f.push([1,"57:[[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/neon-storage-performance-ab9fb3d5.jpg\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/neon-storage-performance-ab9fb3d5.jpg\",\"alt\":\"Post image\"}]}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Neon’s storage architecture is designed for scalability, but scalability alone doesn’t guarantee performance. Over the past several months, we’ve been focused on making the Neon storage system faster – cutting down ingest latency, reducing read amplification, making better use of disk and network bandwidth, and optimizing the path from write-ahead log to S3.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If you haven’t read our \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/get-page-at-lsn\",\"children\":\"deep dive on Neon’s storage layer\"}],\", it’s worth the background. In short – Neon splits storage across Safekeepers and Pageservers; Safekeepers receive WAL from Postgres; Pageservers turn that WAL into data, serve reads, and upload layers to S3. There are a lot of moving parts in our storage and plenty of opportunities to improve performance across them.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"In this post, we recap the storage-side improvements we’ve shipped during the past months. We’re still not done, but these changes lay the groundwork for even more performance gains.\"}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"sharded-pageserver-ingestion\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Sharded Pageserver Ingestion\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#sharded-pageserver-ingestion\",\"aria-label\":\"Link to Sharded Pageserver Ingestion\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#2D8665] dark:border-green-52 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#2D8665] dark:text-green-52\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"m12 2 2 2-6.4 6.4-2.8.8.8-2.8z\"}],[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M12.4 9.2v3.6a1.2 1.2 0 0 1-1.2 1.2h-8A1.2 1.2 0 0 1 2 12.8v-8a1.2 1.2 0 0 1 1.2-1.2h3.6\"}]]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"TL;DR\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[\"$L62\",\"$L63\"]}]]}],\"\\n\",\"$L64\",\"\\n\",\"$L65\",\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\",\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\",\"\\n\",\"$L8f\",\"\\n\",\"$L90\",\"\\n\",\"$L91\",\"\\n\",\"$L92\",\"\\n\",\"$L93\",\"\\n\",\"$L94\",\"\\n\",\"$L95\",\"\\n\",\"$L96\",\"\\n\",\"$L97\",\"\\n\",\"$L98\"]\n"])</script><script>self.__next_f.push([1,":HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-1-1024x535-2e66111a.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-2-1024x499-d0eab1e1.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-3-1024x499-0cc7cfd5.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-4-1024x499-909d7cd0.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-5-1024x583-e75440cc.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-7-1024x493-50819222.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-8-1024x497-96d310ce.png\",\"image\"]\n62:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Impact:\"}],\" ~2× faster ingest throughput for large, sharded tenants; up to 87.5% reduction in WAL decoding work across Pageservers.\"]}]\n63:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"How:\"}],\" WAL is now decoded once at the Safekeeper and routed only to the relevant shard instead of being broadcast to all.\"]}]\n64:[\"$\",\"p\",null,{\"children\":[\"Neon splits large tenants across multiple Pageservers to scale out storage and improve performance. This is what we call \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/how-we-scale-an-open-source-multi-tenant-storage-engine-for-postgres-written-rust\",\"children\":\"sharding\"}],\". But until recently, every WAL record from Postgres was sent to \",[\"$\",\"em\",null,{\"children\":\"all\"}],\" shards, even though each record typically only pertained to one. That meant every shard had to receive, decode, and discard irrelevant data, wasting both CPU and network bandwidth.\"]}]\n65:[\"$\",\"p\",null,{\"children\":\"We’ve now changed that. WAL records are decoded once on the central Safekeepers and routed only to the appropriate Pageserver shard. The impact is significant: we reduce unnecessary work by a factor of (N−1)/N for N shards. With 8 shards, that’s an 87.5% reduction in WAL decoding work across the Pageservers.\"}]\n66:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-1-1024x535-2e66111a.png\",\"alt\":\"Post image\"}],[\"$\",\"figcaption\",null,{\"children\":\"Chart showing the before and after number of WAL records ingested per second across all 8 shards for a single large tenant\"}]]}]\n67:[\"$\",\"p\",null,{\"children\":\"This doesn’t translate into an 8x speedup in ingestion (since the redundant work was done in parallel) but it does give shards more breathing room to keep up with compaction and other tasks. In practice, we’ve observed about a 2x improvement in ingest throughput for large tenants.\"}]\n68:[\"$\",\"p\",null,{\"children\":\"We also benchmarked a 200 GB COPY import workload. When sharded ingest was enabled in staging, cumulative import time dropped by ~50%. While that data is noisy and still being refined, it’s a clear signal that we’re headed in the right direction.\"}]\n69:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-2-1024x499-d0eab1e1.png\",\"alt\":\"Post image\"}],[\"$\",\"figcaption\",null,{\"children\":\"Chart showing the before and after cumulative COPY import time across multiple workers for 200 GB data\"}]]}]\n6a:[\"$\",\"h2\",null,{\"id\":\"compressed-wal-transmission\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Compressed WAL Transmission\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 "])</script><script>self.__next_f.push([1,"focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#compressed-wal-transmission\",\"aria-label\":\"Link to Compressed WAL Transmission\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"6b:[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#2D8665] dark:border-green-52 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#2D8665] dark:text-green-52\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[\"$57:10:props:children:0:props:children:0:props:children:0\",\"$57:10:props:children:0:props:children:0:props:children:1\"]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"TL;DR\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Impact:\"}],\" ~70% reduction in network bandwidth from Safekeepers to Pageservers; Improved throughput and latency for bulk writes (not individually quantified).\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"How:\"}],\" WAL records are now Protobuf-encoded and Zstd-compressed on Safekeepers before being sent to Pageservers\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"6c:[\"$\",\"p\",null,{\"children\":\"Previously, Neon’s Safekeepers sent WAL to Pageservers in an uncompressed format. The Pageservers would then decode, process, and store those records, a process that consumed significant network bandwidth.\"}]\n6d:[\"$\",\"p\",null,{\"children\":\"We have a new path now, where safekeepers pre-process WAL into the Pageserver’s on-disk format, then Protobuf-encode and compress the data using Zstd before transmission. This offloads work from the Pageserver and drastically cuts down the amount of data transferred over the network.\"}]\n6e:[\"$\",\"p\",null,{\"children\":\"In aggregate, this reduces WAL transmission bandwidth by around 70%. For example, during the rollout in eu-central-1 past January, we saw outbound Safekeeper traffic drop from ~250 MB/s to ~75 MB/s. That’s a clear and measurable bandwidth improvement.\"}]\n6f:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-3-1024x499-0cc7cfd5.png\",\"alt\":\"Post image\"}],[\"$\",\"figcaption\",null,{\"children\":\"Chart showing the reduction in total outbound Safekeeper network traffic during the deployment to eu-central-1 (Jan 2025)\"}]]}]\n70:[\"$\",\"p\",null,{\"children\":\"It’s worth noting that this change was deployed around the same time as sharded ingest, so the effects can be hard to separate at a macro level. But since most tenants are still unsharded, we can confidently attribute the majority of this bandwidth reduction to WAL compression.\"}]\n71:[\"$\",\"h2\",null,{\"id\":\"faster-safekeeper-disk-writes\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Faster Safekeeper Disk Writes\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#faster-safekeeper-disk-writes\",\"aria-label\":\"Link to Faster Safekeeper Disk Writes\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"72:[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#2D8665] dark:border-green-52 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#2D8665] dark:text-green-52\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[\"$57:10:props:children:0:props:children:0:props:children:0\",\"$57:10:props:children:0:props:children:0:props:children:1\"]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"TL;DR\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Impact:\"}],\" ~230% improvement in WAL write throughput on Safekeepers; ~50% reduction in disk bandwidth usage.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"How:\"}],\" WAL is now written to sparse files using ftruncate and avoids unnecessary fsync calls\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"73:[\"$\",\"p\",null,{\"children\":\"Safekeepers are responsible for writing incoming WAL to disk. With our previous design, this involved allocating and flushing data in ways that weren’t optimal for performance especially under high ingest workloads. We introduced several changes to improve this:\"}]\n74:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Sparse files via \",[\"$\",\"code\",null,{\"children\":\"ftruncate\"}]]}],\": Instead of writing full zeroed-out data segments, we allocate space more efficiently, allowing the file system to skip writing uninitialized data.\",[\"$\",\"br\",null,{}]]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"Avoiding disk flushes via \",[\"$\",\"code\",null,{\"children\":\"fsync\"}]]}],\": Where safe, we now delay or skip expensive flushes to disk, reducing I/O overhead.\"]}],\"\\n\"]}]\n75:[\"$\",\"p\",null,{\"children\":\"Together, these changes yielded a 230% speedup in WAL write throughput in benchmarks. In one case using 128 KB WAL chunks, throughput increased from ~215 MiB/s to over 705 MiB/s:\"}]\n77:[\"$\",\"p\",null,{\"children\":\"In terms of Safekeeper resource usage, we’ve seen an expected 50% reduction in disk bandwidth. Disk IOPS were also reduced, though we didn’t quantify that separately.\"}]\n78:[\"$\",\"p\",null,{\"children\":\"It’s important to note that Safekeepers typically aren’t the main bottleneck in Neon’s write path, but this change clears the way for more throughput and lower latency as other parts of the system improve.\"}]\n79:[\"$\",\"h2\",null,{\"id\":\"scan-prefetches\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Scan Prefetches\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#scan-prefetches\",\"aria-label\":\"Link to Scan Prefetches\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"7a:[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#2D8665] dark:border-green-52 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#2D8665] dark:text-green-52\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[\"$57:10:props:children:0:props:children:0:props:children:0\",\"$57:10:props:children:0:props:children:0:props:children:1\"]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"TL;DR\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Impact:\"}],\" Significantly reduced latency for sequential and index scans; ~4× faster schema finalization in benchmarks.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"How:\"}],\" Pageserver now prefetches up to 100 sequential pages in scans to avoid one-at-a-time roundtrips.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"7b:[\"$\",\"p\",null,{\"children\":\"When Postgres performs a sequential scan or an index scan, it often needs to read a large number of pages in order. If each page has to be fetched individually from the Pageserver over the network, this can become a major latency bottleneck.\"}]\n7c:[\"$\",\"p\",null,{\"children\":\"To address this, we added support for page prefetching from Pageservers. When a compute begins a scan, it proactively fetches the next 100 pages (or fewer, depending on access patterns) from the Pageserver before they’re explicitly requested. This reduces the per-page roundtrip costs and speeds up the overall scan.\"}]\n7d:[\"$\",\"p\",null,{\"children\":\"The performance gains are substantial. In a pgcopydb-based benchmark that imports data and builds constraints, enabling scan prefetches reduced schema finalization time (such as bulk foreign key creation) from 10 hours to 2.5 hours, a 300% speedup.\"}]\n7e:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-4-1024x499-909d7cd0.png\",\"alt\":\"Post image\"}],[\"$\",\"figcaption\",null,{\"children\":\"Chart showing the before and after of schema finalization time (pgcopydb benchmark)\"}]]}]\n7f:[\"$\",\"p\",null,{\"children\":\"This change improves latency for large reads and helps bring Neon’s read performance closer to what users expect from a local Postgres setup, even when data is remote.\"}]\n80:[\"$\",\"h2\",null,{\"id\":\"more-responsive-l0-compaction\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"More Responsive L0 Compaction\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#more-responsive-l0-compaction\",\"aria-label\":\"Link to More Responsive L0 Compaction\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"81:[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#2D8665] dark:border-green-52 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#2D8665] dark:text-green-52\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[\"$57:10:props:children:0:props:children:0:props:children:0\",\"$57:10:props:children:0:props:children:0:props:children:1\"]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"TL;DR\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Impact:\"}],\" \u003e50% reduction in p99 read amplification; significantly lower read latency during heavy ingestion.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"How:\"}],\" L0 compaction is now prioritized over background tasks; ingestion is throttled when needed to let compaction catch up.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"82:[\"$\",\"p\",null,{\"children\":\"Neon’s storage engine uses a variant of an LSM tree. Incoming writes are first stored in L0 files, which are then compacted into more efficient L1 files. This process is essential: every read must search through all L0 files plus any relevant L1 files, and as the number of L0 files increases, so does read amplification.\"}]\n83:[\"$\",\"p\",null,{\"children\":\"Previously, L0 compaction could be delayed by other background work, particularly L1 image compaction. This meant that under heavy ingestion, the system could accumulate hundreds of L0 files, severely impacting read latency. In some cases, the L0 layer count reached as high as 500, when the ideal range is fewer than 30.\"}]\n84:[\"$\",\"p\",null,{\"children\":\"We’ve changed our compaction policy to aggressively prioritize L0 work. L0 compaction now preempts background tasks like L1 compaction, and we apply backpressure to ingestion when the L0 count grows too fast. This ensures the Pageserver can keep up with compaction and avoids pathological read performance.\"}]\n85:[\"$\",\"p\",null,{\"children\":\"As a result, we’ve seen a dramatic drop in worst-case read amplification. The p99 read amplification metric has improved by over 50%, and maximum L0 layer counts have fallen from ~500 to under 30. This helps maintain low-latency reads even when tenants are ingesting large volumes of data.\"}]\n86:[\"$\",\"figure\",null,{\"children\":[[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/recent-storage-performance-improvements-at-neon/figure-5-1024x583-e75440cc.png\",\"alt\":\"Post image\"}],[\"$\",\"figcaption\",null,{\"children\":\"Chart showing the p99 read amplification before and after prioritizing L0 compaction\"}]]}]\n87:[\"$\",\"h2\",null,{\"id\":\"parallel-pipelined-s3-uploads\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Parallel, Pipelined S3 Uploads\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#parallel-pipelined-s3-uploads\",\"aria-label\":\"Link to Parallel, Pipelined S3 Uploads\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:8:props:children:1:props:children:props:children\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"88:[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#2D8665] dark:border-green-52 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#2D8665] dark:text-green-52\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[\"$57:10:props:children:0:props:children:0:props:children:0\",\"$57:10:props:children:0:props:children:0:props:children:1\"]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"TL;DR\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Impact:\"}],\" ~30 minutes shaved off ingest benchmarks; S3 upload throughput doubled from 60 to 120 uploads/minute.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"How:\"}],\" Pageservers now upload layers in parallel and pipeline uploads with new file creation.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"89:[\"$\",\"p\",null,{\"children\":\"When Pageservers write data, they produce layer files that are uploaded to S3. Previously, this process was strictly sequential – write a layer file, upload it to S3, then move on to the next one. That left disk bandwidth underutilized during uploads and limited total throughput.\"}]\n8a:[\"$\",\"p\",null,{\"children\":\"Pageservers can now pipeline this work: they begin uploading one layer file while continuing to write out the next. In addition, they’re allowed to upload multiple files in parallel where it’s safe to do so. This lets us better utilize both local disk and S3 network bandwidth.\"}]\n8b:[\"$\",\"p\",null,{\"children\":\"In our ingest benchmarks, we saw S3 upload throughput increase from 60 to 120 uploads per minute. More importantly, overall ingestion time dropped from 2 hours and 55 minutes to 2 hours and 24 minutes, a 30-minute reduction.\"}]\n8c:[\"$\",\"p\",null,{\"children\":\"These improvements are especially important for large tenants and high-ingest workloads, where upload lag can otherwise become the bot