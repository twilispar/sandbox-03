-974eb96c.png\",\"alt\":\"Image\"}]}]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#426CE0] dark:border-blue-70 [\u0026_pre]:px-4 [\u0026_pre]:py-3 [\u0026_pre_code]:text-sm! [\u0026_pre[data-language]]:bg-white! [\u0026_pre[data-language]]:dark:bg-gray-new-8!\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1 text-[#426CE0] dark:text-blue-70\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":16,\"height\":16,\"fill\":\"none\",\"viewBox\":\"0 0 16 16\",\"className\":\"shrink-0\",\"children\":[[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M7.997 13.778a5.778 5.778 0 1 0 0-11.555 5.778 5.778 0 0 0 0 11.555\"}],[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"d\":\"M8 7.477v3.151M8 5.258v-.016\"}]]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"info\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[\"$\",\"p\",null,{\"children\":[\"This blog post was originally published in \",[\"$\",\"a\",null,{\"href\":\"https://theburningmonk.com/2025/04/how-to-use-neon-and-ephemeral-environments-to-simplify-serverless-development/\",\"children\":\"TheBurningMonk.com\"}],\".\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"“Ephemeral environments” refers to the ability to create short-lived copies of your system so that:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Developers can work in their isolated environments and make changes without affecting others.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Test data does not pollute shared environments such as dev and staging.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Once a feature is complete, the ephemeral environment can be safely torn down.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"It’s a powerful practice and works great with services that charge on a pay-per-use basis. There is no extra charge for these environments – it’s only the activities that count.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"However, services that charge by uptime (aka “\",[\"$\",\"em\",null,{\"children\":\"serverful\"}],\"”), such as Amazon RDS, present a logistical problem – your uptime cost increases with the number of environments.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"To mitigate the extra uptime cost, you can \",[\"$\",\"a\",null,{\"href\":\"https://theburningmonk.com/2023/02/how-to-handle-serverful-resources-when-using-ephemeral-environments/\",\"children\":\"share the same RDS cluster across multiple environments\"}],\". But this adds friction to the development workflow and complicates deployment:\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"The RDS cluster must be deployed separately, so you can no longer review and update the whole system as a single unit.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"You need scripts to create and delete environment-specific databases or schemas.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Fortunately, \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/?ref=tbm-blog\",\"children\":\"Neon Serverless Postgres\"}],\" solves these problems.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"In this article, we will explore how Neon works, and I will provide a step-by-step guide for using Neon with ephemeral environments.\"}],\"\\n\",\"$L62\",\"\\n\",\"$L63\",\"\\n\",\"$L64\",\"\\n\",\"$L65\",\"\\n\",\"$L66\",\