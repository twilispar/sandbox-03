en\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}]\n63:[\"$\",\"p\",null,{\"children\":\"Neon is a serverless database platform built around PostgreSQL.\"}]\n64:[\"$\",\"p\",null,{\"children\":\"It separates storage and compute, and you pay only for the processing power you use. On paper, it’s similar to Aurora Serverless v2 in many ways, but there are some notable differences.\"}]\n65:[\"$\",\"h3\",null,{\"id\":\"scaling-and-cold-starts\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Scaling \u0026 Cold Starts\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#scaling-and-cold-starts\",\"aria-label\":\"Link to Scaling \u0026 Cold Starts\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$62:props:children:1:props:children:props:children\"}]}]]}]\n66:[\"$\",\"p\",null,{\"children\":\"Both can scale to zero during inactivity. But Neon scales much faster than Aurora Serverless v2, which takes a slower and more conservative approach.\"}]\n67:[\"$\",\"p\",null,{\"children\":\"Neon also cold starts from zero in 500ms vs. 15s for Aurora Serverless v2. This is important for development and ephemeral environments, where there are often long gaps between bursts of database activities.\"}]\n68:[\"$\",\"h3\",null,{\"id\":\"connection-pooling-and-data-api\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Connection Pooling \u0026 Data API\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#connection-pooling-and-data-api\",\"aria-label\":\"Link to Connection Pooling \u0026 Data API\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$62:props:children:1:props:children:props:children\"}]}]]}]\n69:[\"$\",\"p\",null,{\"children\":[\"Neon integrates PgBouncer directly into its architecture, enabling it to handle up to \",[\"$\",\"strong\",null,{\"children\":\"10,000 concurrent connections\"}],\" and queue requests during spikes, rather than rejecting them.\"]}]\n6a:[\"$\",\"p\",null,{\"children\":\"Aurora Serverless v2 calculates the max connections based on ACU. Serverless applications often create many short-lived connections as Lambda execution environments are created and destroyed. This can cause connection pool exhaustion, which is why many serverless applications would use RDS Proxy to scale the number of concurrent connections or switch to Aurora Serverless v2’s Data API.\"}]\n6b:[\"$\",\"p\",null,{\"children\":[\"Neon also has a data API that allows you to execute queries over HTTP or WebSockets. You c"])</script><script>self.__next_f.push([1,"an use the data API via Neon’s \",[\"$\",\"a\",null,{\"href\":\"https://neon.tech/docs/serverless/serve