<span class="line" data-line="5"><span style="color:var(--shiki-token-keyword)">  UPDATE</span><span style="color:var(--shiki-token-keyword)"> SET</span><span style="color:var(--shiki-foreground)"> first_name </span><span style="color:var(--shiki-token-keyword)">=</span><span style="color:var(--shiki-foreground)"> v.first_name, last_name </span><span style="color:var(--shiki-token-keyword)">=</span><span style="color:var(--shiki-foreground)"> v.last_name</span></span>
