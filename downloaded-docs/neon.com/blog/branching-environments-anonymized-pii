public/images/pages/blog/branching-environments-anonymized-pii/screenshot-2025-11-10-at-102516-am-1024x577-a34cc153.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/screenshot-2025-11-10-at-102516-am-1024x577-a34cc153.png\",\"alt\":\"Image\"}]}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://neon.com/docs/introduction/branching\",\"children\":\"Branching\"}],\" lets developers spin up isolated environments that perfectly mirror production in a single click or API call. This is a major upgrade for developer experience: teams can skip the tedious work of keeping databases in sync and focus on shipping code.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"But until now, there’s been one limitation. If your production data includes sensitive information, compliance and security rules often prevented you from creating dev or test branches directly. That changes today.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"When creating a branch in Neon, you can now select\"}],\" \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/docs/workflows/data-anonymization#create-a-branch-with-anonymized-data\",\"children\":\"Anonymized data\"}],[\"$\",\"strong\",null,{\"children\":\": Neon will mask sensitive information according to rules you define, giving you realistic, production-shaped data without exposing PII.\"}],\" When you’re done, simply delete the branch and move on. You can even automate the whole workflow with the Neon API or GitHub Actions.\"]}],\"\\n\",[\"$\",\"video\",null,{\"autoPlay\":true,\"muted\":true,\"controls\":true,\"width\":\"1860\",\"height\":\"1080\",\"children\":[\"$\",\"source\",null,{\"src\":\"https://cdn.neonapi.io/public/videos/pages/blog/branching-environments-anonymized-pii/neon-data-branching-v2-5e86c7aa.mp4\"}]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"All those dreadful environment maintenance tasks (manually managing separate staging databases, working with synthetic data, updating seed scripts) are becoming a thing of the past. \",[\"$\",\"strong\",null,{\"children\":\"The future of developer experience is branching, and we’re gonna tell you why.\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":[\"To jump straight to the update on anonymized branches, click \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/branching-environments-anonymized-pii#pii-wont-stop-you-introducing-anonymized-branches\",\"children\":\"here\"}],\".\"]}]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"environments-are-a-time-sink\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Environments Are a Time Sink\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#environments-are-a-time-sink\",\"aria-label\":\"Link to Environments Are a Time Sink\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"“Our testing process was very manual before Neon. Product would create a test customer in our development environment, the QA team would test and manually run through all the math, then an engineer would have to go into the database, look at all the values, and handwrite them into fixtures for our end-to-end tests… That’s multiple days for every single change” \",\"$L62\"]}],\"$L63\",\"$L64\"]}]}],\"\\n\",\"$L65\",\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\",\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\",\"\\n\",\"$L8f\",\"\\n\",\"$L90\",\"\\n\",\"$L91\",\"\\n\",\"$L92\",\"\\n\",\"$L93\",\"\\n\",\"$L94\",\"\\n\",\"$L95\",\"\\n\",\"$L96\",\"\\n\",\"$L97\",\"\\n\",\"$L98\",\"\\n\",\"$L99\",\"\\n\",\"$L9a\",\"\\n\",\"$L9b\",\"\\n\",\"$L9c\",\"\\n\",\"$L9d\",\"\\n\",\"$L9e\",\"\\n\",\"$L9f\",\"\\n\",\"$La0\",\"\\n\",\"$La1\",\"\\n\",\"$La2\",\"\\n\",\"$La3\",\"\\n\",\"$La4\",\"\\n\",\"$La5\",\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\"]\n"])</script><script>self.__next_f.push([1,":HL[\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/image-5-1024x798-37a9264f.png\",\"image\"]\n:HL[\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/image-7-1024x633-61214834.png\",\"image\"]\n62:[\"$\",\"br\",null,{}]\n63:[\"$\",\"br\",null,{}]\n64:[\"$\",\"em\",null,{\"children\":\"(Miguel Hernandez, Backend Tech Lead at Neo.Tax)\"}]\n65:[\"$\",\"p\",null,{\"children\":\"No matter how small or large, every engineering team needs non-production environments – places to test new features, run CI pipelines, reproduce bugs, or review schema changes before they reach production. These environments are supposed to behave like production, but maintaining that parity is one of the most annoying hardest ongoing operational tasks in software development.\"}]\n66:[\"$\",\"h3\",null,{\"id\":\"the-manual-non-prod-data-lifecycle\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"The manual non-prod data lifecycle\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#the-manual-non-prod-data-lifecycle\",\"aria-label\":\"Link to The manual non-prod data lifecycle\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n67:[\"$\",\"p\",null,{\"children\":\"Most teams start simple – copy the production database and scrub it. They run pg_dump, maybe write shell scripts to remove or redact sensitive data, and restore the dump into a staging instance. The hard reality is that production data changes often, especially as you’re shipping quickly or the business is growing. New tables, columns, and configs are added all the time, and the scripts quickly fall out of date.\"}]\n68:[\"$\",\"p\",null,{\"children\":\"We all know what happens when your environments fall out of sync with production (bugs undetected), so teams spend time trying to prevent this from happening. One option is automating this with nightly jobs or pipelines that recreate staging from production snapshots; you can also go the opposite way and maintain a seed dataset – a small, curated sample of data that’s “good enough” for testing, and do their best to refresh it often.\"}]\n69:[\"$\",\"p\",null,{\"children\":\"Both options are hardly anyone’s favorite to work on and they always introduce problems.\"}]\n6a:[\"$\",\"h3\",null,{\"id\":\"where-the-process-tends-to-break\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Where the process tends to break\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#where-the-process-tends-to-break\",\"aria-label\":\"Link to Where the process tends to break\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n6b:[\"$\",\"h4\",null,{\"children\":\"Data drift\"}]\n6c:[\"$\",\"p\",null,{\"children\":\"Staging data starts drifting from production almost immediately. New records, customer behaviors, or schema changes in production don’t make it into staging at the same pace. Within days, the shape and distribution of your data no longer match. Queries that perform fine in staging might time out in production because the row counts or index selectivity are different.\"}]\n6d:[\"$\",\"h4\",null,{\"children\":\"Schema mismatch\"}]\n6e:[\"$\",\"p\",null,{\"children\":\"Da"])</script><script>self.__next_f.push([1,"tabase migrations are another failure point. A migration might be applied to production but not staging, or run in a different order, or use slightly different data. That inconsistency leads to subtle issues – columns missing in staging, default values that don’t match, foreign keys referencing outdated IDs. CI pipelines fail, tests pass for the wrong reasons.\"}]\n6f:[\"$\",\"h4\",null,{\"children\":\"Broken referential integrity\"}]\n70:[\"$\",\"p\",null,{\"children\":\"When teams copy or scrub production data manually, they strip or anonymize columns independently. That breaks the relationships between tables in Postgres: foreign keys no longer align, there’s orphaned records and inconsistent IDs. It’s hard testing with this data and reproducing real user flows because the underlying relational context is gone. This is also one of the hardest issues to detect until something breaks downstream.\"}]\n71:[\"$\",\"h4\",null,{\"children\":\"Weak releases\"}]\n72:[\"$\",\"p\",null,{\"children\":\"Synthetic or seeded datasets rarely reflect the scale and cardinality of real production workloads – they miss outlier values and the edge cases that stress indexes and constraints. Performance regressions, deadlocks, and memory issues stay hidden until production traffic hits. This causes fragile release confidence: your tests may go green but production starts breaking more than you wish.\"}]\n73:[\"$\",\"h3\",null,{\"id\":\"the-cost-of-keeping-it-all-running\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"The cost of keeping it all running\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#the-cost-of-keeping-it-all-running\",\"aria-label\":\"Link to The cost of keeping it all running\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n74:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"“Our workload ingests hundreds of data points per second and our RDS costs were increasing, especially since we had multiple regions and environments. With Neon, we found a way to scale our setup more efficiently, using branching instead of duplicating instances and autoscaling to match our actual load”\"}],\" \",[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}],[\"$\",\"em\",null,{\"children\":\"(Thorsten Rieß, Software Architect at traconiq)\"}]]}]}]\n75:[\"$\",\"p\",null,{\"children\":\"Maintaining separate environments isn’t just slow and annoying. It’s also expensive, both in engineering team time and in cloud costs.\"}]\n76:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Each staging or testing database consumes storage and compute continuously, even when idle.\"}],\" Teams end up maintaining multiple long-lived managed Postgres clusters that serve no customer traffic but still end up costing hundreds or even thousands of dollars a month, especially as the setup bloats after a while.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"But the human cost is probably the largest one.\"}],\" Someone on the team becomes \",[\"$\",\"em\",null,{\"children\":\"the unofficial data janitor\"}],\", responsible for keeping all these environments usable even if they’re supposed to be a developer. This is a common pain in many smaller / leaner engineering teams, where there’s no designated DBA. Maintaining migration scripts, scrubbers, and seed files takes a lot of time.\"]}],\"\\n\"]}]\n77:[\"$\",\"h3\",null,{\"id\":\"what-you-get\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What you get\"]}],[\"$\",\"a\",n"])</script><script>self.__next_f.push([1,"ull,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#what-you-get\",\"aria-label\":\"Link to What you get\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n78:[\"$\",\"p\",null,{\"children\":\"Testing environments don’t catch bugs, development and staging environments rarely behave like production. Bugs that depend on real-world data distributions slip through, developers waste hours debugging issues that only exist because the data is different, companies end up with multiple always-on instances that are barely used, and developers end up spending more and more time on maintenance tasks that nobody saw coming.\"}]\n79:[\"$\",\"p\",null,{\"children\":\"This is a pattern that teams end up accepting as normal, but it doesn’t have to be.\"}]\n7a:[\"$\",\"h2\",null,{\"id\":\"branching-as-the-alternative\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Branching as the Alternative\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#branching-as-the-alternative\",\"aria-label\":\"Link to Branching as the Alternative\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n7b:[\"$\",\"p\",null,{\"children\":[\"One of the reasons we built Neon was to eliminate the grind described above. In 2025, developers shouldn’t be hand-curating test data – we deserve better. The way out is adding \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/docs/introduction/branching\",\"children\":\"branching\"}],\" to databases, creating an experience similar to what we’re used to in Git. But this only works if branching is a storage-level primitive built into the database, not a scripted clone of an instance.\"]}]\n7c:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"“When we moved to Neon, we consolidated all our non-prod services into a single Neon project. We just load our synthetic dataset once into the main staging branch and spin off child branches as needed. With Aurora, the process was more complex. We had to duplicate databases per service, which meant loading data separately for each environment”  \",[\"$\",\"br\",null,{}]]}],[\"$\",\"br\",null,{}],\"(\",[\"$\",\"em\",null,{\"children\":\"Cody Jenkins, Head of Engineering at Invenco\"}],\")\"]}]}]\n7d:[\"$\",\"h2\",null,{\"id\":\"the-architecture-primitives-of-branching\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"The Architecture Primitives of Branching\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#the-architecture-primitives-of-branching\",\"aria-label\":\"Link to The Architecture Primitives of Branching\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n7e:[\"$\",\"h3\",null,{\"id\":\"separation-of-compute-and-storage\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra"])</script><script>self.__next_f.push([1,"-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Separation of compute and storage\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#separation-of-compute-and-storage\",\"aria-label\":\"Link to Separation of compute and storage\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n7f:[\"$\",\"p\",null,{\"children\":\"In traditional Postgres setups, compute (the Postgres process) and storage (the data directory) live on the same machine. If we were to build any sort of environment-cloning feature this way, it would still be slow and expensive. Each would need its own VM, its own disk, its own lifecycle, etc.\"}]\n80:[\"$\",\"p\",null,{\"children\":[\"But in Neon, \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/architecture-decisions-in-neon\",\"children\":\"the architecture is decoupled\"}],\". Compute is stateless and ephemeral, running Postgres but holding no durable data. All persistent data lives in the storage layer, which is shared and distributed across the platform, and has a very particular design (as we’ll see now).\"]}]\n81:[\"$\",\"h3\",null,{\"id\":\"wal-first-storage\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"WAL-first storage\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#wal-first-storage\",\"aria-label\":\"Link to WAL-first storage\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n82:[\"$\",\"p\",null,{\"children\":[\"A decoupled compute and storage architecture eases the path towards cloning environments, but one still has to solve the problem of duplicating data very quickly. Neon built a \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/storage\",\"children\":\"custom storage layer for this\"}],\", in which every write is captured as a stream of WAL records which are stored durably by a quorum of lightweight services called \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/docs/introduction/architecture-overview\",\"children\":\"Safekeepers\"}],\".\"]}]\n83:[\"$\",\"p\",null,{\"children\":\"Safekeepers guarantee that once a transaction is acknowledged, it’s safely persisted, even if no compute is currently attached. They also record precise Log Sequence Numbers (LSNs), which act as version markers in the database’s history.\"}]\n84:[\"$\",\"p\",null,{\"children\":[\"This is essential for branching. This makes it possible to say: \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/get-page-at-lsn\",\"children\":\"“Create a new branch at LSN X”\"}],\" which is an exact point in time. That’s how Neon can spin up a new environment from any moment in production history, without needing a dump, restore, or snapshot job.\"]}]\n85:[\"$\",\"p\",null,{\"children\":[\"From there, the \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/docs/introduction/architecture-overview\",\"children\":\"Pageserver\"}],\" reconstructs data pages from WAL and stores them as immutable layers in object storage. Branching uses \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/instantly-copy-tb-size-datasets-the-magic-of-copy-on-write\",\"children\":\"copy-on-write\"}],\" semantics on those layers: the new branch references the same base data as its parent and only diverges when new writes occur.\"]}]\n86:[\"$\",\"p\",null,{\"children\":\"For developers, this means every branch is space-efficient, created in seconds, and mirrors production exactly.\"}]\n87:[\""])</script><script>self.__next_f.push([1,"$\",\"h3\",null,{\"id\":\"per-branch-compute-lifecycle\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Per-branch compute lifecycle\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#per-branch-compute-lifecycle\",\"aria-label\":\"Link to Per-branch compute lifecycle\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n88:[\"$\",\"p\",null,{\"children\":\"Because compute and storage are decoupled, each branch can attach its own temporary compute, a lightweight Postgres process that runs only when needed. When a branch is idle, its compute scales down to zero automatically while the storage layer remains intact. Spinning it back up is instant, since Postgres simply reattaches to the branch’s timeline.\"}]\n89:[\"$\",\"p\",null,{\"children\":\"In practice, this keeps workflows lean. Teams can create hundreds of short-lived branches (e.g. one per developer, test run, CI job) without paying for hundreds of always-on instances. The database behaves the way infrastructure should: on when you need it, gone when you don’t.\"}]\n8a:[\"$\",\"h2\",null,{\"id\":\"the-workflows\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"The Workflows\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#the-workflows\",\"aria-label\":\"Link to The Workflows\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n8b:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Together, these architectural components make Neon branching an actual substitute for manually deploying and maintaining separate non-prod instances.\"}],\" Neon branches can be used as your environments, and they all can be understood as ephemeral – you create them right when needed, you do whatever you need to do, you delete them / resync them with production after.\"]}]\n8c:[\"$\",\"p\",null,{\"children\":\"Let’s go through a few workflow examples that thousands of developers are already using every day.\"}]\n8d:[\"$\",\"h3\",null,{\"id\":\"development-environments\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Development environments\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#development-environments\",\"aria-label\":\"Link to Development environments\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n8e:[\"$\",\"p\",null,{\"children\":\"Developers need their own isolated environment that mirrors production, and these often need to live in the same cloud environment due to security and compliance reasons. Instead of maintaining long-lived dev instances and populating them manually, a developer on Neon can spin up a new branch from production in seconds. The branch has its own compute, independent from prod, and "])</script><script>self.__next_f.push([1,"perfectly mirrors its schema and data. You can run migrations, test queries, seed data, and when you’re done, delete or resync the branch with production.\"}]\n8f:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"“We’re a small team, but we’re scaling quickly and doing a lot. We’re shipping multiple times a day – to do that, we need to test stuff quickly and merge to main very quickly as well. Neon branches are a game changer for this” \",[\"$\",\"br\",null,{}]]}],[\"$\",\"br\",null,{}],\"(\",[\"$\",\"em\",null,{\"children\":\"Avi Romanoff, Founder at Magic Circle\"}],\")\"]}]}]\n90:[\"$\",\"h3\",null,{\"id\":\"preview-environments\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Preview environments\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#preview-environments\",\"aria-label\":\"Link to Preview environments\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n91:[\"$\",\"p\",null,{\"children\":[\"When deploying previews on platforms like \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/neon-vercel-native-integration\",\"children\":\"Vercel\"}],\", every feature branch can automatically get its own Neon branch. During build, a new database branch is created from production and linked to that preview deployment, with the same production schema and data, giving every preview app a realistic backend for QA and design review. When the PR closes, both the preview and the database branch are deleted automatically.\"]}]\n92:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"“Branching with scale to zero makes our lives markedly easier. We’re able to use real data without risky scripts touching production, and we don’t pay overnight for what we don’t use” \",[\"$\",\"br\",null,{}]]}],[\"$\",\"br\",null,{}],\"(\",[\"$\",\"em\",null,{\"children\":\"Ryan McHenry, Head of Technology, Sharing Excess\"}],\")\"]}]}]\n93:[\"$\",\"h3\",null,{\"id\":\"ephemeral-testing-and-ci-environments\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Ephemeral testing and CI environments\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#ephemeral-testing-and-ci-environments\",\"aria-label\":\"Link to Ephemeral testing and CI environments\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n94:[\"$\",\"p\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://neon.com/blog/ephemeral-environments-aws-serverless\",\"children\":\"Ephemeral environments\"}],\" are short-lived copies of your system and are ideal for CI pipelines and automated testing, but databases have traditionally been a friction point. With branching, each test run can automatically create a temporary branch from production, execute all tests against it, and delete it afterward. Because branches are copy-on-write and compute scales to zero when idle, you get instant, isolated test databases that cost virtually nothing when not in use – and GitHub Actions and the Neon API make it easy to automate.\"]}]\n95:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"“Anytime we need to test a new feature or extension, w"])</script><script>self.__next_f.push([1,"e branch off from production, run our checks, and reconnect when we’re ready. It’s simple, safe, and saves us huge amounts of time” \",[\"$\",\"br\",null,{}]]}],[\"$\",\"br\",null,{}],[\"$\",\"em\",null,{\"children\":\"(Ahsan Nabi Dar, CTO and co-founder of DAT)\"}]]}]}]\n96:[\"$\",\"h3\",null,{\"id\":\"staging-environments\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Staging environments\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#staging-environments\",\"aria-label\":\"Link to Staging environments\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n97:[\"$\",\"p\",null,{\"children\":\"Staging is where most teams try to get close to production but it’s also where data drift and compliance risks creep in. With Neon, you can create a long-lived staging branch derived directly from production and refresh it as often as you need. This ensures schema and data parity without complex sync jobs or downtime.\"}]\n98:[\"$\",\"blockquote\",null,{\"children\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":[\"“Branching lets us test big migrations safely with production data, and if something breaks, we just delete the branch and start fresh. That makes us a lot faster and more confident when shipping, even as a small team”\",[\"$\",\"em\",null,{\"children\":\" \"}],[\"$\",\"br\",null,{}]]}],[\"$\",\"br\",null,{}],[\"$\",\"em\",null,{\"children\":\"(Dominik Koch, CEO and Co-Founder of Marble\"}],\")\"]}]}]\n99:[\"$\",\"h2\",null,{\"id\":\"but-what-about-pii\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"But what about PII?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#but-what-about-pii\",\"aria-label\":\"Link to But what about PII?\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n9a:[\"$\",\"p\",null,{\"children\":\"Some teams use real data in staging for full-fidelity testing, but others need anonymized data for compliance. Neon now supports both:\"}]\n9b:[\"$\",\"h2\",null,{\"id\":\"pii-wont-stop-you-introducing-anonymized-branches\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"PII Won’t Stop You. Introducing Anonymized Branches\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#pii-wont-stop-you-introducing-anonymized-branches\",\"aria-label\":\"Link to PII Won’t Stop You. Introducing Anonymized Branches\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\n9c:[\"$\",\"p\",null,{\"children\":\"Adopting the branching workflows above could get tricky for teams handling sensitive data in prod – things like names, emails, addresses, payment details. That changes with our recent release of anonymized branches.\"}]\n9d:[\"$\",\"p\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"https://neon.co"])</script><script>self.__next_f.push([1,"m/docs/workflows/data-anonymization#create-a-branch-with-anonymized-data\",\"children\":\"When you create a new Neon branch, you can now choose “Anonymized data” as the data option:\"}]}]\n9e:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/image-5-1024x798-37a9264f.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/image-5-1024x798-37a9264f.png\",\"alt\":\"Image\"}]}]}]\n9f:[\"$\",\"p\",null,{\"children\":[\"Neon copies your schema and data from the parent branch (e.g. prod) and immediately applies masking rules using the \",[\"$\",\"a\",null,{\"href\":\"https://postgresql-anonymizer.readthedocs.io/en/stable/\",\"children\":\"PostgreSQL Anonymizer\"}],\" extension. The anonymization process is all handled by the platform: all you have to do is wait until the masking is done. This will be fast for tables with small PII columns, and it might take longer if you have a lot of PII to mask.\"]}]\na0:[\"$\",\"p\",null,{\"children\":[\"$\",\"$L61\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/image-7-1024x633-61214834.png\",\"isDark\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://cdn.neonapi.io/public/images/pages/blog/branching-environments-anonymized-pii/image-7-1024x633-61214834.png\",\"alt\":\"Image\"}]}]}]\na1:[\"$\",\"p\",null,{\"children\":[\"Regardless of if you have few or lots of PII, \",[\"$\",\"strong\",null,{\"children\":\"this gives you a database branch that behaves completely like production but holds no sensitive information.\"}],\" Fields such as names, emails, phone numbers, and addresses are replaced with safe, dummy equivalents, keeping foreign key relationships and constraints intact. You can pick exactly the masking rule you want to apply to each column, e.g.\"]}]\na2:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Dummy Free Email – replaces email addresses with realistic dummy addresses.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Dummy Last Name generates random but plausible names.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Dummy Phone Number – substitutes phone numbers with valid, formatted dummies.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Generate Random Value – randomizes numeric values such as age or salary\"}],\"\\n\"]}]\na3:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Of course, you can also define masking rules programmatically\"}],\" \",[\"$\",\"a\",null,{\"href\":\"https://neon.com/docs/workflows/data-anonymization#api-reference\",\"children\":\"via the API.\"}],\" Each branch can have its own rules, so you can anonymize them differently for different use cases, e.g. for dev or demos, and you can automate all of this.\"]}]\na4:[\"$\",\"h3\",null,{\"id\":\"under-the-hood\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Under the hood\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#under-the-hood\",\"aria-label\":\"Link to Under the hood\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\na5:[\"$\",\"p\",null,{\"children\":\"This first beta version of anonymized branches uses static masking, meaning that:\"}]\na6:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Masking runs once when the anonymized branch is created (or when you rerun anonymization)\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Parent data stays untouched. All masking happens in the new branch\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Anonymization rules are branch-specific\"}],\"\\n\"]}]\na7:[\"$\",\"h3\",null,{\"id\":\"storage-costs-implications\",\"className\":\"anchor-heading group relative w-fit scroll"])</script><script>self.__next_f.push([1,"-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Storage costs implications\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#storage-costs-implications\",\"aria-label\":\"Link to Storage costs implications\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$57:14:props:children:1:props:children:props:children\"}]}]]}]\na8:[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Since we’re doing static masking by now, there’s storage costs implications to anonymizing data.\"}],\" The masked columns will generate a storage delta that will add to your overall project storage bill; how large this delta will be depends on how much data you anonymize. If you’re masking a few small columns, the increase is minimal; if you’re masking many or large columns, it will be higher. Keep this in mind when estimating your storage usage.\"]}]\n"])</script><script>self.__n