<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-comment)">-- Reset all I/O statistics</span></span>
<span class="line" data-line="2"><span style="color:var(--shiki-token-keyword)">SELECT</span><span style="color:var(--shiki-foreground)"> pg_stat_reset_shared(</span><span style="color:var(--shiki-token-string-expression)">&#x27;io&#x27;</span><span style="color:var(--shiki-foreground)">);</span></span>
<span class="line" data-line="3"></span>
