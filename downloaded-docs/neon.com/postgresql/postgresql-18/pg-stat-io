<span class="line" data-line="8"><span style="color:var(--shiki-token-keyword)">FROM</span><span style="color:var(--shiki-foreground)"> pg_stat_io</span></span>
<span class="line" data-line="9"><span style="color:var(--shiki-token-keyword)">WHERE</span><span style="color:var(--shiki-foreground)"> reads </span><span style="color:var(--shiki-token-keyword)">&gt;</span><span style="color:var(--shiki-token-constant)"> 0</span><span style="color:var(--shiki-token-keyword)"> OR</span><span style="color:var(--shiki-foreground)"> writes </span><span style="color:var(--shiki-token-keyword)">&gt;</span><span style="color:var(--shiki-token-constant)"> 0</span></span>
