<span class="line" data-line="4"></span>
<span class="line" data-line="5"><span style="color:var(--shiki-token-comment)">-- For io_uring method (Linux only, requires liburing)</span></span>
<span class="line" data-line="6"><span style="color:var(--shiki-token-keyword)">ALTER</span><span style="color:var(--shiki-token-keyword)"> SYSTEM</span><span style="color:var(--shiki-token-keyword)"> SET</span><span style="color:var(--shiki-foreground)"> io_method </span><span style="color:var(--shiki-token-keyword)">=</span><span style="color:var(--shiki-token-string-expression)"> &#x27;io_uring&#x27;</span><span style="color:var(--shiki-foreground)">;</span></span>
