<span class="line" data-line="9"><span style="color:var(--shiki-foreground)">);</span></span>
<span class="line" data-line="10"></span>
<span class="line" data-line="11"><span style="color:var(--shiki-token-comment)">-- Natural ordering by creation time across all services</span></span>
<span class="line" data-line="12"><span style="color:var(--shiki-token-keyword)">SELECT</span><span style="color:var(--shiki-foreground)"> event_id, </span><span style="color:var(--shiki-token-keyword)">service_name</span><span style="color:var(--shiki-foreground)">, event_type</span></span>
<span class="line" data-line="13"><span style="color:var(--shiki-token-keyword)">FROM</span><span style="color:var(--shiki-foreground)"> distributed_events</span></span>
<span class="line" data-line="14"><span style="color:var(--shiki-token-keyword)">ORDER BY</span><span style="color:var(--shiki-foreground)"> event_id</span></span>
