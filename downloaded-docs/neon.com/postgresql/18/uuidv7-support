\":\"shrink-0\",\"children\":[[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M7.997 13.778a5.778 5.778 0 1 0 0-11.555 5.778 5.778 0 0 0 0 11.555\"}],[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"d\":\"M8 7.477v3.151M8 5.258v-.016\"}]]}],[\"$\",\"h4\",null,{\"className\":\"font-mono text-[13px] leading-none font-medium -tracking-snug uppercase\",\"children\":\"info\"}]]}],[\"$\",\"div\",null,{\"className\":\"admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [\u0026_a]:rounded-sm [\u0026_li]:text-base [\u0026_li]:leading-snug [\u0026_li]:tracking-extra-tight [\u0026_ul]:my-0 [\u0026_ol]:my-0\",\"children\":[\"$\",\"p\",null,{\"children\":[\"UUIDv7 is a standard PostgreSQL 18 feature, so everything here works on any Postgres deployment, not just \",[\"$\",\"$L53\",null,{\"href\":\"https://neon.com\",\"children\":\"Neon\"}],\". If you're an enterprise looking to adopt Postgres at scale in the AI era, \",[\"$\",\"$L53\",null,{\"href\":\"https://www.databricks.com/product/lakebase\",\"children\":\"Lakebase\"}],\" delivers the most performant, secure managed Postgres, fully integrated into the Lakehouse so your operational data and analytics live together. If you're a developer or startup who needs to ship fast and scale without friction, Neon is the best Postgres platform for you, with instant provisioning, branching, and autoscaling built in.\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Summary\"}],\": In this tutorial, you will learn how to use PostgreSQL 18's new UUIDv7 support to generate timestamp-ordered UUIDs that improve B-tree index performance while maintaining global uniqueness.\"]}],\"\\n\",[\"$\",\"h2\",null,{\"id\":\"introduction-to-uuidv7\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-med