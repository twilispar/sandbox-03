"children\":[[\"$\",\"span\",null,{\"children\":[\"Wire Protocol Version 3.2\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#wire-protocol-version-32\",\"aria-label\":\"Link to Wire Protocol Version 3.2\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n57:[\"$\",\"p\",null,{\"children\":\"PostgreSQL 18 introduces wire protocol version 3.2, the first new protocol version since version 3.0 was introduced in PostgreSQL 7.4 back in 2003. This represents a major step forward in the underlying communication protocol between clients and servers.\"}]\n58:[\"$\",\"h3\",null,{\"id\":\"understanding-the-wire-protocol\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Understanding the Wire Protocol\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#understanding-the-wire-protocol\",\"aria-label\":\"Link to Understanding the Wire Protocol\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n59:[\"$\",\"p\",null,{\"children\":\"The wire protocol defines how PostgreSQL clients and servers communicate over the network. It handles everything from authentication to query execution and result delivery. The protocol has remained stable for over 20 years, which shows PostgreSQL's commitment to backward compatibility.\"}]\n5a:[\"$\",\"p\",null,{\"children\":\"Protocol version 3.2 maintains full backward compatibility. Existing clients continue to work unchanged, while new clients can take advantage of features when both client and server support the newer protocol version.\"}]\n5b:[\"$\",\"h3\",null,{\"id\":\"whats-new-in-protocol-32\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What's New in Protocol 3.2\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#whats-new-in-protocol-32\",\"aria-label\":\"Link to What's New in Protocol 3.2\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":"])</script><script>self.__next_f.push([1,"14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n5c:[\"$\",\"p\",null,{\"children\":\"The main improvement in protocol version 3.2 is support for stronger security features, particularly the new 256-bit cancel request keys. The protocol now supports variable-length cancel keys, which provides better security and flexibility for future improvements.\"}]\n5d:[\"$\",\"p\",null,{\"children\":[\"$\",\"strong\",null,{\"children\":\"Key changes in protocol 3.2:\"}]}]\n5e:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Support for longer cancellation keys (up to 256 bits)\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Variable-length key support for future extensibility\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Improved protocol negotiation capabilities\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Foundation for future security improvements\"}],\"\\n\"]}]\n5f:[\"$\",\"h3\",null,{\"id\":\"current-implementation-status\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Current Implementation Status\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#current-implementation-status\",\"aria-label\":\"Link to Current Implementation Status\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n60:[\"$\",\"p\",null,{\"children\":\"While PostgreSQL 18 servers support protocol version 3.2, libpq (the standard PostgreSQL client library) continues to use protocol version 3.0 by default. Driver authors can opt into 3.2 using the new min/max protocol settings.\"}]\n61:[\"$\",\"p\",null,{\"children\":[\"To check the negotiated protocol, call \",[\"$\",\"code\",null,{\"children\":\"PQfullProtocolVersion()\"}],\" from libpq-based clients. Currently, there is no SQL command that reports the wire protocol version.\"]}]\n62:[\"$\",\"p\",null,{\"children\":\"To use protocol version 3.2 features, both the client and server must support the new protocol version. Driver developers and application maintainers will gradually add support for the improved protocol features.\"}]\n63:[\"$\",\"h3\",null,{\"id\":\"impact-on-applications\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Impact on Applications\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#impact-on-applications\",\"aria-label\":\"Link to Impact on Applications\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n64:[\"$\",\"p\",null,{\"children\":\"For most applications, the protocol upgrade is transparent. Existing applications continue to work without modification. The new protocol features primarily benefit:\"}]\n65:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Database drivers\"}],\": Can implement improved security features\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Connection poolers\"}],\": Can take advantage of improved cancellation key management\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Monitoring tools\"}],\": Better access to protocol-level information\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Security-focused applications\"}],\": Better protection "])</script><script>self.__next_f.push([1,"against network-level attacks\"]}],\"\\n\"]}]\n66:[\"$\",\"h2\",null,{\"id\":\"cancel-request-keys\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Cancel Request Keys\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#cancel-request-keys\",\"aria-label\":\"Link to Cancel Request Keys\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n67:[\"$\",\"p\",null,{\"children\":\"One of the most significant security improvements in PostgreSQL 18 when using protocol version 3.2 is the upgrade from 32-bit to 256-bit cancel request keys. This change dramatically improves security for query cancellation operations.\"}]\n68:[\"$\",\"h3\",null,{\"id\":\"understanding-cancel-request-security\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Understanding Cancel Request Security\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#understanding-cancel-request-security\",\"aria-label\":\"Link to Understanding Cancel Request Security\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n69:[\"$\",\"p\",null,{\"children\":\"PostgreSQL allows clients to cancel running queries by sending a special cancel request message. To prevent unauthorized query cancellations, this request must include a secret key that was provided when the connection was established.\"}]\n6a:[\"$\",\"p\",null,{\"children\":\"The problem with the traditional approach was that 32-bit keys provide limited security. With only 4 billion possible values, an attacker could potentially brute-force cancel requests to disrupt database operations.\"}]\n6b:[\"$\",\"h3\",null,{\"id\":\"256-bit-cancel-keys\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"256-Bit Cancel Keys\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#256-bit-cancel-keys\",\"aria-label\":\"Link to 256-Bit Cancel Keys\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n6c:[\"$\",\"p\",null,{\"children\":\"PostgreSQL 18 addresses this security concern by introducing 256-bit cancel request keys when using protocol version 3.2. This provides enormous improvement in security:\"}]\n6e:[\"$\",\"p\",null,{\"children\":\"This makes brute-force attacks against cancel requests practically impossible, even with significant computing resources available to an attacker.\"}]\n6f:[\"$\",\"h3\",null,{\"id\":\"how-the-upgrade-works\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"How the Upgrade Works\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 "])</script><script>self.__next_f.push([1,"focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#how-the-upgrade-works\",\"aria-label\":\"Link to How the Upgrade Works\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n70:[\"$\",\"p\",null,{\"children\":\"The upgrade is automatic when both client and server support protocol version 3.2:\"}]\n71:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Client connects\"}],\" using protocol version 3.2\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Server generates\"}],\" a 256-bit cancellation key\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Key is provided\"}],\" to the client during connection establishment\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Cancel requests\"}],\" use the longer key for authentication\"]}],\"\\n\"]}]\n72:[\"$\",\"p\",null,{\"children\":\"For clients using protocol version 3.0, PostgreSQL 18 continues to generate 32-bit keys, maintaining full backward compatibility.\"}]\n73:[\"$\",\"h3\",null,{\"id\":\"practical-impact\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Practical Impact\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#practical-impact\",\"aria-label\":\"Link to Practical Impact\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n74:[\"$\",\"p\",null,{\"children\":\"The longer cancel keys provide several benefits:\"}]\n75:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Protection against brute-force cancellation attacks\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Better security in environments with network access\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Stronger isolation between different database users\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Foundation for additional security improvements\"}],\"\\n\"]}]\n76:[\"$\",\"h2\",null,{\"id\":\"tls-13-cipher-configuration\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"TLS 1.3 Cipher Configuration\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#tls-13-cipher-configuration\",\"aria-label\":\"Link to TLS 1.3 Cipher Configuration\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n77:[\"$\",\"p\",null,{\"children\":[\"PostgreSQL 18 adds support for configuring TLS 1.3 cipher suites through the new \",[\"$\",\"code\",null,{\"children\":\"ssl_tls13_ciphers\"}],\" parameter. This addresses a gap where TLS 1.3 connections couldn't be fine-tuned for security requirements.\"]}]\n78:[\"$\",\"h3\",null,{\"id\":\"background-tls-cipher-configuration\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Background: TLS Cipher Configuration\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#background-tls-cipher-configuration\",\""])</script><script>self.__next_f.push([1,"aria-label\":\"Link to Background: TLS Cipher Configuration\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n79:[\"$\",\"p\",null,{\"children\":[\"Before PostgreSQL 18, the \",[\"$\",\"code\",null,{\"children\":\"ssl_ciphers\"}],\" parameter could only configure cipher suites for TLS 1.2 and earlier versions. TLS 1.3 connections used default cipher selection, which wasn't suitable for environments with specific security requirements.\"]}]\n7a:[\"$\",\"p\",null,{\"children\":\"TLS 1.3 uses a different set of cipher suites than earlier TLS versions, and these suites are not compatible with the older configuration syntax. This created challenges for organizations needing to comply with specific security standards.\"}]\n7b:[\"$\",\"h3\",null,{\"id\":\"the-new-ssltls13ciphers-parameter\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"The New ssl_tls13_ciphers Parameter\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#the-new-ssltls13ciphers-parameter\",\"aria-label\":\"Link to The New ssl_tls13_ciphers Parameter\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n7c:[\"$\",\"p\",null,{\"children\":[\"PostgreSQL 18 introduces the \",[\"$\",\"code\",null,{\"children\":\"ssl_tls13_ciphers\"}],\" parameter specifically for TLS 1.3 cipher suite configuration:\"]}]\n7e:[\"$\",\"p\",null,{\"children\":[\"The parameter accepts a colon-separated list of TLS 1.3 cipher suite names. If left empty (the default), PostgreSQL uses OpenSSL's default TLS 1.3 cipher suite selection. The \",[\"$\",\"code\",null,{\"children\":\"ssl_tls13_ciphers\"}],\" parameter wasn't available in earlier PostgreSQL versions, so it won't affect existing configurations.\"]}]\n7f:[\"$\",\"h3\",null,{\"id\":\"supported-tls-13-cipher-suites\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Supported TLS 1.3 Cipher Suites\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#supported-tls-13-cipher-suites\",\"aria-label\":\"Link to Supported TLS 1.3 Cipher Suites\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n80:[\"$\",\"p\",null,{\"children\":\"Common TLS 1.3 cipher suites that can be configured include:\"}]\n81:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"TLS_AES_256_GCM_SHA384\"}],\": AES 256-bit encryption with GCM mode\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"TLS_CHACHA20_POLY1305_SHA256\"}],\": ChaCha20-Poly1305 encryption\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"TLS_AES_128_GCM_SHA256\"}],\": AES 128-bit encryption with GCM mode\"]}],\"\\n\"]}]\n83:[\"$\",\"p\",null,{\"children\":\"For a complete list of supported TLS 1.3 cipher suites, refer to the OpenSSL documentation or the PostgreSQL release notes.\"}]\n84:[\"$\",\"h3\",null,{\"id\":\"configuration-best-practices\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Configuration Best Practices\"]}"])</script><script>self.__next_f.push([1,"],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#configuration-best-practices\",\"aria-label\":\"Link to Configuration Best Practices\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$4a:4:props:children:1:props:children:props:children\"}]}]]}]\n85:[\"$\",\"p\",null,{\"children\":\"When configuring TLS 1.3 cipher suites:\"}]\n86:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Use cipher suites approved