":\"/images/case-studies/bitso-dark.svg\",\"alt\":\"Bitso\",\"width\":105,\"height\":32,\"className\":\"h-8 w-fit sm:h-6\"}],[\"$\",\"blockquote\",null,{\"className\":\"font-mono text-[20px] leading-snug font-normal -tracking-wide text-black xl:text-lg md:text-base [\u0026_mark]:bg-green-44/70\",\"dangerouslySetInnerHTML\":{\"__html\":\"Neon’s branching gave us true database isolation. Now every sandbox gets its own \u003cmark\u003eisolated Postgres DB\u003c/mark\u003e whenever required.\"}}]]}],[\"$\",\"div\",null,{\"className\":\"mt-auto flex flex-col gap-1 lg:mt-5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-mono text-[15px] leading-snug font-medium -tracking-wide text-[#242628]\",\"children\":\"Joe Horsnell\"}],[\"$\",\"span\",null,{\"className\":\"font-mono text-[15px] leading-snug font-normal -tracking-wide text-[#242628]\",\"children\":\"Principal Platform Engineer at Bitso\"}]]}]]}],[\"$\",\"article\",\"retool\",{\"className\":\"flex h-[274px] flex-col justify-between lg:h-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-9 lg:gap-6 md:gap-5\",\"children\":[[\"$\",\"$L2f\",null,{\"src\":\"/images/case-studies/retool-dark.svg\",\"alt\":\"Retool\",\"width\":111,\"height\":32,\"className\":\"h-8 w-fit sm:h-6\"}],\"$L47\"]}],\"$L48\"]}]]}]]}]}]]}]\n"])</script><script>self.__next_f.push([1,"33:[\"$\",\"$L49\",null,{\"items\":[{\"id\":\"magic-circle\",\"title\":\"Magic Circle\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/magic-circle.svg\",\"mediaDetails\":{\"width\":86,\"height\":32}},\"quote\":\"We’re a small team, but we’re scaling quickly and doing a lot. We’re shipping multiple times a day— to do that, we need to test stuff quickly and merge to main very quickly as well. Neon branches are a game changer for this.\",\"author\":{\"name\":\"Avi Romanoff, Founder at Magic Circle\",\"post\":\"\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"how-magic-circle-scaled-up-to-2m-games-with-cloudfare-and-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"startups\",\"name\":\"Startups\"}]}},{\"id\":\"create-xyz\",\"title\":\"Anything\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/create-xyz.svg\",\"mediaDetails\":{\"width\":117,\"height\":32}},\"quote\":\"Neon’s speed of provisioning and serverless scale-to-zero is critical for us. We can serve users iterating on quick ideas efficiently while also supporting them as they scale, without making them think about database setup.\",\"author\":{\"name\":\"Dhruv Amin\",\"post\":\"Co-founder at Anything\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"from-idea-to-full-stack-app-in-one-conversation-with-create\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"vapi\",\"title\":\"Vapi\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/vapi.svg\",\"mediaDetails\":{\"width\":99,\"height\":32}},\"quote\":\"Neon’s serverless model is a perfect fit for us. Some of our AI voice agents handle thousands of calls in an instant, and then traffic drops off just as fast. With Neon, we don’t have to think about scaling—it just happens\",\"author\":{\"name\":\"Tejas Siripurapu\",\"post\":\"Founding Engineer at Vapi.ai\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"vapi-voice-agents-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"nodecraft\",\"title\":\"Nodecraft\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/nodecraft.svg\",\"mediaDetails\":{\"width\":144,\"height\":32}},\"quote\":\"Moving from legacy infrastructure to a fully serverless stack has been a huge upgrade. \u003cmark\u003eWe wanted our backend to be as hands-off as possible\u003c/mark\u003e. Now we get all the power of Postgres, without having to think about it\",\"author\":{\"name\":\"James Ross\",\"post\":\"Co-founder and CTO at Nodecraft\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"nodecraft-cloudflare-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"startups\",\"name\":\"Startups\"}]}},{\"id\":\"velocity\",\"title\":\"Velocity\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/velocity.svg\",\"mediaDetails\":{\"width\":164,\"height\":32}},\"quote\":\"“We used RDS before, but the cost and manual effort of scaling it up and down was a pain. I also wanted one database solution across clouds—and Neon gave us that”\",\"author\":{\"name\":\"Tal Kain\",\"post\":\"Founder and CEO\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"velocity-future-on-call\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"endform\",\"title\":\"Endform\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/endform.svg\",\"mediaDetails\":{\"width\":150,\"height\":32}},\"quote\":\"Every tech choice we make is about staying lightweight and scalable. Neon fits that perfectly: we can spin up real Postgres databases in CI, in seconds, with zero hassle.\",\"author\":{\"name\":\"Oliver Stenbom\",\"post\":\"Co-founder of Endform\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"endform-wants-to-scale-your-playwright-end-to-end-tests\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"startups\",\"name\":\"Startups\"}]}},{\"id\":\"smashsend\",\"title\":\"SMASHSEND\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/smashsend.svg\",\"mediaDetails\":{\"width\":135,\"height\":32}},\"quote\":\"We moved from AWS RDS to Neon and the benefits have already been massive. We cut our database bill from $1,500 to $70 a month\",\"author\":{\"name\":\"Jorge Ferreiro\",\"post\":\"Founder of SMASHSEND\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"smashsend-from-rds-to-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"startups\",\"name\":\"Startups\"}]}},{\"id\":\"dev\",\"title\":\"DEV\",\"caseStudyPost\":{\"isFeatured\":true,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/dev.svg\",\"mediaDetails\":{\"width\":150,\"height\":32}},\"quote\":\"What first attracted us to Neon was the efficient scaling. What kept us interested were all the \u003cmark\u003ethoughtful developer-experience wins.\u003c/mark\u003e\",\"author\":{\"name\":\"Ben Halpern\",\"post\":\"DEV Co-Founder\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"dev-from-heroku-to-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"fast-moving-teams\",\"name\":\"Fast-moving teams\"}]}},{\"id\":\"databutton\",\"title\":\"Databutton\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/databutton.svg\",\"mediaDetails\":{\"width\":157,\"height\":32}},\"quote\":\"Integrating Neon was a no-brainer. It gives every Databutton app a production-grade Postgres database in seconds, with zero overhead\",\"author\":{\"name\":\"Martin Skow Røed\",\"post\":\"CTO and co-founder of Databutton\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"databutton-neon-integration\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"traconiq\",\"title\":\"traconiq\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/traconiq.svg\",\"mediaDetails\":{\"width\":112,\"height\":32}},\"quote\":\"Our workload ingests hundreds of data points per second and our RDS costs were increasing. With Neon, we found a way to scale our setup more efficiently\",\"author\":{\"name\":\"Thorsten Rieß\",\"post\":\"Software Architect at traconiq\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"why-traconiq-migrated-from-aws-rds-to-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"fast-moving-teams\",\"name\":\"Fast-moving teams\"}]}},{\"id\":\"vecstore\",\"title\":\"Vecstore\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/vecstore.svg\",\"mediaDetails\":{\"width\":124,\"height\":32}},\"quote\":\"We replaced both Pinecone and RDS with Neon, and latency dropped from 200ms to 80ms with a much simpler setup\",\"author\":{\"name\":\"Giorgi Kenchadze\",\"post\":\"Founder \u0026 CEO at Vecstore\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"vecstore-replacing-pinecone-and-rds-with-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"dyad\",\"title\":\"Dyad\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/dyad.svg\",\"mediaDetails\":{\"width\":104,\"height\":33}},\"quote\":\"\",\"author\":{\"name\":\"\",\"post\":\"\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"dyad-brings-postgres-to-local-ai-app-building-powered-by-neon\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"xpander-ai\",\"title\":\"xpander.ai\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/xpander-ai.svg\",\"mediaDetails\":{\"width\":163,\"height\":32}},\"quote\":\"For every tenant in our system, we create a dedicated project in Neon. That lets us isolate memory and scale cleanly as agent usage grows.\",\"author\":{\"name\":\"Ran Sheinberg\",\"post\":\"Co-founder and CPO\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"xpander-ai-agents-slack-neon-backend\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"neptune\",\"title\":\"Neptune\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/neptune.svg\",\"mediaDetails\":{\"width\":154,\"height\":32}},\"quote\":\"We wanted to move as fast and as safely as possible—and Neon’s branching model for Postgres lets us do that. It’s just like working with Git: each developer gets their own branch, tests it, and we never have to worry about coordinating test data or stepping on each other’s toes.\",\"author\":{\"name\":\"Andy Bonventre\",\"post\":\"CTO at Neptune\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"neptune-built-a-fast-serverless-backend-with-neon-and-vercel\"}},\"caseStudiesCategories\":{\"nodes\":[]}},{\"id\":\"marble\",\"title\":\"Marble\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/marble.svg\",\"mediaDetails\":{\"width\":169,\"height\":32}},\"quote\":\"Neon branching makes us a lot faster and more confident when shipping, even as a small team\",\"author\":{\"name\":\"Dominik Koch\",\"post\":\"CEO and Co-Founder of Marble\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"marble-is-shipping-faster-with-neon-branching\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"startups\",\"name\":\"Startups\"}]}},{\"id\":\"sharing-excess\",\"title\":\"Sharing Excess\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/sharing-excess.svg\",\"mediaDetails\":{\"width\":149,\"height\":32}},\"quote\":\"\",\"author\":{\"name\":\"\",\"post\":\"\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"branching-as-the-environment-how-sharing-excess-ships-faster-on-neon\"}},\"caseStudiesCategories\":{\"nodes\":[]}},{\"id\":\"axess-intelligence\",\"title\":\"Axess Intelligence\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/axess-intelligence.svg\",\"mediaDetails\":{\"width\":110,\"height\":32}},\"quote\":\"We didn’t want to spend unnecessary time writing CRUD logic or maintaining a backend. We just connected Better Auth and the Data API and started building. The best part: every Neon branch gets its own Data API URL\",\"author\":{\"name\":\"Mouaz Anan\",\"post\":\"Engineer at Axess Intelligence\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"how-axess-intelligence-simplified-their-backend-with-neons-data-api\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"backend\",\"name\":\"Backend\"}]}},{\"id\":\"daisy\",\"title\":\"Daisy\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/daisy.svg\",\"mediaDetails\":{\"width\":100,\"height\":32}},\"quote\":\"Using Neon with Neon Auth just made everything simpler. Our database and auth live in the same place, and it’s the kind of backend you forget it exists. That’s exactly how it should be\",\"author\":{\"name\":\"Gabriel Tumlos\",\"post\":\"Founder of Daisy\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"integrating-postgres-and-auth-the-easy-way-daisys-neon-setup\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"backend\",\"name\":\"Backend\"}]}},{\"id\":\"bitso\",\"title\":\"Bitso\",\"caseStudyPost\":{\"isFeatured\":true,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/bitso.svg\",\"mediaDetails\":{\"width\":105,\"height\":32}},\"quote\":\"Neon’s branching gave us true database isolation. Now every sandbox gets its own \u003cmark\u003eisolated Postgres DB\u003c/mark\u003e whenever required.\",\"author\":{\"name\":\"Joe Horsnell\",\"post\":\"Principal Platform Engineer at Bitso\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"bitso-branching-workflow\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"fast-moving-teams\",\"name\":\"Fast-moving teams\"}]}},{\"id\":\"atoms\",\"title\":\"Atoms\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/atoms.svg\",\"mediaDetails\":{\"width\":116,\"height\":32}},\"quote\":\"We chose Neon as our backend because of scale, cost-efficiency, and superior developer and user experience, all critical for Atoms’ multi-tenant architecture\",\"author\":{\"name\":\"Engineering Team\",\"post\":\"at Atoms\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"atoms-is-out-a-multi-agent-ai-team-that-builds-full-stack-apps-for-you\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"strapi\",\"title\":\"Strapi\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/strapi.svg\",\"mediaDetails\":{\"width\":124,\"height\":32}},\"quote\":\"Our agent Fimo lets teams experiment without fear because you can always roll back. Neon’s branches and snapshots are what make that possible\",\"author\":{\"name\":\"Pierre Burgy\",\"post\":\"CEO of Strapi\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"meet-fimo-ai-the-ai-native-cms-from-strapi\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"qwikbuild\",\"title\":\"QwikBuild\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/qwikbuild.svg\",\"mediaDetails\":{\"width\":156,\"height\":42}},\"quote\":\"“Soon, AI agents will do most of the coding, and perhaps 1000x more database instances will be needed. Neon’s platform and pricing strategy feel aligned with that future”\",\"author\":{\"name\":\"Nilesh Trivedi\",\"post\":\"co-founder and CTO at QwikBuild\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"inside-qwikbuild-neon-powered-architecture\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"specific-dev\",\"title\":\"Specific.dev\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/specific-dev.svg\",\"mediaDetails\":{\"width\":157,\"height\":32}},\"quote\":\"“I’m genuinely surprised by how well it handles that scale. You can create tons of databases and they’re available immediately. You can branch out immediately. All of those things make it really nice for agent-managed infra.”\",\"author\":{\"name\":\"Iman Radjavi\",\"post\":\"co-founder at Specific.dev\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"how-specific-provisions-thousands-of-databases-for-coding-agents-using-neon\"}},\"caseStudiesCategories\":{\"nodes\":[]}},{\"id\":\"basehub\",\"title\":\"BaseHub\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/basehub.svg\",\"mediaDetails\":{\"width\":111,\"height\":32}},\"quote\":\"Databases have always been such a pain in terms of the migration flow, backups, scaling, risk of breaking production… In Neon, everything feels easier and much safer to do\",\"author\":{\"name\":\"Julian Benegas\",\"post\":\"CEO\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"meet-basehub-developer-velocity-and-efficiency-right-down-to-the-database\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"startups\",\"name\":\"Startups\"},{\"slug\":\"ai\",\"name\":\"AI \u0026 Agents\"}]}},{\"id\":\"retool\",\"title\":\"Retool\",\"caseStudyPost\":{\"isFeatured\":true,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/retool.svg\",\"mediaDetails\":{\"width\":111,\"height\":32}},\"quote\":\"We’ve been able to manage \u003cmark\u003e300K+ Postgres databases\u003c/mark\u003e via the Neon API. It saved us a tremendous amount of time and engineering effort.\",\"author\":{\"name\":\"Himanshu Bhandoh\",\"post\":\"Software Engineer at Retool\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"how-retool-uses-retool-and-the-neon-api-to-manage-300k-postgres-databases\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"platforms\",\"name\":\"Platforms\"}]}},{\"id\":\"koyeb\",\"title\":\"Koyeb\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/koyeb.svg\",\"mediaDetails\":{\"width\":111,\"height\":32}},\"quote\":\"Neon’s serverless philosophy is \u003cmark\u003ealigned with our vision\u003c/mark\u003e: no infrastructure to manage, no servers to provision, no database cluster to maintain.\",\"author\":{\"name\":\"Edouard Bonlieu\",\"post\":\"Co-founder at Koyeb\"},\"isInternal\":false,\"externalUrl\":\"https://www.koyeb.com/blog/serverless-postgres-public-preview\",\"post\":null},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"platforms\",\"name\":\"Platforms\"}]}},{\"id\":\"neo-tax\",\"title\":\"Neo.Tax\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/neo-tax.svg\",\"mediaDetails\":{\"width\":105,\"height\":32}},\"quote\":\"Database branching is the best quality-of-life improvement to my tech stack that I can think of in recent years. Second to maybe only Copilot\",\"author\":{\"name\":\"Miguel Hernandez\",\"post\":\"CEO\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"from-days-to-minutes-how-neo-tax-accelerated-their-development-lifecycle\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"fast-moving-teams\",\"name\":\"Fast-moving teams\"}]}},{\"id\":\"vercel\",\"title\":\"Vercel\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/vercel.svg\",\"mediaDetails\":{\"width\":120,\"height\":32}},\"quote\":\"By partnering with Neon, Vercel\u0026#8217;s frontend platform is now the end-to-end serverless solution for building on the Web, from Next.js all the way to SQL.\",\"author\":{\"name\":\"Guillermo Rauch\",\"post\":\"CEO\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"neon-postgres-on-vercel\"}},\"caseStudiesCategories\":{\"nodes\":[{\"slug\":\"platforms\",\"name\":\"Platforms\"}]}},{\"id\":\"wordware\",\"title\":\"Wordware\",\"caseStudyPost\":{\"isFeatured\":false,\"logo\":{\"mediaItemUrl\":\"/images/case-studies/wordware.svg\",\"mediaDetails\":{\"width\":138,\"height\":32}},\"quote\":\"With Neon’s preview branches, we can catch issues early and fix them before they hit production\",\"author\":{\"name\":\"Robert Chandler\",\"post\":\"Co-founder and CTO\"},\"isInternal\":true,\"externalUrl\":\"\",\"post\":{\"slug\":\"building-ai-agents-just-got-faster-with-wordwar