w\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Architecture overview\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#architecture-overview\",\"aria-label\":\"Link to Architecture overview\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":[\"$\",\"path\",null,{\"stroke\":\"currentColor\",\"strokeLinecap\":\"square\",\"strokeLinejoin\":\"round\",\"strokeWidth\":1.4,\"d\":\"m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75\"}]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Making an agent replayable requires capturing two critical pieces of state at the moment of interruption:\"}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Agent state\"}],\": The conversation history, tool calls, and execution graph. The OpenAI Agents SDK provides this via the \",[\"$\",\"$L64\",null,{\"href\":\"https://openai.github.io/openai-agents-python/ref/run_state/\",\"children\":[\"$\",\"code\",null,{\"children\":\"RunState\"}]}],\" object, which can be serialized to JSON and resumed after a \",[\"$\",\"$L64\",null,{\"href\":\"https://openai.github.io/openai-agents-python/human_in_the_loop/\",\"children\":\"human-in-the-loop\"}],\" interruption.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Database state\"}],\": The schema and data at the moment of the pause. Neon handles this with copy-on-write \",[\"$\",\"strong\",null,{\"children\":\"snapshots\"}],\", which capture large databases instantly without heavy duplication.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"h3\",null,{\"id\":\"what-are-neon-snapshots\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"What are Neon Snapshots?\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#what-are-neon-snapshots\",\"aria-label\":\"Link to What are Neon Snapshots?\",\"children\":\"$L65\"}]]}],\"\\n\",\"$L66\",\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\",\"\\n\",\"$L74\",\"\\n\",\"$L75\",\"\\n\",\"$L76\",\"\\n\",\"$L77\",\"\\n\",\"$L78\",\"\\n\",\"$L79\",\"\\n\",\"$L7a\",\"\\n\",\"$L7b\",\"\\n\",\"$L7c\",\"\\n\",\"$L7d\",\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\"]\n"])</script><script>self.__next_f.push([1,"82:I[205411,[\"/_next/static/chunks/0-0o8zjuqab7b.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0-wyrs755k4-p.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0i.l9589uvx0j.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/091ffmj5eeg4m.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/13twdpqxz8tr6.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/05jguszscqe2t.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0712bbhfq86sz.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/15lxb7jjl82fj.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0h.udm.w.7o.o.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/