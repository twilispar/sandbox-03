n\":[[\"$\",\"span\",null,{\"children\":[\"Configuring Connection Pooling in GORM\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#configuring-connection-pooling-in-gorm\",\"aria-label\":\"Link to Configuring Connection Pooling in GORM\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n80:[\"$\",\"p\",null,{\"children\":[\"When using Go with Neon, GORM offers built-in connection pooling that works seamlessly with Neon's pooler. By configuring settings like \",[\"$\",\"code\",null,{\"children\":\"SetMaxOpenConns\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"SetConnMaxIdleTime\"}],\", developers can fine-tune how connections are managed within their application before they reach the database layer.\"]}]\n81:[\"$\",\"p\",null,{\"children\":\"Since Neon already optimizes pooling on the database side, applications should maintain a moderate number of open connections to avoid excessive connection churn.\"}]\n82:[\"$\",\"p\",null,{\"children\":[\"The recommended approach is to use a pooled connection string for normal queries and switch to a direct connection for migration tasks that require session state. For guidance on configuring connection pooling in Go, refer to the \",[\"$\",\"$L64\",null,{\"href\":\"https://gorm.io/docs/generic_interface.html#Connection-Pool\",\"children\":\"GORM connection documentation\"}],\".\"]}]\n83:[\"$\",\"h2\",null,{\"id\":\"defining-models\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 t"])</script><script>self.__next_f.push([1,"racking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Defining Models\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#defining-models\",\"aria-label\":\"Link to Defining Models\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n84:[\"$\",\"p\",null,{\"children\":\"In GORM, models are Go structs that represent tables in your database. Each field in the struct maps to a column in the table, and GORM uses struct tags (annotations enclosed in backticks) to configure how these fields are handled in the database.\"}]\n85:[\"$\",\"p\",null,{\"children\":[\"Let's create a simple blogging application with \",[\"$\",\"code\",null,{\"children\":\"User\"}],\" and \",[\"$\",\"code\",null,{\"children\":\"Post\"}],\" models. These models will define the structure of our database tables and establish relationships between them.\"]}]\n87:[\"$\",\"p\",null,{\"children\":\"Let's examine the key components of these models:\"}]\n"])</script><script>self.__next_f.push([1,"88:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Basic Fields\"}],\": \",[\"$\",\"code\",null,{\"children\":\"ID\"}],\", \",[\"$\",\"code\",null,{\"children\":\"CreatedAt\"}],\", \",[\"$\",\"code\",null,{\"children\":\"UpdatedAt\"}],\", and \",[\"$\",\"code\",null,{\"children\":\"DeletedAt\"}],\" are standard fields in GORM models. They handle primary keys, timestamps, and soft deletion.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Field Tags\"}],\": The struct tags like \",[\"$\",\"code\",null,{\"children\":\"gorm:\\\"size:255;not null\\\"\"}],\" define constraints and properties for each field:\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"primaryKey\"}],\": Designates a field as the table's primary key\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"size:255\"}],\": Sets the column's maximum length\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"not null\"}],\": Ensures the field cannot be empty\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"uniqueIndex\"}],\": Creates a unique index on the column\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"type:text\"}],\": Specifies the SQL data type\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Relationships\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Posts\"}],\" field in the User model and the \",[\"$\",\"code\",null,{\"children\":\"User\"}],\" field in the Post model establish a one-to-many relationship. The \",[\"$\",\"code\",null,{\"children\":\"foreignKey\"}],\" tag specifies which field serves as the foreign key.\"]}],\"\\n\"]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"89:[\"$\",\"p\",null,{\"children\":[\"By default, GORM will pluralize struct names to create table names (e.g., \\\"User\\\" becomes \\\"users\\\"), but you can customize this using the \",[\"$\",\"code\",null,{\"children\":\"TableName\"}],\" method or the \",[\"$\",\"code\",null,{\"children\":\"gorm:\\\"tableName:custom_name\\\"\"}],\" tag. This is similar to how other ORMs like Sequelize and Eloquent work.\"]}]\n8a:[\"$\",\"p\",null,{\"children\":\"GORM provides sensible defaults for table names (pluralized struct names) and column names (field names), but you can customize these using struct tags.\"}]\n8b:[\"$\",\"h2\",null,{\"id\":\"automatic-migrations\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Automatic Migrations\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#automatic-migrations\",\"aria-label\":\"Link to Automatic Migrations\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n8c:[\"$\",\"p\",null,{\"children\":[\"Migrations are a way to manage database schema changes over time. GORM provides a convenient \",[\"$\",\"code\",null,{\"children\":\"AutoMigrate\"}],\" feature that automatically creates tables, indexes, constraints, and foreign keys based on your model definitions.\"]}]\n8d:[\"$\",\"p\",null,{\"children\":\"While this automation is extremely useful during development, it's worth noting that for production environments, you'll typically want more control over schema changes. We'll cover structured migrations for production later in this guide, but for now, let's see how to use GORM's automatic migrations for development.\"}]\n8e:[\"$\",\"p\",null,{\"children\":\"Here's how to set up automatic migrations:\"}]\n90:[\"$\",\"p\",null,{\"children\":\"When you run this code, GORM will:\"}]\n91:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Check if the tables exist, and create them if they don't\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Add missing columns to existing tables\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Create indexes and constraints\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Establish foreign key relationships between tables\"}],\"\\n\"]}]\n92:[\"$\",\"p\",null,{\"children\":[\"The \",[\"$\",\"code\",null,{\"children\":\"AutoMigrate\"}],\" function works by comparing your Go struct definitions to the actual database schema and making necessary changes to align them. It accepts a list of model struct pointers and returns an error if something goes wrong.\"]}]\n93:[\"$\",\"p\",null,{\"children\":[\"Note that \",[\"$\",\"code\",null,{\"children\":\"AutoMigrate\"}],\" only adds things that are missing; it won't delete columns or tables that exist in the database but not in your models. This is a safety feature to prevent accidental data loss.\"]}]\n94:[\"$\",\"p\",null,{\"children\":\"This will create the necessary tables if they don't exist and update them to match your model definitions.\"}]\n95:[\"$\",\"h2\",null,{\"id\":\"basic-crud-operations\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Basic CRUD Operations\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#basic-crud-operations\",\"aria-label\":\"Link to Basic CRUD Operations\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n96:[\"$\",\"p\",null,{\"children\":\"Now that we have our models and databa"])</script><script>self.__next_f.push([1,"se connection set up, let's perform basic Create, Read, Update, and Delete (CRUD) operations:\"}]\n97:[\"$\",\"h3\",null,{\"id\":\"creating-records\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Creating Records\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#creating-records\",\"aria-label\":\"Link to Creating Records\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n98:[\"$\",\"p\",null,{\"children\":[\"Now that we have our models defined and tables created, let's start adding data to our database. GORM makes it straightforward to create new records with the \",[\"$\",\"code\",null,{\"children\":\"Create\"}],\" method.\"]}]\n99:[\"$\",\"p\",null,{\"children\":\"Let's add a user and a blog post to our database:\"}]\n9b:[\"$\",\"p\",null,{\"children\":\"Here's what happens in this code:\"}]\n9c:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"We create a new \",[\"$\",\"code\",null,{\"children\":\"User\"}],\" struct instance with basic information\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"We pass a pointer to this struct to the \",[\"$\",\"code\",null,{\"children\":\"db.Create()\"}],\" method, which inserts it into the database\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"GORM automatically handles generating the primary key ID, timestamps, and other default values\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"After successful creation, the user's generated ID is populated in the \",[\"$\",\"code\",null,{\"children\":\"user.ID\"}],\" field\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"We then create a \",[\"$\",\"code\",null,{\"children\":\"Post\"}],\" struct, setting the \",[\"$\",\"code\",null,{\"children\":\"UserID\"}],\" field to establish the relationship with our user\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"We insert the post into the database using the same \",[\"$\",\"code\",null,{\"children\":\"Create\"}],\" method\"]}],\"\\n\"]}]\n9d:[\"$\",\"p\",null,{\"children\":[\"Notice how GORM returns a \",[\"$\",\"code\",null,{\"children\":\"result\"}],\" object that contains an \",[\"$\",\"code\",null,{\"children\":\"Error\"}],\" field. Always check this field to ensure your database operations succeeded. The result object also provides other useful information like the number of rows affected by the operation.\"]}]\n9e:[\"$\",\"h3\",null,{\"id\":\"reading-records\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Reading Records\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#reading-records\",\"aria-label\":\"Link to Reading Records\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n9f:[\"$\",\"p\",null,{\"children\":\"Reading data from the database is one of the most common operations in any application. GORM provides several methods for retrieving data, from simple lookups to complex queries.\"}]\na0:[\"$\",\"p\",null,{\"children\":\"Let's look at different ways to retrieve data from our database:\"}]\na2:[\"$\",\"p\",null,{\"children\":\"Let's break down these query operations:\"}]\na3:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Simple Retrieval\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"First\"}],\" method retrieves the first record that matches the condition. In our first example, we're finding a user by their ID"])</script><script>self.__next_f.push([1,", which should return exactly one record since IDs are unique.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Eager Loading with Preload\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Preload\"}],\" method allows us to load related records in a single query. In our second example, we load a user and all their posts in one go. This is more efficient than performing separate queries for the user and their posts.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Conditional Queries with Where\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Where\"}],\" method allows us to specify conditions for our queries. In our third example, we're using the SQL \",[\"$\",\"code\",null,{\"children\":\"LIKE\"}],\" operator to find users whose names contain \\\"John\\\". The \",[\"$\",\"code\",null,{\"children\":\"?\"}],\" is a placeholder that helps prevent SQL injection attacks.\"]}],\"\\n\"]}],\"\\n\"]}]\na4:[\"$\",\"p\",null,{\"children\":\"GORM provides many other query methods that we haven't covered here, such as:\"}]\na5:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Last\"}],\": Retrieves the last record matching the condition\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Take\"}],\": Retrieves a record without any specified order\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Pluck\"}],\": Retrieves a single column from the database as a slice\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Count\"}],\": Returns the number of records matching the condition\"]}],\"\\n\"]}]\na6:[\"$\",\"p\",null,{\"children\":[\"All these methods return a result object that contains an \",[\"$\",\"code\",null,{\"children\":\"Error\"}],\" field, which should be checked to ensure the query was successful.\"]}]\na7:[\"$\",\"h3\",null,{\"id\":\"updating-records\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Updating Records\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#updating-records\",\"aria-label\":\"Link to Updating Records\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\na8:[\"$\",\"p\",null,{\"children\":\"GORM provides several methods for updating records in the database. You can update a single field, multiple fields, or even use more complex update operations.\"}]\na9:[\"$\",\"p\",null,{\"children\":\"Let's look at how to update our user and post records:\"}]\nab:[\"$\",\"p\",null,{\"children\":\"Here's what's happening in these update operations:\"}]\nac:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Single Field Update\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Update\"}],\" method allows us to change a single column's value. In the first example, we're updating the user's email address. We use the \",[\"$\",\"code\",null,{\"children\":\"Model\"}],\" method to specify which record to update (based on its primary key).\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Multiple Field Update\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Updates\"}],\" method allows us to change multiple columns at once. We provide a struct with the fields we want to update. Note that GORM will only update non-zero fields by default, which means fields with their zero values (empty string, 0, false, etc.) won't be updated unless you use \",[\"$\",\"code\",null,{\"children\":\"Updates\"}],\" with a map.\"]}],\"\\n\"]}],\"\\n\"]}]\nad:[\"$\",\"p\",null,{\"children\":\"GORM also offers other update methods:\"}]\nae:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,"])</script><script>self.__next_f.push([1,"{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Update with conditions\"}],\": \",[\"$\",\"code\",null,{\"children\":\"db.Model(\u0026User{}).Where(\\\"name = ?\\\", \\\"john\\\").Update(\\\"name\\\", \\\"jane\\\")\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Batch updates\"}],\": \",[\"$\",\"code\",null,{\"children\":\"db.Table(\\\"users\\\").Where(\\\"role = ?\\\", \\\"admin\\\").Update(\\\"active\\\", true)\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Raw SQL updates\"}],\": \",[\"$\",\"code\",null,{\"children\":\"db.Exec(\\\"UPDATE users SET name = ? WHERE age \u003e ?\\\", \\\"Jane\\\", 20)\"}]]}],\"\\n\"]}]\naf:[\"$\",\"p\",null,{\"children\":[\"When updating records, GORM automatically sets the \",[\"$\",\"code\",null,{\"children\":\"UpdatedAt\"}],\" field to the current time if your model includes this field. This helps track when records were last modified.\"]}]\nb0:[\"$\",\"h3\",null,{\"id\":\"deleting-records\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Deleting Records\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#deleting-records\",\"aria-label\":\"Link to Deleting Records\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\nb1:[\"$\",\"p\",null,{\"children\":\"GORM provides two types of deletion: soft deletion and hard deletion. Soft deletion marks records as deleted without actually removing them from the database, while hard deletion permanently removes records.\"}]\nb2:[\"$\",\"p\",null,{\"children\":\"Let's see how to perform both types of deletions:\"}]\nb4:[\"$\",\"p\",null,{\"children\":\"Here's what's happening in these deletion operations:\"}]\nb5:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Soft Deletion\"}],\": When we call \",[\"$\",\"code\",null,{\"children\":\"Delete\"}],\" on a model that has a \",[\"$\",\"code\",null,{\"children\":\"DeletedAt\"}],\" field (like our models do thanks to \",[\"$\",\"code\",null,{\"children\":\"gorm.Model\"}],\"), GORM performs a soft delete. This doesn't actually remove the record from the database; instead, it sets the \",[\"$\",\"code\",null,{\"children\":\"DeletedAt\"}],\" field to the current time. Subsequent queries will automatically exclude these \\\"deleted\\\" records unless you explicitly include them.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Hard Deletion\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Unscoped\"}],\" method tells GORM to ignore the soft delete mechanism and perform a true deletion, permanently removing the record from the database. This is used when you really want to delete data, not just hide it.\"]}],\"\\n\"]}],\"\\n\"]}]\nb6:[\"$\",\"p\",null,{\"children\":\"Soft deletion is particularly useful for:\"}]\nb7:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Keeping an audit trail of records\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Allowing data to be restored if deleted accidentally\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Maintaining referential integrity in related data\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Meeting regulatory requirements that prohibit true deletion\"}],\"\\n\"]}]\nb8:[\"$\",\"p\",null,{\"children\":[\"By default, GORM queries won't return soft-deleted records. If you need to include them, you can use the \",[\"$\",\"code\",null,{\"children\":\"Unscoped\"}],\" method: \",[\"$\",\"code\",null,{\"children\":\"db.Unscoped().Where(\\\"name = ?\\\", \\\"John\\\").Find(\u0026users)\"}],\".\"]}]\nb9:[\"$\",\"h2\",null,{\"id\":\"advanced-gorm-features\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Advanced GORM Features\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-"])</script><script>self.__next_f.push([1,"full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#advanced-gorm-features\",\"aria-label\":\"Link to Advanced GORM Features\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\nba:[\"$\",\"p\",null,{\"children\":\"With the basics covered, let's explore some advanced features of GORM that can help you build more robust and efficient applications.\"}]\nbb:[\"$\",\"h3\",null,{\"id\":\"transactions\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Transactions\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#transactions\",\"aria-label\":\"Link to Transactions\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\nbc:[\"$\",\"p\",null,{\"children\":\"Transactions are a way to group multiple database operations into a single unit of work. They ensure that either all operations succeed or none of them do, maintaining data consistency. This is especially important when you have multiple related changes that need to happen together.\"}]\nbd:[\"$\",\"p\",null,{\"children\":\"GORM provides comprehensive support for database transactions:\"}]\nbf:[\"$\",\"p\",null,{\"children\":\"Let's break down how transactions work in GORM:\"}]\nc0:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Begin a Transaction\"}],\": The \",[\"$\",\"code\",null,{\"children\":\"Begin\"}],\" method starts a new transaction and returns a transaction object.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Perform Operations\"}],\": Use the transaction object (instead of the regular db object) to perform database operations. All operations will be part of the transaction.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Rollback or Commit\"}],\": If any operation fails, call \",[\"$\",\"code\",null,{\"children\":\"Rollback\"}],\" to cancel all changes. If all operations succeed, call \",[\"$\",\"code\",null,{\"children\":\"Commit\"}],\" to permanently apply the changes to the database.\"]}],\"\\n\"]}]\nc1:[\"$\",\"p\",null,{\"children\":\"Transactions are essential in scenarios like:\"}]\nc2:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Creating a user and their profile simultaneously\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Transferring funds between accounts\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Processing an order with multiple line items\"}],\"\\n\"]}]\nc3:[\"$\",\"p\",null,{\"children\":\"They help maintain data integrity by ensuring that related operations either all succeed or all fail, preventing partial updates that could leave your database in an inconsistent state.\"}]\nc4:[\"$\",\"p\",null,{\"children\":\"For a more elegant and concise approach, GORM provides a transaction helper method that automatically handles the begin, commit, and rollback operations:\"}]\nc6:[\"$\",\"p\",null,{\"children\":\"This approach is generally preferred for several reasons:\"}]\nc7:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Simplified Error Handling\"}],\": You simply return an error from the closure function, and GORM automatically rolls back the transaction if an error is returned.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Cleaner Code\"}],\": The transaction logic is encapsulated in a single function, making the code more readable.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong"])</script><script>self.__next_f.push([1,"\",null,{\"children\":\"Automatic Resource Management\"}],\": GORM ensures that the transaction is properly closed whether it succeeds or fails, preventing resource leaks.\"]}],\"\\n\"]}]\nc8:[\"$\",\"p\",null,{\"children\":\"With this method, you focus on the business logic inside the transaction rather than managing the transaction lifecycle. If the function returns nil, the transaction is committed; if it returns an error, the transaction is rolled back automatically.\"}]\nc9:[\"$\",\"h3\",null,{\"id\":\"raw-sql-and-complex-queries\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Raw SQL and Complex Queries\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#raw-sql-and-complex-queries\",\"aria-label\":\"Link to Raw SQL and Complex Queries\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\nca:[\"$\",\"p\",null,{\"children\":\"While GORM's built-in query methods are powerful and cover most common scenarios, sometimes you need more control or have complex requirements that are best expressed in raw SQL. GORM provides several ways to work with raw SQL while still benefiting from its safety features and result handling.\"}]\ncb:[\"$\",\"p\",null,{\"children\":\"Here are different approaches to executing raw SQL and complex queries:\"}]\ncd:[\"$\",\"p\",null,{\"children\":\"Let's examine these different approaches:\"}]\nce:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Raw SQL with Generic Results\"}],\": The first example executes a raw SQL query and scans the results into a slice of maps. This is useful when you don't have a predefined struct for the result or need flexibility in handling different result shapes.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Raw SQL with Model Mapping\"}],\": The second example shows how you can execute raw SQL but still map the results to your model structs. GORM handles the mapping between column names and struct fields.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Query Builder API\"}],\": The third example demonstrates GORM's query builder API, which provides a fluent interface for constructing complex queries. This approach offers:\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Type safety and IDE auto-completion\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"SQL injection protection with parameter placeholders\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Readability for complex queries\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"The ability to build queries dynamically based on conditions\"}],\"\\n\"]}],\"\\n\"]}],\"\\n\"]}]\ncf:[\"$\",\"p\",null,{\"children\":\"When should you use raw SQL versus GORM's query builder?\"}]\nd0:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Use raw SQL when\"}],\": You have complex queries that are difficult to express with the query builder, or when you're optimizing performance with database-specific features.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Use the query builder when\"}],\": You want type safety, need to build queries dynamically, or prefer a more Go-idiomatic approach.\"]}],\"\\n\"]}]\nd1:[\"$\",\"p\",null,{\"children\":\"In either case, GORM handles parameter binding to protect against SQL injection, making both approaches secure when used correctly.\"}]\nd2:[\"$\",\"h3\",null,{\"id\":\"hooks\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Hooks\"]}],["])</script><script>self.__next_f.push([1,"\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#hooks\",\"aria-label\":\"Link to Hooks\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\nd3:[\"$\",\"p\",null,{\"children\":\"Hooks (also known as callbacks) are functions that are called at specific stages of the database operation lifecycle. They allow you to inject custom logic before or after these operations, such as validation, data transformation, or triggering side effects.\"}]\nd4:[\"$\",\"p\",null,{\"children\":[\"GORM provides a comprehensive set of hooks for various operations, you can find the full list of hooks in the \",[\"$\",\"$L64\",null,{\"href\":\"https://gorm.io/docs/hooks.html\",\"children\":\"GORM documentation\"}],\". But let's look at a couple of common hooks:\"]}]\nd6:[\"$\",\"p\",null,{\"children\":\"Hooks are a great way to keep your business logic consistent and avoid duplicating code across your application. By defining these methods directly on your model structs, the behavior is encapsulated with the data it operates on.\"}]\nd7:[\"$\",\"h2\",null,{\"id\":\"structured-migrations-for-production\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Structured Migrations for Production\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#structured-migrations-for-production\",\"aria-label\":\"Link to Structured Migrations for Production\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\nd8:[\"$\",\"p\",null,{\"children\":[\"While \",[\"$\",\"code\",null,{\"children\":\"AutoMigrate\"}],\" is convenient for development, production systems need more controlled migration management. In production environments, you need precise control over when and how database changes occur, with the ability to roll back changes if something goes wrong.\"]}]\nd9:[\"$\",\"p\",null,{\"children\":[[\"$\",\"$L64\",null,{\"href\":\"https://github.com/golang-migrate/migrate\",\"children\":\"Golang-migrate\"}],\" is a popular migration tool for Go applications that provides version-controlled, reversible database migrations. Let's set up proper migrations using this tool:\"]}]\n"])</script><script>self.__next_f.push([1,"da:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":\"Install the migrate CLI:\"}],\"\\n\",\"$L105\",\"\\n\",[\"$\",\"p\",null,{\"children\":\"This installs the migration tool globally on your system, allowing you to run migrations from the command line.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Create the \",[\"$\",\"code\",null,{\"children\":\"migrations\"}],\" directory:\"]}],\"\\n\",\"$L106\",\"\\n\",[\"$\",\"p\",null,{\"children\":\"This directory will store all your migration files in a structured, version-controlled format.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":\"Create your first migration:\"}],\"\\n\",\"$L107\",\"\\n\",[\"$\",\"p\",null,{\"children\":[\"This creates two files: an \\\"up\\\" migration for applying changes and a \\\"down\\\" migration for reverting them. The \",[\"$\",\"code\",null,{\"children\":\"-seq\"}],\" flag ensures migrations are numbered sequentially, which helps maintain the order of execution.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Edit the up migration (\",[\"$\",\"code\",null,{\"children\":\"migrations/000001_create_users_table.up.sql\"}],\"):\"]}],\"\\n\",\"$L108\",\"\\n\",[\"$\",\"p\",null,{\"children\":\"The \\\"up\\\" migration contains SQL to create new database objects or modify existing ones. Here, we're creating a users table with the necessary columns and an index.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Edit the down migration (\",[\"$\",\"code\",null,{\"children\":\"migrations/000001_create_users_table.down.sql\"}],\"):\"]}],\"\\n\",\"$L109\",\"\\n\",[\"$\",\"p\",null,{\"children\":\"The \\\"down\\\" migration contains SQL to undo the changes made by the corresponding \\\"up\\\" migration. This ensures you can roll back changes if needed. In this case, we're dropping the users table.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":\"Create a migration for the posts table:\"}],\"\\n\",\"$L10a\",\"\\n\",[\"$\",\"p\",null,{\"children\":\"Now we'll create the second migration for the posts table, which depends on the users table created in the first migration.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Edit the up migration (\",[\"$\",\"code\",null,{\"children\":\"migrations/000002_create_posts_table.up.sql\"}],\"):\"]}],\"\\n\",\"$L10b\",\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Note the foreign key reference to the users table (\",[\"$\",\"code\",null,{\"children\":\"REFERENCES users(id)\"}],\"). This ensures referential integrity between the two tables.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Edit the down migration (\",[\"$\",\"code\",null,{\"children\":\"migrations/000002_create_posts_table.down.sql\"}],\"):\"]}],\"\\n\",\"$L10c\",\"\\n\",[\"$\",\"p\",null,{\"children\":\"Again, the down migration simply drops the table to reverse the changes.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":\"Run the migrations:\"}],\"\\n\",\"$L10d\",\"\\n\",[\"$\",\"p\",null,{\"children\":[\"This command applies all pending migrations to your database. The \",[\"$\",\"code\",null,{\"children\":\"up\"}],\" argument tells the tool to apply migrations that haven't been applied yet. You can also use \",[\"$\",\"code\",null,{\"children\":\"down\"}],\" to reverse migrations, or specify a version number to migrate to a specific version.\"]}],\"\\n\"]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"db:[\"$\",\"p\",null,{\"children\":[\"The migrate tool keeps track of which migrations have been applied in a special table called \",[\"$\",\"code\",null,{\"children\":\"schema_migrations\"}],\" in your database. This ensures that migrations are only applied once and in the correct order.\"]}]\ndc:[\"$\",\"p\",null,{\"children\":\"For more complex applications, you might want to create a Go function to run migrations programmatically. This approach offers several advantages:\"}]\ndd:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Migrations can be run as part of your application startup\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"The same code can be used in different environments (development, staging, production)\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"You can implement custom logic around migrations, like waiting for the database to be ready\"}],\"\\n\"]}]\nde:[\"$\",\"p\",null,{\"children\":\"Here's how to create a Go function to run migrations programmatically:\"}]\ne0:[\"$\",\"p\",null,{\"children\":\"This function:\"}]\ne1:[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Creates a new migration instance that reads migration files from the local filesystem\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Configures the database connection using your Neon credentials\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Runs all pending migrations with \",[\"$\",\"code\",null,{\"children\":\"m.Up()\"}]]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Handles errors appropriately, distinguishing between actual errors and the \\\"no changes\\\" case\"}],\"\\n\"]}]\ne2:[\"$\",\"p\",null,{\"children\":\"You would typically call this function early in your application's startup process, before initializing your GORM instance. This ensures that your database schema is up-to-date before your application starts using it.\"}]\ne3:[\"$\",\"p\",null,{\"children\":\"For more advanced scenarios, you might want to add features like:\"}]\ne4:[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Checking database connectivity before running migrations\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Adding retry logic for transient connection issues\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Implementing a \\\"migrate and seed\\\" function for development environments\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Adding version reporting to track which migrations have been applied\"}],\"\\n\"]}]\ne5:[\"$\",\"h2\",null,{\"id\":\"performance-optimization-with-neon\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Performance Optimization with Neon\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#performance-optimization-with-neon\",\"aria-label\":\"Link to Performance Optimization with Neon\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3.5\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\ne6:[\"$\",\"p\",null,{\"children\":\"When working with Neon and GORM, consider these performance optimization techniques:\"}]\ne7:[\"$\",\"h3\",null,{\"id\":\"efficient-querying\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Efficient Querying\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#efficient-querying\",\"aria-label\":\"Link to Efficient Querying\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\