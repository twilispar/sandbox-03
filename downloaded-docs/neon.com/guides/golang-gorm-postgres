n find these by clicking the \",[\"$\",\"strong\",null,{\"children\":\"Connect\"}],\" button on your Neon \",[\"$\",\"strong\",null,{\"children\":\"Project Dashboard\"}],\".\"]}]\n79:[\"$\",\"h3\",null,{\"id\":\"connection-pooling-and-configuration\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Connection Pooling and Configuration\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#connection-pooling-and-configuration\",\"aria-label\":\"Link to Connection Pooling and Configuration\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"none\",\"viewBox\":\"0 0 14 14\",\"className\":\"inline text-green-44 dark:text-green-52 w-3\",\"children\":\"$5a:4:props:children:1:props:children:props:children\"}]}]]}]\n7a:[\"$\",\"p\",null,{\"children\":\"Connection pooling is a technique that maintains a set of reusable database connections. This significantly improves performance by avoiding the overhead of establishing a new database connection for each operation.\"}]\n7b:[\"$\",\"h4\",null,{\"id\":\"neon-connection-pooling\",\"className\":\"anchor-heading group relative w-fit scroll-mt-20 leading-tight font-m"])</script><script>self.__next_f.push([1,"edium lg:scroll-mt-5 tracking-extra-tight\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"Neon Connection Pooling\"]}],[\"$\",\"a\",null,{\"className\":\"rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden\",\"href\":\"#neon-connection-pooling\",\"aria-label\":\"Link to Neon Connection Poo