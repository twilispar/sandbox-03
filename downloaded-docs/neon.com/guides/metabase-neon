<span class="line" data-line="11"><span style="color:var(--shiki-token-comment)">-- Create products table</span></span>
<span class="line" data-line="12"><span style="color:var(--shiki-token-keyword)">CREATE</span><span style="color:var(--shiki-token-keyword)"> TABLE</span><span style="color:var(--shiki-token-function)"> products</span><span style="color:var(--shiki-foreground)"> (</span></span>
