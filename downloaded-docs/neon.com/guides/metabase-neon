<span class="line" data-line="5"><span style="color:var(--shiki-foreground)">    email </span><span style="color:var(--shiki-token-keyword)">VARCHAR</span><span style="color:var(--shiki-foreground)">(</span><span style="color:var(--shiki-token-constant)">255</span><span style="color:var(--shiki-foreground)">) </span><span style="color:var(--shiki-token-keyword)">UNIQUE</span><span style="color:var(--shiki-foreground)">,</span></span>
