<span class="line" data-line="23"><span style="color:var(--shiki-foreground)">    order_id </span><span style="color:var(--shiki-token-keyword)">SERIAL</span><span style="color:var(--shiki-token-keyword)"> PRIMARY KEY</span><span style="color:var(--shiki-foreground)">,</span></span>
