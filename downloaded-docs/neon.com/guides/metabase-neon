<span class="line" data-line="28"><span style="color:var(--shiki-foreground)">    created_at </span><span style="color:var(--shiki-token-keyword)">TIMESTAMP WITH TIME ZONE</span><span style="color:var(--shiki-token-keyword)"> DEFAULT</span><span style="color:var(--shiki-foreground)"> CURRENT_TIMESTAMP</span></span>
<span class="line" data-line="29"><span style="color:var(--shiki-foreground)">);</span></span>
<span class="line" data-line="30"></span>
<span class="line" data-line="31"><span style="color:var(--shiki-token-comment)">-- Create order_items table</span></span>
<span class="line" data-line="32"><span style="color:var(--shiki-token-keyword)">CREATE</span><span style="color:var(--shiki-token-keyword)"> TABLE</span><span style="color:var(--shiki-token-function)"> order_items</span><span style="color:var(--shiki-foreground)"> (</span></span>
<span class="line" data-line="33"><span style="color:var(--shiki-foreground)">    order_item_id </span><span style="color:var(--shiki-token-keyword)">SERIAL</span><span style="color:var(--shiki-token-keyword)"> PRIMARY KEY</span><span style="color:var(--shiki-foreground)">,</span></span>
<span class="line" data-line="34"><span style="color:var(--shiki-foreground)">    order_id </span><span style="color:var(--shiki-token-keyword)">INT</span><span style="color:var(--shiki-token-keyword)"> REFERENCES</span><span style="color:var(--shiki-foreground)"> orders(order_id),</span></span>
