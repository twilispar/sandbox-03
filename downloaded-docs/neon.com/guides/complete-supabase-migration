 top-4 left-[5px] block h-0.5 w-[22px] bg-current" style="transform-origin:50% 50%;will-change:transform, opacity;transform:rotate(0deg) scaleX(0.95);opacity:0"></span><span class="absolute top-4 left-[5px] block h-0.5 w-[22px] bg-current" style="transform-origin:50% 50%;will-change:transform, opacity;transform:rotate(0deg) scaleX(0.95);opacity:0"></span></button></div><main class="flex flex-1 flex-col"><div class="flex flex-1 safe-paddings dark:bg-black-pure dark:text-white lg:flex-col"><aside aria-label="Agent directive" class="sr-only">Full Neon documentation index:<!-- --> <a href="https://neon.com/docs/llms.txt">https://neon.com/docs/llms.txt</a></aside><div class="relative mx-auto lg:max-w-none lg:px-8 md:px-5 max-w-[1856px] px-8 flex w-full flex-1 gap-x-24 pt-12 2xl:gap-x-8 xl:pt-9 lg:block sm:pt-7"><aside class="relative -mt-12 xl:hidden w-[312px] shrink-0 lg:hidden"><div class="sticky top-28"><div class="relative after:pointer-events-none after:absolute after:inset-x-0 after:top-0 after:h-10 after:bg-linear-to-b after:from-white after:to-transparent dark:after:from-black-pure dark:after:to-transparent"><nav class="z-10 -mx-1 no-scrollbars h-[calc(100vh-7rem)] overflow-y-scroll pt-11 pr-8 pb-16 pl-1"></nav></div></div></aside><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"The Complete Supabase to Neon Database & Auth Migration Guide","author":{"@type":"Organization","name":"Neon"}}</script><div class="mx-auto min-w-0 pb-32 lg:pb-24 md:pb-20 max-w-208 lg:max-w-none"><div class="mb-7 flex flex-wrap items-center gap-x-1.5 text-[15px] leading-none tracking-extra-tight text-gray-new-40 dark:text-gray-new-60 mb-7!"><a class="transition-colors duration-200 hover:text-black dark:hover:text-white rounded-sm" href="/docs"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M14 7.6 8 2 2 7.6M3.6 8.4V14h3.2v-3.2h2.4V14h3.2V8.4"></path></svg></a><span>/</span><a class="transition-colors duration-200 hover:text-black dark:hover:text-white rounded-sm" href="/docs/community/community-intro">Community</a><span>/</span><a class="transition-colors duration-200 hover:text-black dark:hover:text-white rounded-sm" href="/guides">Guides</a></div><article><div class="flex items-start justify-between gap-6 sm:flex-col sm:items-stretch sm:gap-4"><div class="max-w-xl 2xl:max-w-[520px]"><h1 class="text-[36px] leading-tight font-medium tracking-tighter text-balance md:text-[28px]">The Complete Supabase to Neon Database &amp; Auth Migration Guide</h1><p class="mt-[1.125rem] text-xl leading-tight tracking-extra-tight text-gray-new-40 dark:text-gray-new-70 md:mt-1.5 md:text-lg">A comprehensive guide to migrating your Postgres database, user accounts, and RLS policies from Supabase to Neon</p></div><div class="relative mt-2.5 w-fit sm:mt-0"><div class="flex items-center border border-gray-new-90 dark:border-gray-new-20"><button class="flex h-8 w-fit shrink-0 items-center gap-2 border-r border-gray-new-90 px-2.5 whitespace-nowrap text-black-new hover:bg-gray-new-98 dark:border-gray-new-20 dark:text-gray-new-94 dark:hover:bg-gray-new-8"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="size-4 shrink-0"><g clip-path="url(#copy-docs_inline_svg__a)"><mask id="copy-docs_inline_svg__b" width="16" height="16" x="0" y="0" maskUnits="userSpaceOnUse" style="mask-type:luminance"><path fill="#fff" d="M0 0h16v16H0z"></path></mask><g stroke="currentColor" mask="url(#copy-docs_inline_svg__b)"><path d="M5.947 14.63h8.683V5.945H5.947z"></path><path d="M3.579 10.684H2V2h8.683v1.579"></path></g></g><defs><clipPath id="copy-docs_inline_svg__a"><path fill="#fff" d="M0 0h16v16H0z"></path></clipPath></defs></svg><span class="text-sm leading-none tracking-extra-tight whitespace-nowrap">Copy page</span></button><button class="flex h-8 items-center px-1 hover:bg-gray-new-98 dark:hover:bg-gray-new-8"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" fill="none" viewBox="0 0 14 15" class="size-3.5 text-gray-new-50 transition-transform duration-200 dark:text-gray-new-50"><path stroke="currentColor" stroke-width="1.5" d="M3.5 5.75 7 9.25l3.5-3.5"></path></svg></button></div></div></div><div class="prose-doc post-content prose dark:prose-invert xs:prose-code:break-words mt-10 lg:mt-7 md:mt-5"><p>This guide walks you through migrating your Postgres database, user accounts, and Row-Level Security (RLS) policies from Supabase to Neon. It addresses key differences between the platforms, including the reassignment of <code>user_id</code> values during the auth migration, and provides steps to remap IDs, restore data integrity, and update your application code.</p>
<h3 id="prerequisites" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Prerequisites</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#prerequisites" aria-label="Link to Prerequisites"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<p>Before you begin, ensure you have the following:</p>
<ul>
<li>An active Supabase project.</li>
<li>A Neon project. For setup instructions, see <a class="" href="/docs/manage/projects#create-a-project">Create a project</a>.</li>
<li>The PostgreSQL <code>psql</code> and <code>pg_dump</code> command-line utilities installed locally.</li>
<li>A Node.js environment (for running the user import script).</li>
</ul>
<ol class="numbered-steps mt-6! inline-flex w-full flex-col pl-0!" style="counter-reset:section"><li class="numbered-step relative mt-8! mb-0! flex w-full items-start gap-4 pl-0! before:flex before:size-7 before:items-center before:justify-center before:rounded-full before:bg-gray-new-20 before:text-center before:font-mono before:text-sm before:leading-snug before:font-medium before:tracking-tight before:text-white before:content-[counter(section)] before:[counter-increment:section] after:absolute after:top-8 after:-bottom-7 after:left-[.8125rem] after:w-px after:bg-gray-new-90 first:mt-0! last:after:bottom-0 dark:before:bg-gray-new-90 dark:before:text-black-pure dark:after:bg-gray-new-30 [&amp;_h2]:text-2xl [&amp;_ol]:list-decimal!"><div class="w-[calc(100%-100px)] flex-1 [&amp;&gt;*_*:last-child]:mb-0 [&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:first-child]:pt-0 md:[&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0"><h2 id="part-1-data-and-authentication-migration" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter"><span>Part 1: Data and Authentication migration</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#part-1-data-and-authentication-migration" aria-label="Link to Part 1: Data and Authentication migration"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3.5"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h2><p>This part covers the migration of your user accounts and public schema data, followed by remapping user IDs to restore data integrity.</p><h3 id="step-1-migrate-user-accounts-from-supabase-to-neon-auth" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Step 1: Migrate user accounts from Supabase to Neon Auth</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#step-1-migrate-user-accounts-from-supabase-to-neon-auth" aria-label="Link to Step 1: Migrate user accounts from Supabase to Neon Auth"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3><p>If your project does not use Supabase Auth, you can skip this section.</p><p>Supabase Auth is the authentication system used by Supabase. It manages user accounts, passwords, and session tokens.</p><h4 id="11-export-users-and-password-hashes-from-supabase" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>1.1: Export users and password hashes from Supabase</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#11-export-users-and-password-hashes-from-supabase" aria-label="Link to 1.1: Export users and password hashes from Supabase"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h4><p>Connect to your Supabase project using the SQL Editor in the dashboard and run the following SQL function. This function retrieves all user emails and their encrypted <strong>bcrypt</strong> password hashes.</p><figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">CREATE OR REPLACE</span><span style="color:var(--shiki-token-keyword)"> FUNCTION</span><span style="color:var(--shiki-token-function)"> ufn_get_user_emails_and_passwords</span><span style="color:var(--shiki-foreground)">()</span></span>
<span class="line" data-line="2"><span style="color:var(--shiki-token-keyword)">RETURNS</span><span style="color:var(--shiki-token-keyword)"> table</span><span style="color:var(--shiki-foreground)"> (email </span><span style="color:var(--shiki-token-keyword)">text</span><span style="color:var(--shiki-foreground)">, encrypted_password </span><span style="color:var(--shiki-token-keyword)">character varying</span><span style="color:var(--shiki-foreground)">(</span><span style="color:var(--shiki-token-constant)">255</span><span style="color:var(--shiki-foreground)">)) </span><span style="color:var(--shiki-token-keyword)">AS</span></span>
<span class="line" data-line="3"><span style="color:var(--shiki-foreground)">$$</span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-token-keyword)">BEGIN</span></span>
