und);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">SELECT</span><span style="color:var(--shiki-token-keyword)"> *</span></span>
