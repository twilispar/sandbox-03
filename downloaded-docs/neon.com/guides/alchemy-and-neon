<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="typescript"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">const</span><span style="color:var(--shiki-token-constant)"> uniqueName</span><span style="color:var(--shiki-token-keyword)"> =</span><span style="color:var(--shiki-token-string-expression)"> `feature-</span><span style="color:var(--shiki-token-keyword)">${</span><span style="color:var(--shiki-foreground)">featureName</span><span style="color:var(--shiki-token-keyword)">}</span><span style="color:var(--shiki-token-string-expression)">-</span><span style="color:var(--shiki-token-keyword)">${</span><span style="color:var(--shiki-token-keyword)">new</span><span style="color:var(--shiki-token-function)"> Date</span><span style="color:var(--shiki-foreground)">()</span><span style="color:var(--shiki-token-function)">.toISOString</span><span style="color:var(--shiki-foreground)">()</span><span style="color:var(--shiki-token-function)">.split</span><span style="color:var(--shiki-foreground)">(</span><span style="color:var(--shiki-token-string-expression)">&#x27;T&#x27;</span><span style="color:var(--shiki-foreground)">)[</span><span style="color:var(--shiki-token-constant)">0</span><span style="color:var(--shiki-foreground)">]</span><span style="color:var(--shiki-token-keyword)">}</span><span style="color:var(--shiki-token-string-expression)">`</span><span style="color:var(--shiki-foreground)">;</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.