<h4 id="route-groups" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Route Groups</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#route-groups" aria-label="Link to Route Groups"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h4>
