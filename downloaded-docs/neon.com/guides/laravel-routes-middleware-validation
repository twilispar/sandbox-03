<span class="line" data-line="9"><span style="color:var(--shiki-foreground)">        ];</span></span>
<span class="line" data-line="10"><span style="color:var(--shiki-foreground)">    }</span><span style="color:var(--shiki-token-punctuation)">)</span><span style="color:var(--shiki-foreground)">;</span></span>
