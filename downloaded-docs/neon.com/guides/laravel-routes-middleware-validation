<span class="line" data-line="2"></span>
<span class="line" data-line="3"><span style="color:var(--shiki-foreground)">$request</span><span style="color:var(--shiki-token-keyword)">-&gt;</span><span style="color:var(--shiki-token-function)">validate</span><span style="color:var(--shiki-token-punctuation)">(</span><span style="color:var(--shiki-foreground)">[</span></span>
