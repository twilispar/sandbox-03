}],\" if you don't have one.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"OpenCode CLI:\"}],\" OpenCode CLI installed and configured. You can find installation instructions in the \",[\"$\",\"$L66\",null,{\"href\":\"https://opencode.ai/docs#install\",\"children\":\"OpenCode documentation\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Application repository on GitHub:\"}],\" A GitHub repository containing an application that uses your Neon project as its database. In this example, you'll use a simple snippet management tool called SnippetHub built with Next.js and Drizzle ORM. You can follow along with any of your own Neon-backed projects - the focus is on the workflow rather than the specific application.\"]}],\"\\n\"]}],\"\\n\",\"$L67\",\"\\n\",\"$L68\",\"\\n\",\"$L69\",\"\\n\",\"$L6a\",\"\\n\",\"$L6b\",\"\\n\",\"$L6c\",\"\\n\",\"$L6d\",\"\\n\",\"$L6e\",\"\\n\",\"$L6f\",\"\\n\",\"$L70\",\"\\n\",\"$L71\",\"\\n\",\"$L72\",\"\\n\",\"$L73\"]\n"])</script><script>self.__next_f.push([1,"74:I[857545,[\"/_next/static/chunks/0-0o8zjuqab7b.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0-wyrs755k4-p.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0i.l9589uvx0j.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/091ffmj5eeg4m.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/13twdpqxz8tr6.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/05jguszscqe2t.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0712bbhfq86sz.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/15lxb7jjl82fj.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0h.udm.w.7o.o.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/17kcjke_wkc_-.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/0-60ftfyrdwhq.js?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7\",\"/_next/static/chunks/15eaiz8asb