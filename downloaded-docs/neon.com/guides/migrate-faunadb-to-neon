="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
