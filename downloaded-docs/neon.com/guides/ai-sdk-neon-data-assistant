<span class="line" data-line="37"><span style="color:var(--shiki-token-keyword)">    request_url</span><span style="color:var(--shiki-token-keyword)">:</span><span style="color:var(--shiki-token-string-expression)"> https://&lt;your-ngrok-id&gt;.ngrok.app/api/webhooks/slack</span></span>
<span class="line" data-line="38"><span style="color:var(--shiki-token-keyword)">  org_deploy_enabled</span><span style="color:var(--shiki-token-keyword)">:</span><span style="color:var(--shiki-token-constant)"> false</span></span>
