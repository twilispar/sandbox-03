<span class="line" data-line="15"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">groups:history</span></span>
<span class="line" data-line="16"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">groups:read</span></span>
