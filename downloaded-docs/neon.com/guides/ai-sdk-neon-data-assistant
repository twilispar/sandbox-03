<span class="line" data-line="18"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">im:read</span></span>
<span class="line" data-line="19"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">mpim:history</span></span>
<span class="line" data-line="20"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">mpim:read</span></span>
<span class="line" data-line="21"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">reactions:read</span></span>
<span class="line" data-line="22"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">reactions:write</span></span>
<span class="line" data-line="23"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">users:read</span></span>
<span class="line" data-line="24"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">files:write</span></span>
<span class="line" data-line="25"><span style="color:var(--shiki-token-keyword)">  pkce_enabled</span><span style="color:var(--shiki-token-keyword)">:</span><span style="color:var(--shiki-token-constant)"> false</span></span>
<span class="line" data-line="26"><span style="color:var(--shiki-token-keyword)">settings</span><span style="color:var(--shiki-token-keyword)">:</span></span>
<span class="line" data-line="27"><span style="color:var(--shiki-token-keyword)">  event_subscriptions</span><span style="color:var(--shiki-token-keyword)">:</span></span>
<span class="line" data-line="28"><span style="color:var(--shiki-token-keyword)">    request_url</span><span style="color:var(--shiki-token-keyword)">:</span><span style="color:var(--shiki-token-string-expression)"> https://&lt;your-ngrok-id&gt;.ngrok.app/api/webhooks/slack</span></span>
<span class="line" data-line="29"><span style="color:var(--shiki-token-keyword)">    bot_events</span><span style="color:var(--shiki-token-keyword)">:</span></span>
<span class="line" data-line="30"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">app_mention</span></span>
<span class="line" data-line="31"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">message.channels</span></span>
<span class="line" data-line="32"><span style="color:var(--shiki-foreground)">      - </span><span style="color:var(--shiki-token-string-expression)">message.groups</span></span>
