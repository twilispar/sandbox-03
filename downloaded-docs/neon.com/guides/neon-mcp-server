<span aria-owns="rmiz-modal-" data-rmiz=""><span data-rmiz-content="not-found" style="visibility:visible"><img alt="Neon OAuth window" loading="lazy" width="704" height="447" decoding="async" data-nimg="1" class="" style="color:transparent;width:100%;height:100%" src="/docs/guides/neon-oauth-window.png?dpl=dpl_3oQTwA9tDsjxX7vtodZE2SLAZ1X7"/></span></span></li>
