<span class="line" data-line="3"><span style="color:var(--shiki-token-string)">  -H</span><span style="color:var(--shiki-token-string-expression)"> &quot;Authorization: Bearer $NEON_API_KEY&quot;</span><span style="color:var(--shiki-foreground)"> \</span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-token-string)">  -H</span><span style="color:var(--shiki-token-string-expression)"> &#x27;Content-Type: application/json&#x27;</span><span style="color:var(--shiki-foreground)"> \</span></span>
<span class="line" data-line="5"><span style="color:var(--shiki-token-string)">  -d</span><span style="color:var(--shiki-token-string-expression)"> &#x27;{</span></span>
