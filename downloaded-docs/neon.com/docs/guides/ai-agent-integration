iv></aside><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"AI Agent integration guide","author":{"@type":"Organization","name":"Neon"}}</script><div class="mx-auto min-w-0 pb-32 lg:pb-24 md:pb-20 max-w-208 lg:max-w-none"><div class="mb-7 flex flex-wrap items-center gap-x-1.5 text-[15px] leading-none tracking-extra-tight text-gray-new-40 dark:text-gray-new-60 mb-7!"><a class="transition-colors duration-200 hover:text-black dark:hover:text-white rounded-sm" href="/docs"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M14 7.6 8 2 2 7.6M3.6 8.4V14h3.2v-3.2h2.4V14h3.2V8.4"></path></svg></a><span>/</span><span class="text-gray-new-10 dark:text-gray-new-94">AI Agent integration</span></div><article><div class="flex items-start justify-between gap-6 sm:flex-col sm:items-stretch sm:gap-4"><div class="max-w-xl 2xl:max-w-[520px]"><h1 class="text-[36px] leading-tight font-medium tracking-tighter text-balance md:text-[28px]">AI Agent integration guide</h1><p class="mt-[1.125rem] text-xl leading-tight tracking-extra-tight text-gray-new-40 dark:text-gray-new-70 md:mt-1.5 md:text-lg">Implement database provisioning and versioning for your AI agent platform</p></div><div class="relative mt-2.5 w-fit sm:mt-0"><div class="flex items-center border border-gray-new-90 dark:border-gray-new-20"><button class="flex h-8 w-fit shrink-0 items-center gap-2 border-r border-gray-new-90 px-2.5 whitespace-nowrap text-black-new hover:bg-gray-new-98 dark:border-gray-new-20 dark:text-gray-new-94 dark:hover:bg-gray-new-8"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="size-4 shrink-0"><g clip-path="url(#copy-docs_inline_svg__a)"><mask id="copy-docs_inline_svg__b" width="16" height="16" x="0" y="0" maskUnits="userSpaceOnUse" style="mask-type:luminance"><path fill="#fff" d="M0 0