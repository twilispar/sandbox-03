-px before:bg-green-44 before:opacity-0 before:transition-opacity before:duration-200 dark:before:bg-green-52" target="_self" tabindex="-1" href="/docs/guides/trigger-serverless-functions"><span class="text-pretty" aria-hidden="false">Trigger serverless functions with Inngest<!-- --> </span></a></li></ul></div></li></ul></div></nav></div></div></aside><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Replicate data to Databricks with Lakeflow Connect","author":{"@type":"Organization","name":"Neon"}}</script><div class="mx-auto min-w-0 pb-32 lg:pb-24 md:pb-20 max-w-208 lg:max-w-none"><div class="mb-7 flex flex-wrap items-center gap-x-1.5 text-[15px] leading-none tracking-extra-tight text-gray-new-40 dark:text-gray-new-60 mb-7!"><a class="transition-colors duration-200 hover:text-black dark:hover:text-white rounded-sm" href="/docs"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M14 7.6 8 2 2 7.6M3.6 8.4V14h3.2v-3.2h2.4V14h3.2V8.4"></path></svg></a><span>/</span><a class="transition-colors duration-200 hover:text-black dark:hover:text-white rounded-sm" href="/docs/guides/integrations">Integrations (3rd party)</a><span>/</span><span class="text-gray-new-40 dark:text-gray-new-60">Replicate from Neon</span><span>/</span><span class="text-gray-new-10 dark:text-gray-new-94">Databricks</span></div><article><div class="flex items-start justify-between gap-6 sm:flex-col sm:items-stretch sm:gap-4"><div class="max-w-xl 2xl:max-w-[520px]"><h1 class="text-[36px] leading-tight font-medium tracking-tighter text-balance md:text-[28px]">Replicate data to Databricks with Lakeflow Connect</h1><p class="mt-[1.125rem] text-xl leading-tight tracking-extra-tight text-gray-new-40 dark:text-gray-new-70 md:mt-1.5 md:text-lg">Learn how to replicate data from Neon to Databricks Lakehouse using the Lakeflow Connect PostgreSQL connector</p></div><div class="relative mt-2.5 w-fit sm:mt-0"><div class="flex items-center border border-gray-new-90 dark:border-gray-new-20"><button class="flex h-8 w-fit shrink-0 items-center gap-2 border-r border-gray-new-90 px-2.5 whitespace-nowrap text-black-new hover:bg-gray-new-98 dark:border-gray-new-20 dark:text-gray-new-94 dark:hover:bg-gray-new-8"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="size-4 shrink-0"><g clip-path="url(#copy-docs_inline_svg__a)"><mask id="copy-docs_inline_svg__b" width="16" height="16" x="0" y="0" maskUnits="userSpaceOnUse" style="mask-type:luminance"><path fill="#fff" d="M0 0h16v16H0z"></path></mask><g stroke="currentColor" mask="url(#copy-docs_inline_svg__b)"><path d="M5.947 14.63h8.683V5.945H5.947z"></path><path d="M3.579 10.684H2V2h8.683v1.579"></path></g></g><defs><clipPath id="copy-docs_inline_svg__a"><path fill="#fff" d="M0 0h16v16H0z"></path></clipPath></defs></svg><span class="text-sm leading-none tracking-extra-tight whitespace-nowrap">Copy page</span></button><button class="flex h-8 items-center px-1 hover:bg-gray-new-98 dark:hover:bg-gray-new-8"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" fill="none" viewBox="0 0 14 15" class="size-3.5 text-gray-new-50 transition-transform duration-200 dark:text-gray-new-50"><path stroke="currentColor" stroke-width="1.5" d="M3.5 5.75 7 9.25l3.5-3.5"></path></svg></button></div></div></div><div class="prose-doc post-content prose dark:prose-invert xs:prose-code:break-words mt-10 lg:mt-7 md:mt-5"><p>Neon&#x27;s logical replication feature lets you stream changes from your Neon Postgres database into external systems. This guide shows how to use Databricks Lakeflow Connect&#x27;s PostgreSQL connector to replicate data from Neon Postgres into Databricks Lakehouse using PostgreSQL logical replication.</p>
<p>The PostgreSQL connector for Lakeflow Connect is a managed ingestion connector that:</p>
<ul>
<li>Connects to PostgreSQL over TLS using a Unity Catalog connection</li>
<li>Uses logical replication with the <code>pgoutput</code> plugin for change data capture (CDC)</li>
<li>Requires PostgreSQL 13+ on the primary instance (not a read replica)</li>
<li>Extracts snapshot and change data through an ingestion gateway and loads it into Delta tables via an ingestion pipeline</li>
</ul>
<div class="admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#EC6F09] dark:border-[#F99D51] [&amp;_pre]:px-4 [&amp;_pre]:py-3 [&amp;_pre_code]:text-sm! [&amp;_pre[data-language]]:bg-white! [&amp;_pre[data-language]]:dark:bg-gray-new-8!"><div class="flex items-center gap-1 text-[#EC6F09] dark:text-[#F99D51]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="shrink-0"><path stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" stroke-width="1.333" d="M8.003 2C4.32 2 1.336 4.686 1.336 8c0 1.229.412 2.37 1.117 3.322l-.816 3.044 3.524-.945A7.2 7.2 0 0 0 8.003 14c3.682 0 6.666-2.686 6.666-6s-2.984-6-6.666-6ZM8 8.332v-3"></path><path fill="currentColor" d="M8.005 11.667a.833.833 0 1 0 0-1.667.833.833 0 0 0 0 1.667"></path></svg><h4 class="font-mono text-[13px] leading-none font-medium -tracking-snug uppercase">Public Preview</h4></div><div class="admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [&amp;_a]:rounded-sm [&amp;_li]:text-base [&amp;_li]:leading-snug [&amp;_li]:tracking-extra-tight [&amp;_ul]:my-0 [&amp;_ol]:my-0"><p>The PostgreSQL connector for Lakeflow Connect is currently in Public Preview. You must work with your Databricks account team to have it enabled for your workspace.</p></div></div>
<h2 id="prerequisites" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter"><span>Prerequisites</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#prerequisites" aria-label="Link to Prerequisites"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3.5"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h2>
<p>You need:</p>
<ul>
<li>
<p><strong>A Neon project</strong> with a Postgres database containing the data you want to replicate. For test data, you can run the following in the <a class="" href="/docs/get-started/query-with-neon-sql-editor">Neon SQL Editor</a> or an SQL client such as <a class="" href="/docs/connect/query-with-psql-editor">psql</a>:</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">CREATE</span><span style="color:var(--shiki-token-keyword)"> TABLE</span><span style="color:var(--shiki-token-function)"> IF</span><span style="color:var(--shiki-token-keyword)"> NOT</span><span style="color:var(--shiki-token-keyword)"> EXISTS</span><span style="color:var(--shiki-foreground)"> playing_with_neon (</span></span>
<span class="line" data-line="2"><span style="color:var(--shiki-foreground)">  id    </span><span style="color:var(--shiki-token-keyword)">SERIAL</span><span style="color:var(--shiki-token-keyword)"> PRIMARY KEY</span><span style="color:var(--shiki-foreground)">,</span></span>
<span class="line" data-line="3"><span style="color:var(--shiki-token-keyword)">  name</span><span style="color:var(--shiki-token-keyword)">  TEXT</span><span style="color:var(--shiki-token-keyword)"> NOT NULL</span><span style="color:var(--shiki-foreground)">,</span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-token-keyword)">  value</span><span style="color:var(--shiki-token-keyword)"> REAL</span></span>
<span class="line" data-line="5"><span style="color:var(--shiki-foreground)">);</span></span>
<span class="line" data-line="6"></span>
<span class="line" data-line="7"><span style="color:var(--shiki-token-keyword)">INSERT INTO</span><span style="color:var(--shiki-foreground)"> playing_with_neon (</span><span style="color:var(--shiki-token-keyword)">name</span><span style="color:var(--shiki-foreground)">, </span><span style="color:var(--shiki-token-keyword)">value</span><span style="color:var(--shiki-foreground)">)</span></span>
<span class="line" data-line="8"><span style="color:var(--shiki-token-keyword)">SELECT</span><span style="color:var(--shiki-token-function)"> LEFT</span><span style="color:var(--shiki-foreground)">(md5(i::</span><span style="color:var(--shiki-token-keyword)">TEXT</span><span style="color:var(--shiki-foreground)">), </span><span style="color:var(--shiki-token-constant)">10</span><span style="color:var(--shiki-foreground)">), random()</span></span>
<span class="line" data-line="9"><span style="color:var(--shiki-token-keyword)">FROM</span><span style="color:var(--shiki-token-function)"> generate_series</span><span style="color:var(--shiki-foreground)">(</span><span style="color:var(--shiki-token-constant)">1</span><span style="color:var(--shiki-foreground)">, </span><span style="color:var(--shiki-token-constant)">10</span><span style="color:var(--shiki-foreground)">) s(i);</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-4" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
</li>
<li>
<p><strong>A Databricks workspace</strong> with Unity Catalog enabled, serverless compute available for Lakeflow Spark Declarative Pipelines, and the Lakeflow Connect PostgreSQL connector enabled (Public Preview)</p>
</li>
<li>
<p><strong>Permissions in Databricks</strong>: <code>CREATE CONNECTION</code> on the metastore (if you will create a new Unity Catalog connection); <code>USE CATALOG</code> on target and staging catalogs; <code>USE SCHEMA</code>, <code>CREATE TABLE</code>, and <code>CREATE VOLUME</code> on target schemas, or <code>CREATE SCHEMA</code> on the catalogs</p>
</li>
<li>
<p><strong>Network connectivity</strong>: Neon must accept inbound connections from your Databricks workspace (or via VPN/PrivateLink, depending on setup). If you use <a class="" href="/docs/manage/projects#configure-ip-allow">IP Allow</a> in Neon, add the Databricks egress addresses to your allowlist. See <a class="" href="/docs/guides/logical-replication-neon#subscriber-access">Subscriber access</a></p>
</li>
<li>
<p><strong>PostgreSQL</strong>: Neon Postgres running v13 or later with logical replication enabled on the primary. The connector does not support logical replication from a read replica</p>
</li>
</ul>
<p>Read the <a class="" href="/docs/guides/logical-replication-neon#important-notices">important notices about logical replication in Neon</a> before you begin.</p>
<h2 id="step-1-prepare-your-neon-postgres-database" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter"><span>Step 1: Prepare your Neon Postgres database</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#step-1-prepare-your-neon-postgres-database" aria-label="Link to Step 1: Prepare your Neon Postgres database"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3.5"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h2>
<p>Configure Neon as a logical replication publisher that Lakeflow Connect can subscribe to.</p>
<h3 id="enable-logical-replication-in-neon" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Enable logical replication in Neon</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#enable-logical-replication-in-neon" aria-label="Link to Enable logical replication in Neon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<div class="admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#EC6F09] dark:border-[#F99D51] [&amp;_pre]:px-4 [&amp;_pre]:py-3 [&amp;_pre_code]:text-sm! [&amp;_pre[data-language]]:bg-white! [&amp;_pre[data-language]]:dark:bg-gray-new-8!"><div class="flex items-center gap-1 text-[#EC6F09] dark:text-[#F99D51]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="shrink-0"><path stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" stroke-width="1.333" d="M8.003 2C4.32 2 1.336 4.686 1.336 8c0 1.229.412 2.37 1.117 3.322l-.816 3.044 3.524-.945A7.2 7.2 0 0 0 8.003 14c3.682 0 6.666-2.686 6.666-6s-2.984-6-6.666-6ZM8 8.332v-3"></path><path fill="currentColor" d="M8.005 11.667a.833.833 0 1 0 0-1.667.833.833 0 0 0 0 1.667"></path></svg><h4 class="font-mono text-[13px] leading-none font-medium -tracking-snug uppercase">important</h4></div><div class="admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [&amp;_a]:rounded-sm [&amp;_li]:text-base [&amp;_li]:leading-snug [&amp;_li]:tracking-extra-tight [&amp;_ul]:my-0 [&amp;_ol]:my-0"><p>Enabling logical replication sets <code>wal_level</code> from <code>replica</code> to <code>logical</code> for the entire project and restarts all computes in the project, briefly disconnecting clients. Once set to <code>logical</code>, it cannot be reverted.</p></div></div>
<ol>
<li>In the Neon Console, open your project.</li>
<li>Go to <strong>Settings</strong> → <strong>Logical Replication</strong>.</li>
<li>Click <strong>Enable</strong>.</li>
</ol>
<p>Verify:</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-foreground)">SHOW wal_level;</span></span>
<span class="line" data-line="2"><span style="color:var(--shiki-token-comment)">-- should return: logical</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-4" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
<h3 id="create-a-dedicated-replication-role" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Create a dedicated replication role</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#create-a-dedicated-replication-role" aria-label="Link to Create a dedicated replication role"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<p>Databricks recommends a dedicated database user for ingestion. Create a role in Neon (roles created via the Neon Console, CLI, or API are granted the <a class="" href="/docs/manage/roles#the-neonsuperuser-role">neon_superuser</a> role, which has the required <code>REPLICATION</code> privilege). You can name it <code>databricks_replication</code> or reuse an existing replication role.</p>
<figure class="my-5 max-w-full overflow-hidden border border-gray-new-80 dark:border-gray-new-20 [&amp;_.code-block]:my-0 [&amp;_.code-block]:!border-none"><div class="relative no-scrollbars flex min-h-11 w-full flex-nowrap gap-5 overflow-auto bg-gray-new-98 pl-5 after:absolute after:right-0 after:bottom-0 after:left-0 after:h-px after:bg-gray-new-80 dark:bg-gray-new-8 dark:after:bg-gray-new-20"><button class="relative z-10 cursor-pointer border-b pt-2.5 pb-3.5 text-sm leading-none font-medium tracking-extra-tight whitespace-nowrap transition-colors duration-200 hover:text-black-pure dark:hover:text-white border-black-pure text-black-pure after:opacity-100 dark:border-white dark:text-white" type="button">Console</button><button class="relative z-10 cursor-pointer border-b pt-2.5 pb-3.5 text-sm leading-none font-medium tracking-extra-tight whitespace-nowrap transition-colors duration-200 hover:text-black-pure dark:hover:text-white border-transparent text-gray-new-40 dark:text-gray-new-60" type="button">CLI</button><button class="relative z-10 cursor-pointer border-b pt-2.5 pb-3.5 text-sm leading-none font-medium tracking-extra-tight whitespace-nowrap transition-colors duration-200 hover:text-black-pure dark:hover:text-white border-transparent text-gray-new-40 dark:text-gray-new-60" type="button">API</button></div><div class="tab-item px-4 py-5 [&amp;_.admonition]:bg-gray-new-98 [&amp;_.admonition]:dark:bg-gray-new-8 [&amp;_ol]:pl-6 [&amp;_p]:text-base [&amp;_p]:leading-normal [&amp;_p]:tracking-extra-tight [&amp;_ul]:pl-7 [&amp;_li]:text-base [&amp;_li]:leading-snug [&amp;_li]:tracking-extra-tight [&amp;_pre[data-language]]:bg-gray-new-98! [&amp;_pre[data-language]]:dark:bg-gray-new-8!"><ol>
<li>In the <a class="group inline" href="https://console.neon.tech" target="_blank" rel="noopener noreferrer">Neon Console<span class="whitespace-nowrap no-underline"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="ml-1 inline-block size-3.5! shrink-0 align-[-0.125em]"><path fill="currentColor" d="M0 0h14v14H0z" opacity="0.2"></path><path stroke="currentColor" stroke-linecap="square" d="M9.915 8.885V4.08H5.11M9.625 4.375 4.083 9.917"></path></svg></span></a>, select your project and <strong>Branches</strong>.</li>
<li>Select the branch, then the <strong>Roles &amp; Databases</strong> tab.</li>
<li>Click <strong>Add Role</strong>, enter the role name (e.g. <code>databricks_replication</code>), and click <strong>Create</strong>. Save the password.</li>
</ol></div></figure>
<p>Then grant the role access to the database and tables. Run the following as a user with sufficient privileges (e.g. your primary role):</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">GRANT</span><span style="color:var(--shiki-token-keyword)"> CONNECT</span><span style="color:var(--shiki-token-keyword)"> ON</span><span style="color:var(--shiki-token-keyword)"> DATABASE</span><span style="color:var(--shiki-foreground)"> your_database </span><span style="color:var(--shiki-token-keyword)">TO</span><span style="color:var(--shiki-foreground)"> databricks_replication;</span></span>
<span class="line" data-line="2"><span style="color:var(--shiki-token-keyword)">GRANT</span><span style="color:var(--shiki-foreground)"> USAGE </span><span style="color:var(--shiki-token-keyword)">ON</span><span style="color:var(--shiki-token-keyword)"> SCHEMA</span><span style="color:var(--shiki-foreground)"> public </span><span style="color:var(--shiki-token-keyword)">TO</span><span style="color:var(--shiki-foreground)"> databricks_replication;</span></span>
<span class="line" data-line="3"><span style="color:var(--shiki-token-keyword)">GRANT</span><span style="color:var(--shiki-token-keyword)"> SELECT</span><span style="color:var(--shiki-token-keyword)"> ON</span><span style="color:var(--shiki-foreground)"> ALL TABLES </span><span style="color:var(--shiki-token-keyword)">IN</span><span style="color:var(--shiki-token-keyword)"> SCHEMA</span><span style="color:var(--shiki-foreground)"> public </span><span style="color:var(--shiki-token-keyword)">TO</span><span style="color:var(--shiki-foreground)"> databricks_replication;</span></span>
<span class="line" data-line="4"><span style="color:var(--shiki-token-keyword)">ALTER</span><span style="color:var(--shiki-token-keyword)"> DEFAULT</span><span style="color:var(--shiki-foreground)"> PRIVILEGES </span><span style="color:var(--shiki-token-keyword)">IN</span><span style="color:var(--shiki-token-keyword)"> SCHEMA</span><span style="color:var(--shiki-foreground)"> public</span></span>
<span class="line" data-line="5"><span style="color:var(--shiki-token-keyword)">GRANT</span><span style="color:var(--shiki-token-keyword)"> SELECT</span><span style="color:var(--shiki-token-keyword)"> ON</span><span style="color:var(--shiki-foreground)"> TABLES </span><span style="color:var(--shiki-token-keyword)">TO</span><span style="color:var(--shiki-foreground)"> databricks_replication;</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-4" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
<p>Granting <code>SELECT ON ALL TABLES IN SCHEMA</code> and <code>ALTER DEFAULT PRIVILEGES</code> ensures future tables in the schema are included without re-granting.</p>
<h3 id="configure-replica-identity-for-tables" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Configure replica identity for tables</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#configure-replica-identity-for-tables" aria-label="Link to Configure replica identity for tables"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<p>Logical replication needs enough row identity to apply updates and deletes. For tables with a primary key and no large TOAST columns, use the default:</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">ALTER</span><span style="color:var(--shiki-token-keyword)"> TABLE</span><span style="color:var(--shiki-foreground)"> public.playing_with_neon </span><span style="color:var(--shiki-token-keyword)">REPLICA</span><span style="color:var(--shiki-token-keyword)"> IDENTITY</span><span style="color:var(--shiki-token-keyword)"> DEFAULT</span><span style="color:var(--shiki-foreground)">;</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-[min(1rem,calc(50%-.8175rem))]" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
<p>For tables without a primary key or with very large variable-length columns (e.g. large TEXT, BYTEA), use <code>FULL</code>:</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">ALTER</span><span style="color:var(--shiki-token-keyword)"> TABLE</span><span style="color:var(--shiki-foreground)"> public.some_large_table </span><span style="color:var(--shiki-token-keyword)">REPLICA</span><span style="color:var(--shiki-token-keyword)"> IDENTITY</span><span style="color:var(--shiki-foreground)"> FULL;</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-[min(1rem,calc(50%-.8175rem))]" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
<p>Repeat for each table you plan to replicate.</p>
<h3 id="create-a-publication" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Create a publication</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#create-a-publication" aria-label="Link to Create a publication"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<p>Create a logical replication publication that includes all tables you want to ingest. One publication per database.</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-comment)">-- Option 1: Explicit list</span></span>
<span class="line" data-line="2"><span style="color:var(--shiki-token-keyword)">CREATE</span><span style="color:var(--shiki-foreground)"> PUBLICATION databricks_publication</span></span>
<span class="line" data-line="3"><span style="color:var(--shiki-token-keyword)">  FOR</span><span style="color:var(--shiki-token-keyword)"> TABLE</span><span style="color:var(--shiki-foreground)"> public.playing_with_neon;</span></span>
<span class="line" data-line="4"></span>
<span class="line" data-line="5"><span style="color:var(--shiki-token-comment)">-- Option 2: All tables in the database</span></span>
<span class="line" data-line="6"><span style="color:var(--shiki-token-comment)">-- CREATE PUBLICATION databricks_publication FOR ALL TABLES;</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-4" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
<p>You can later use <code>ALTER PUBLICATION</code> to add or remove tables. Only tables in this publication will be replicated.</p>
<h3 id="create-a-logical-replication-slot" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Create a logical replication slot</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#create-a-logical-replication-slot" aria-label="Link to Create a logical replication slot"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<p>Lakeflow Connect uses logical replication slots with the <code>pgoutput</code> plugin. From your Neon database, connected as your replication role:</p>
<figure class="code-block group/code-block relative flex flex-col [&amp;_pre]:min-w-full rounded-none border border-gray-new-80 dark:border-gray-new-20 [&amp;&gt;pre]:my-0 [&amp;&gt;pre]:rounded-none [&amp;&gt;pre]:bg-white! [&amp;&gt;pre]:py-4 [&amp;&gt;pre]:dark:bg-black-pure!" data-has-filename="false" data-line-numbers="false"><pre class="shiki css-variables" style="background-color:var(--shiki-background);color:var(--shiki-foreground)" tabindex="0" data-language="sql"><code class="grid"><span class="line" data-line="1"><span style="color:var(--shiki-token-keyword)">SELECT</span><span style="color:var(--shiki-foreground)"> pg_create_logical_replication_slot(</span><span style="color:var(--shiki-token-string-expression)">&#x27;databricks_slot&#x27;</span><span style="color:var(--shiki-foreground)">, </span><span style="color:var(--shiki-token-string-expression)">&#x27;pgoutput&#x27;</span><span style="color:var(--shiki-foreground)">);</span></span></code></pre><button class="invisible absolute right-4 border border-gray-new-80 bg-white p-1.5 text-gray-new-40 opacity-0 transition-[background-color,opacity,visibility] duration-200 group-hover/code-block:visible group-hover/code-block:opacity-100 hover:bg-gray-new-90 dark:border-gray-new-20 dark:bg-black-pure dark:text-gray-new-60 dark:hover:bg-gray-new-8 lg:visible lg:opacity-100 top-[min(1rem,calc(50%-.8175rem))]" type="button" aria-label="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="h-3.5 w-3.5 text-current"><rect width="8.995" height="9.002" x="5.939" y="5.935" stroke="currentColor" rx="1"></rect><path fill="currentColor" fill-rule="evenodd" d="M2.434.935a1.5 1.5 0 0 0-1.5 1.5v7.001a1.5 1.5 0 0 0 1.5 1.5h1.499a.5.5 0 0 0 0-1h-1.5a.5.5 0 0 1-.5-.5V2.435a.5.5 0 0 1 .5-.5h6.995a.5.5 0 0 1 .5.5v1.5a.5.5 0 1 0 1 0v-1.5a1.5 1.5 0 0 0-1.5-1.5z" clip-rule="evenodd"></path></svg></button></figure>
<p>You will use the slot name <code>databricks_slot</code> and publication name <code>databricks_publication</code> when configuring the Lakeflow gateway.</p>
<div class="admonition not-prose my-9 rounded-none border-l-2 bg-gray-new-98 py-4 pr-5 pl-[1.125rem] dark:bg-gray-new-8 border-[#BE8A3C] dark:border-[#FFED9C] [&amp;_pre]:px-4 [&amp;_pre]:py-3 [&amp;_pre_code]:text-sm! [&amp;_pre[data-language]]:bg-white! [&amp;_pre[data-language]]:dark:bg-gray-new-8!"><div class="flex items-center gap-1 text-[#BE8A3C] dark:text-[#FFED9C]"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 16 16" class="shrink-0"><path stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" d="M8 11.5a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"></path><path stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" d="M5 6.5a3 3 0 0 1 3-3"></path><path stroke="currentColor" stroke-miterlimit="10" d="m5.781 11 .282 3H10l.281-3"></path><path stroke="currentColor" stroke-linecap="square" stroke-miterlimit="10" d="M7 15h2"></path></svg><h4 class="font-mono text-[13px] leading-none font-medium -tracking-snug uppercase">Replication slots and WAL</h4></div><div class="admonition-text mt-2.5 text-base leading-normal tracking-extra-tight text-gray-new-20 dark:text-gray-new-85 [&amp;_a]:rounded-sm [&amp;_li]:text-base [&amp;_li]:leading-snug [&amp;_li]:tracking-extra-tight [&amp;_ul]:my-0 [&amp;_ol]:my-0"><p>Logical replication slots retain WAL until a subscriber consumes it. If the Lakeflow ingestion gateway is stopped for too long, WAL can accumulate. Keep the gateway running continuously and monitor replication lag. Neon also <a class="" href="/docs/guides/logical-replication-neon#unused-replication-slots">removes inactive replication slots</a> after approximately 40 hours if progress is not acknowledged.</p></div></div>
<p>At this point Neon is ready: <code>wal_level = logical</code>, a dedicated replication user with the required privileges, replica identities set on tables, <code>databricks_publication</code> defined, and <code>databricks_slot</code> created with <code>pgoutput</code>.</p>
<h2 id="step-2-create-a-unity-catalog-connection-to-neon" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-tighter"><span>Step 2: Create a Unity Catalog connection to Neon</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#step-2-create-a-unity-catalog-connection-to-neon" aria-label="Link to Step 2: Create a Unity Catalog connection to Neon"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3.5"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h2>
<p>Lakeflow Connect uses Unity Catalog connections to store JDBC connection details and credentials for PostgreSQL. Create the connection in the Databricks UI or via the CLI.</p>
<h3 id="using-the-databricks-ui-recommended" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Using the Databricks UI (recommended)</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#using-the-databricks-ui-recommended" aria-label="Link to Using the Databricks UI (recommended)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
<ol>
<li>In your Databricks workspace, open <strong>Catalog</strong> (Catalog Explorer).</li>
<li>Click the plus icon (+) and select <strong>Create a connection</strong>.</li>
<li>Enter a <strong>Connection name</strong>.
Choose <strong>PostgreSQL</strong> as the connection type.</li>
<li>For Auth type, select <code>Username and password</code>.</li>
<li>Enter your Neon connection details (from the <strong>Connect</strong> button on your Neon project dashboard):<!-- -->
<ul>
<li><strong>Host</strong>: your Neon host (e.g. <code>ep-cool-darkness-123456.us-east-2.aws.neon.tech</code>)</li>
<li><strong>Port</strong>: 5432</li>
<li><strong>Database</strong>: your Neon database name</li>
<li><strong>User</strong>: <code>databricks_replication</code> (or the replication role you created).</li>
<li><strong>Password</strong>: the password for that role. You can obtain the password from the <strong>Connect</strong> modal on the Neon project dashboard.</li>
</ul>
</li>
<li>Create the connection.</li>
<li>On the <strong>Catalog basics</strong> page, test your connection. You will need to provide the name of your PostgreSQL database.</li>
<li>Click next to grant catalog access. Specify the users, groups, and service principals that have privileges on this catalog. Additionally, set up workspace-catalog bindings to isolate user data access.</li>
</ol>
<h3 id="using-the-databricks-cli-alternative" class="anchor-heading group relative w-fit scroll-mt-20 leading-tight font-medium lg:scroll-mt-5 tracking-extra-tight"><span>Using the Databricks CLI (alternative)</span><a class="rounded-full px-2 no-underline opacity-0 transition-opacity duration-200 group-hover:opacity-100 hover:border-none hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-offset-0 sm:hidden" href="#using-the-databricks-cli-alternative" aria-label="Link to Using the Databricks CLI (alternative)"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="inline text-green-44 dark:text-green-52 w-3"><path stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="1.4" d="m3.938 12.688 1.75-11.375M8.313 12.688l1.75-11.375M3.063 4.813h8.75M2.188 9.188h8.75"></path></svg></a></h3>
