<span class="line" data-line="4"><span style="color:var(--shiki-foreground)">    file_url </span><span style="color:var(--shiki-token-keyword)">TEXT</span><span style="color:var(--shiki-token-keyword)"> NOT NULL</span><span style="color:var(--shiki-foreground)">,          </span><span style="color:var(--shiki-token-comment)">-- Publicly accessible URL (if object is public)</span></span>
<span class="line" data-line="5"><span style="color:var(--shiki-foreground)">    user_id </span><span style="color:var(--shiki-token-keyword)">TEXT</span><span style="color:var(--shiki-token-keyword)"> NOT NULL</span><span style="color:var(--shiki-foreground)">,           </span><span style="color:var(--shiki-token-comment)">-- User associated with the file</span></span>
