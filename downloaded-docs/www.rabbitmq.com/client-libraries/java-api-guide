-name">ConnectionFactory</span><span class="token punctuation" style=color:#393A34>(</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>;</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain">connectionFactory</span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>setMetricsCollector</span><span class="token punctuation" style=color:#393A34>(</span><span class="token plain">metrics</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>;</span><br/></div></code></pre></div></div>
<h3 class="anchor anchorTargetStickyNavbar_Vzrq" id=metrics-dropwizard-metrics>Dropwizard Metrics support<a href=#metrics-dropwizard-metrics class=hash-link aria-label="Direct link to Dropwizard Metrics support" title="Direct link to Dropwizard Metrics support" translate=no>​</a></h3>
<p>Enable metrics collection with <a href=http://metrics.dropwizard.io target=_blank rel="noopener noreferrer" class="">Dropwizard</a> like so:</p>
<div class="language-java codeBlockContainer_Ckt0 theme-code-block" style=--prism-color:#393A34;--prism-background-color:#f6f8fa><div class=codeBlockContent_QJqH><pre tabindex=0 class="prism-code language-java codeBlock_bY9V thin-scrollbar" style=color:#393A34;background-color:#f6f8fa><code class=codeBlockLines_e6Vv><div class=token-line style=color:#393A34><span class="token class-name">ConnectionFactory</span><span class="token plain"> connectionFactory </span><span class="token operator" style=color:#393A34>=</span><span class="token plain"> </span><span class="token keyword" style=color:#00009f>new</span><span class="token plain"> </span><span class="token class-name">ConnectionFactory</span><span class="token punctuation" style=color:#393A34>(</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>;</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain"></span><span class="token class-name">StandardMetricsCollector</span><span class="token plain"> metrics </span><span class="token operator" style=color:#393A34>=</span><span class="token plain"> </span><span class="token keyword" style=color:#00009f>new</span><span class="token plain"> </span><span class="token class-name">StandardMetricsCollector</span><span class="token punctuation" style=color:#393A34>(</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>;</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain">connectionFactory</span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>setMetricsCollector</span><span class="token punctuation" style=color:#393A34>(</span><span class="token plain">metrics</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" styl