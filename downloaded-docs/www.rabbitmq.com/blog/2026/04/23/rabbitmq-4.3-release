ss="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>;</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain" style=display:inline-block></span><br/></div><div class=token-line style=color:#393A34><span class="token plain"></span><span class="token comment" style=color:#999988;font-style:italic>// 5. Upsert aggregated data to a database</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain"></span><span class="token class-name">StreamingQuery</span><span class="token plain"> query </span><span class="token operator" style=color:#393A34>=</span><span class="token plain"> deviceAgg</span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>writeStream</span><span class="token punctuation" style=color:#393A34>(</span><span class="token punctuation" style=color:#393A34>)</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    </span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>outputMode</span><span class="token punctuation" style=color:#393A34>(</span><span class="token string" style=color:#e3116c>"append"</span><span class="token punctuation" style=color:#393A34>)</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    </span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>trigger</span><span class="token punctuation" style=color:#393A34>(</span><span class="token class-name">Trigger</span><span class="token class-name punctuation" style=color:#393A34>.</span><span class="token class-name">ProcessingTime</span><span class="token punctuation" style=color:#393A34>(</span><span class="token string" style=color:#e3116c>"5 seconds"</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>)</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    </span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>foreachBatch</span><span class="token punctuation" style=color:#393A34>(</span><span class="token punctuation" style=color:#393A34>(</span><span class="token plain">batchDF</span><span class="token punctuation" style=color:#393A34>,</span><span class="token plain"> batchId</span><span class="token punctuation" style=color:#393A34>)</span><span class="token plain"> </span><span class="token operator" style=color:#393A34>-></span><span class="token plain"> </span><span class="token punctuation" style=color:#393A34>{</span><span class="token plain"></span><br/></div><div class=token-line style=color:#393A34><span class="token plain">        batchDF</span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>write</span><span class="token punctuation" style=color:#393A34>(</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>.</span><span class="token function" style=color:#d73a49>jdbc</span><span class="token punctuation" style=color:#393A34>(</span><span class="token string" style=color:#e3116c>"jdbc:postgresql://localhost:5432/iot"</span><span class="token punctuation" style=color:#393A34>,</span><span class="token plain"> </span><span class="token string" style=color:#e3116c>"device_stats"</span><span class="token punctuation" style=color:#393A34>,</span><span class="token plain"> connectionProperties</span><span class="token punctuation" style=color:#393A34>)</span><span class="token punctuation" style=color:#393A34>;</span><span class="token plain"></span>